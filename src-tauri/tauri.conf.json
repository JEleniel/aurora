{
  "productName": "AURORA",
  "version": "1.0.0",
  "identifier": "com.aurora.tooling",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "AURORA - Architecture Tooling",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null
    }
  }
}
