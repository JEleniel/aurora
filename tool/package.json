{
	"name": "aurora-desktop",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"lint": "eslint './src/**/*.{ts,tsx}' --max-warnings=0 || true",
		"format": "prettier --write './src/**/*.{ts,tsx,css,md}'",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"mermaid": "^10.0.0",
		"@tauri-apps/api": "^2.0.0"
	},
	"devDependencies": {
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"tailwindcss": "^3.4.0",
		"postcss": "^8.4.0",
		"autoprefixer": "^10.0.0",
		"monaco-editor": "^0.39.0",
		"@monaco-editor/react": "^5.0.0",
		"ajv": "^8.12.0",
		"ajv-formats": "^2.1.1",
		"eslint": "^8.0.0",
		"prettier": "^2.8.0",
		"eslint-config-prettier": "^8.0.0",
		"eslint-plugin-react": "^7.0.0"
	}
	,
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
