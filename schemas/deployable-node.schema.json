{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Deployable Node Card",
  "description": "A deployable node represents a physical or virtual deployment target, host, cluster, or environment where logical components are deployed and executed.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "deployable-node"
        },
        "attributes": {
          "type": "object",
          "description": "Deployable node-specific attributes",
          "properties": {
            "node_type": {
              "type": "string",
              "description": "Type of node (virtual machine, container, pod, cluster, edge device, etc.)"
            },
            "environment": {
              "type": "string",
              "description": "Deployment environment (development, staging, production, etc.)"
            },
            "region": {
              "type": "string",
              "description": "Geographic region or availability zone"
            },
            "platform": {
              "type": "string",
              "description": "Platform or infrastructure (Kubernetes, AWS EC2, Docker, Bare Metal, etc.)"
            },
            "os": {
              "type": "string",
              "description": "Operating system"
            },
            "components": {
              "type": "array",
              "description": "Logical components deployed on this node",
              "items": {
                "type": "string"
              }
            },
            "capacity": {
              "type": "object",
              "description": "Capacity specifications (CPU, memory, storage, network)"
            },
            "dependencies": {
              "type": "array",
              "description": "Dependencies on other nodes or infrastructure",
              "items": {
                "type": "string"
              }
            },
            "networking": {
              "type": "object",
              "description": "Network configuration (IP, DNS, firewall rules, etc.)"
            },
            "security_policies": {
              "type": "array",
              "description": "Security policies and compliance requirements",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
