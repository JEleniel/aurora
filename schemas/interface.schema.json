{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Interface Card",
  "description": "An interface represents a system boundary, API, protocol, or integration point. Interfaces expose capabilities to actors and external systems.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "interface"
        },
        "attributes": {
          "type": "object",
          "description": "Interface-specific attributes",
          "properties": {
            "protocol": {
              "type": "string",
              "description": "Protocol used (HTTP/REST, gRPC, WebSocket, Event, etc.)"
            },
            "schema": {
              "type": "object",
              "description": "Data schema or specification (OpenAPI, JSON Schema, etc.)"
            },
            "authentication": {
              "type": "string",
              "description": "Authentication mechanism (OAuth2, JWT, mTLS, etc.)"
            },
            "rate_limiting": {
              "type": "object",
              "description": "Rate limiting policies"
            },
            "endpoints": {
              "type": "array",
              "description": "List of exposed endpoints or operations",
              "items": {
                "type": "object"
              }
            },
            "consumers": {
              "type": "array",
              "description": "Actor or component IDs that consume this interface",
              "items": {
                "type": "string"
              }
            },
            "versioning": {
              "type": "string",
              "description": "Versioning strategy"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
