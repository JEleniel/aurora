{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Artifact Card",
  "description": "An artifact represents a document, configuration file, code module, template, or other deliverable that is part of the architecture.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "artifact"
        },
        "attributes": {
          "type": "object",
          "description": "Artifact-specific attributes",
          "properties": {
            "artifact_type": {
              "type": "string",
              "description": "Type of artifact (code, documentation, configuration, deployment template, etc.)"
            },
            "location": {
              "type": "string",
              "description": "Location or path where artifact is stored"
            },
            "format": {
              "type": "string",
              "description": "File format or syntax (Python, JSON, YAML, Markdown, Terraform, etc.)"
            },
            "language": {
              "type": "string",
              "description": "Programming or markup language"
            },
            "repository": {
              "type": "string",
              "description": "Repository URL or reference"
            },
            "branch": {
              "type": "string",
              "description": "Branch or version control reference"
            },
            "components": {
              "type": "array",
              "description": "Component IDs this artifact implements or configures",
              "items": {
                "type": "string"
              }
            },
            "requirements": {
              "type": "array",
              "description": "Requirement IDs this artifact satisfies",
              "items": {
                "type": "string"
              }
            },
            "maintainer": {
              "type": "string",
              "description": "Team or person responsible for maintaining the artifact"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
