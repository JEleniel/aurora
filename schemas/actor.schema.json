{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Actor Card",
  "description": "An actor represents a user, role, or external system that interacts with the architecture. Actors engage with behaviors and interfaces.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "actor"
        },
        "attributes": {
          "type": "object",
          "description": "Actor-specific attributes",
          "properties": {
            "actor_type": {
              "type": "string",
              "description": "Type of actor (human user, system, role, external partner, etc.)"
            },
            "responsibilities": {
              "type": "array",
              "description": "Responsibilities or capabilities of the actor",
              "items": {
                "type": "string"
              }
            },
            "interfaces": {
              "type": "array",
              "description": "Interface IDs through which the actor interacts",
              "items": {
                "type": "string"
              }
            },
            "behaviors": {
              "type": "array",
              "description": "Behavior IDs the actor participates in",
              "items": {
                "type": "string"
              }
            },
            "permissions": {
              "type": "array",
              "description": "Permissions or access rights",
              "items": {
                "type": "string"
              }
            },
            "authentication_method": {
              "type": "string",
              "description": "How the actor authenticates"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
