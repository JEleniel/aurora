{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Behavior Card",
  "description": "A behavior represents a use case, workflow, process, or interaction. Behaviors include attributes describing state machines, sequences, inputs, outputs, and interactions with actors and interfaces.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "behavior"
        },
        "attributes": {
          "type": "object",
          "description": "Behavior-specific attributes",
          "properties": {
            "actors": {
              "type": "array",
              "description": "Actor IDs involved in this behavior",
              "items": {
                "type": "string"
              }
            },
            "inputs": {
              "type": "array",
              "description": "Input data or events",
              "items": {
                "type": ["string", "object"]
              }
            },
            "outputs": {
              "type": "array",
              "description": "Output data or events",
              "items": {
                "type": ["string", "object"]
              }
            },
            "preconditions": {
              "type": "array",
              "description": "Conditions that must be true before behavior executes",
              "items": {
                "type": "string"
              }
            },
            "postconditions": {
              "type": "array",
              "description": "Conditions that must be true after behavior completes",
              "items": {
                "type": "string"
              }
            },
            "state_machine": {
              "type": "object",
              "description": "State machine definition (states, transitions)"
            },
            "sequence": {
              "type": "array",
              "description": "Ordered sequence of steps or interactions",
              "items": {
                "type": ["string", "object"]
              }
            },
            "interactions": {
              "type": "array",
              "description": "Interactions with interfaces or external systems",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
