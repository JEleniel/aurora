{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AURORA Constraint Card",
  "description": "A constraint represents a non-functional requirement, bound, limit, or policy that applies across the architecture. Constraints include quantitative or qualitative bounds.",
  "allOf": [
    {
      "$ref": "card.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "constraint"
        },
        "attributes": {
          "type": "object",
          "description": "Constraint-specific attributes with bounds, units, and formulas",
          "properties": {
            "category": {
              "type": "string",
              "description": "Constraint category (performance, security, compliance, capacity, etc.)"
            },
            "unit": {
              "type": "string",
              "description": "Unit of measurement (ms, requests/sec, GB, etc.)"
            },
            "min_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Minimum acceptable value"
            },
            "max_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Maximum acceptable value"
            },
            "target_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Target or ideal value"
            },
            "formula": {
              "type": "string",
              "description": "Mathematical or logical formula expressing the constraint"
            },
            "scope": {
              "type": "array",
              "description": "Cards or component IDs to which this constraint applies",
              "items": {
                "type": "string"
              }
            },
            "compliance_standard": {
              "type": "string",
              "description": "Standards or regulations (HIPAA, GDPR, SOC2, etc.)"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["type"]
    }
  ]
}
