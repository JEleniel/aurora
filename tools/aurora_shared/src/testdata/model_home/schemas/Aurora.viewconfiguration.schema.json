{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": true,
	"required": ["available_icons", "cards", "views"],
	"properties": {
		"$schema": { "type": "string" },
		"available_icons": { "type": "array", "items": { "type": "string" } },
		"cards": { "type": "array" },
		"views": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"layout": {
						"type": "string",
						"enum": ["TreeTopDown", "TreeLeftRight", "Radial", "Radial1", "Circular"]
					}
				},
				"additionalProperties": true
			}
		}
	}
}
