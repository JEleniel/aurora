{
	"$schema": "../node_modules/@tauri-apps/cli/schema.json",
	"productName": "Aurora Editor",
	"version": "0.1.0",
	"identifier": "com.aurora.editor",
	"build": {
		"beforeBuildCommand": "pnpm run build",
		"beforeDevCommand": "pnpm run dev -- --host 127.0.0.1 --port 5173",
		"devUrl": "http://127.0.0.1:5173",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Aurora Editor",
				"width": 1280,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "appimage", "deb", "dmg", "msi", "nsis"],
		"icon": [
			"icons/icon.png",
			"icons/AURORA.16.png",
			"icons/AURORA.32.png",
			"icons/AURORA.64.png",
			"icons/AURORA.180.png",
			"icons/AURORA.192.png",
			"icons/AURORA.512.png",
			"icons/AURORA.1024.png"
		]
	},
	"plugins": {}
}
