{
	"$id": "https://crystultima.org/aurora/view.definitions.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"definitions": {
		"acronym": {
			"pattern": "^[A-Z]{3}$",
			"type": "string"
		},
		"card_type_list": {
			"items": {
				"$ref": "#/definitions/acronym"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"non_empty": {
			"minLength": 1,
			"type": "string"
		},
		"view": {
			"additionalProperties": false,
			"properties": {
				"description": {
					"$ref": "#/definitions/non_empty"
				},
				"included_card_types": {
					"$ref": "#/definitions/card_type_list"
				},
				"name": {
					"$ref": "#/definitions/non_empty"
				},
				"root_card_types": {
					"$ref": "#/definitions/card_type_list"
				}
			},
			"required": ["name", "description", "root_card_types", "included_card_types"],
			"type": "object"
		}
	},
	"description": "JSON schema for View.Definitions.json (view registry)",
	"properties": {
		"$schema": {
			"minLength": 1,
			"type": "string"
		},
		"definitions": {
			"description": "List of view definitions",
			"items": {
				"$ref": "#/definitions/view"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		}
	},
	"required": ["definitions"],
	"title": "Aurora View Definitions Registry Schema",
	"type": "object"
}
