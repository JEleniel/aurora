{
	"$id": "https://crystultima.org/aurora/view.definitions.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Aurora View Definitions Registry Schema",
	"description": "JSON schema for View.Definitions.json (view registry)",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"description": "Optional reference to this schema file for editors/tooling",
			"type": "string",
			"minLength": 1
		},
		"definitions": {
			"description": "List of view definitions",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/definitions/view"
			}
		}
	},
	"required": ["definitions"],
	"definitions": {
		"view": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"name": {
					"description": "View name",
					"type": "string",
					"minLength": 1
				},
				"description": {
					"description": "View intent/summary",
					"type": "string",
					"minLength": 1
				},
				"root_card_types": {
					"description": "Card types that define candidate roots for this view",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"included_card_types": {
					"description": "Card types eligible to be rendered when reachable from a root",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["name", "description", "root_card_types", "included_card_types"]
		}
	}
}
