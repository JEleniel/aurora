{
	"$id": "https://crystultima.org/aurora/canonical.definitions.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Aurora Canonical Definitions Registry Schema",
	"description": "JSON schema for Aurora.canonical.definitions.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["definitions", "relationships"],
	"properties": {
		"$schema": {
			"type": "string",
			"minLength": 1
		},
		"definitions": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/definitions/entry"
			}
		},
		"relationships": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/definitions/relationship"
			}
		}
	},
	"definitions": {
		"non_empty": {
			"type": "string",
			"minLength": 1
		},
		"acronym": {
			"type": "string",
			"pattern": "^[A-Z]{3}$"
		},
		"hex_color": {
			"type": "string",
			"pattern": "^#[A-Fa-f0-9]{6}$"
		},
		"relationship": {
			"type": "object",
			"additionalProperties": false,
			"required": ["source_card_type", "target_card_type", "relationship"],
			"properties": {
				"source_card_type": {
					"$ref": "#/definitions/non_empty"
				},
				"target_card_type": {
					"$ref": "#/definitions/non_empty"
				},
				"relationship": {
					"$ref": "#/definitions/non_empty"
				}
			}
		},
		"common_property": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "description"],
			"properties": {
				"name": {
					"$ref": "#/definitions/non_empty"
				},
				"description": {
					"$ref": "#/definitions/non_empty"
				}
			}
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["card_type", "acronym", "description"],
			"properties": {
				"card_type": {
					"$ref": "#/definitions/non_empty"
				},
				"acronym": {
					"$ref": "#/definitions/acronym"
				},
				"description": {
					"$ref": "#/definitions/non_empty"
				},
				"common_subtypes": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/definitions/non_empty"
					}
				},
				"common_properties": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/definitions/common_property"
					}
				}
			}
		}
	}
}
