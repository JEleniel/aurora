{
	"$id": "https://crystultima.org/aurora/canonical.definitions.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"definitions": {
		"acronym": {
			"pattern": "^[A-Z]{3}$",
			"type": "string"
		},
		"common_property": {
			"additionalProperties": false,
			"properties": {
				"description": {
					"$ref": "#/definitions/non_empty"
				},
				"name": {
					"$ref": "#/definitions/non_empty"
				}
			},
			"required": ["name", "description"],
			"type": "object"
		},
		"entry": {
			"additionalProperties": false,
			"properties": {
				"acronym": {
					"$ref": "#/definitions/acronym"
				},
				"card_type": {
					"$ref": "#/definitions/non_empty"
				},
				"common_properties": {
					"items": {
						"$ref": "#/definitions/common_property"
					},
					"minItems": 1,
					"type": "array",
					"uniqueItems": true
				},
				"common_subtypes": {
					"items": {
						"$ref": "#/definitions/non_empty"
					},
					"minItems": 1,
					"type": "array",
					"uniqueItems": true
				},
				"description": {
					"$ref": "#/definitions/non_empty"
				}
			},
			"required": ["card_type", "acronym", "description"],
			"type": "object"
		},
		"non_empty": {
			"minLength": 1,
			"type": "string"
		},
		"relationship": {
			"additionalProperties": false,
			"properties": {
				"relationship": {
					"$ref": "#/definitions/non_empty"
				},
				"source_card_type": {
					"$ref": "#/definitions/acronym"
				},
				"target_card_type": {
					"$ref": "#/definitions/acronym"
				}
			},
			"required": ["source_card_type", "target_card_type", "relationship"],
			"type": "object"
		}
	},
	"description": "JSON schema for Aurora.canonical.definitions.json",
	"properties": {
		"$schema": {
			"minLength": 1,
			"type": "string"
		},
		"definitions": {
			"items": {
				"$ref": "#/definitions/entry"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		},
		"relationships": {
			"items": {
				"$ref": "#/definitions/relationship"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		}
	},
	"required": ["definitions", "relationships"],
	"title": "Aurora Canonical Definitions Registry Schema",
	"type": "object"
}
