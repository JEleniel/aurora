{
	"$id": "https://crystultima.org/aurora/canonical.definitions.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Aurora Canonical Definitions Registry Schema",
	"description": "JSON schema for Aurora.canonical.definitions.json (card type registry)",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"description": "Optional reference to this schema file for editors/tooling",
			"type": "string",
			"minLength": 1
		},
		"definitions": {
			"description": "List of canonical card type definitions",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/definitions/entry"
			}
		},
		"relationships": {
			"description": "List of allowed relationships between card types",
			"type": "array",
			"items": {
				"$ref": "#/definitions/relationship"
			}
		}
	},
	"required": ["definitions", "relationships"],
	"definitions": {
		"hex_color": {
			"description": "6-digit hex color in #RRGGBB form",
			"type": "string",
			"pattern": "^#[A-Fa-f0-9]{6}$"
		},
		"relationship": {
			"description": "Single mapping from target card acronym to a human-readable verb",
			"type": "object",
			"properties": {
				"source_card_type": { "type": "string" },
				"target_card_type": { "type": "string" },
				"relationship": { "type": "string" }
			},
			"required": ["source_card_type", "target_card_type", "relationship"],
			"additionalProperties": false
		},
		"entry": {
			"description": "One canonical card type definition (normative + optional rendering fields)",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"card_type": {
					"description": "Human-facing type name in Title Case",
					"type": "string",
					"minLength": 1
				},
				"acronym": {
					"description": "3-letter id prefix used in compact ids and link targets",
					"type": "string",
					"pattern": "^[A-Z]{3}$"
				},
				"description": {
					"description": "Short definition of the card type",
					"type": "string",
					"minLength": 1
				},
				"common_subtypes": {
					"description": "Common subtype suggestions (non-normative)",
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1
				},
				"common_properties:": {
					"description": "Common property suggestions (non-normative)",
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"description": "Property name",
								"type": "string",
								"minLength": 1
							},
							"description": {
								"description": "Short description of the property",
								"type": "string",
								"minLength": 1
							}
						},
						"required": ["name", "description"],
						"additionalProperties": false
					},
					"additionalItems": false
				}
			},
			"required": ["card_type", "acronym", "description"]
		}
	}
}
