{
	"$id": "https://crystultima.org/aurora/appearance.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Aurora Appearance Schema",
	"description": "JSON schema for Aurora.appearance.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["definitions"],
	"properties": {
		"$schema": {
			"type": "string",
			"minLength": 1
		},
		"definitions": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/definitions/entry"
			}
		}
	},
	"definitions": {
		"acronym": {
			"type": "string",
			"pattern": "^[A-Z]{3}$"
		},
		"hex_color": {
			"type": "string",
			"pattern": "^#[A-Fa-f0-9]{6}$"
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["acronym", "shape", "icon", "fill", "color"],
			"properties": {
				"acronym": {
					"$ref": "#/definitions/acronym"
				},
				"shape": {
					"type": "string",
					"minLength": 1
				},
				"icon": {
					"type": "string",
					"minLength": 1
				},
				"fill": {
					"$ref": "#/definitions/hex_color"
				},
				"color": {
					"$ref": "#/definitions/hex_color"
				}
			}
		}
	}
}
