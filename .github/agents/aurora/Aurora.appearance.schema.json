{
	"$id": "https://crystultima.org/aurora/appearance.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"definitions": {
		"acronym": {
			"pattern": "^[A-Z]{3}$",
			"type": "string"
		},
		"entry": {
			"additionalProperties": false,
			"properties": {
				"acronym": {
					"$ref": "#/definitions/acronym"
				},
				"color": {
					"$ref": "#/definitions/hex_color"
				},
				"fill": {
					"$ref": "#/definitions/hex_color"
				},
				"icon": {
					"minLength": 1,
					"type": "string"
				},
				"shape": {
					"minLength": 1,
					"type": "string"
				}
			},
			"required": ["acronym", "shape", "fill", "color"],
			"type": "object"
		},
		"hex_color": {
			"pattern": "^#[A-Fa-f0-9]{6}$",
			"type": "string"
		}
	},
	"description": "JSON schema for Aurora.appearance.json",
	"properties": {
		"$schema": {
			"minLength": 1,
			"type": "string"
		},
		"definitions": {
			"items": {
				"$ref": "#/definitions/entry"
			},
			"minItems": 1,
			"type": "array",
			"uniqueItems": true
		}
	},
	"required": ["definitions"],
	"title": "Aurora Appearance Schema",
	"type": "object"
}
