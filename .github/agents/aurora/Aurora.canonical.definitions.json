			"description": "Logical/physical execution environment hosting components or stores."
		},
		{
			"acronym": "PRD",
			"card_type": "Predicate",
			"description": "Logical statement evaluating to true/false in a state machine."
		},
		{
			"acronym": "PRO",
			"card_type": "Process",
			"description": "Ordered sequence of activities/decisions enabling a capability."
		},
