	"definitions": [
		{
			"acronym": "ATV",
			"card_type": "Activity",
			"description": "Discrete step within a process."
		},
		{
			"acronym": "ACT",
			"card_type": "Actor",
			"common_subtypes": ["User", "Admin", "External System", "Regulator"],
			"description": "External role interacting with or obligating the system."
		},
		{
			"acronym": "STK",
			"card_type": "Stakeholder",
			"common_subtypes": ["Customer", "End User", "Operator", "Manager", "Regulator"],
			"description": "Person, group, or role with an interest in or affected by the system."
		},
		{
			"acronym": "ADR",
			"card_type": "ADR",
			"description": "Architectural Decision Record capturing a significant decision, alternatives considered, rationale, trade-offs, and consequences."
		},
		{
			"acronym": "ART",
			"card_type": "Artifact",
			"common_subtypes": ["Document", "Data", "Diagram", "Code", "Model", "Report"],
			"description": "Concrete work product produced or consumed by the system."
		},
		{
			"acronym": "AST",
			"card_type": "Asset",
			"description": "Valuable information/resources requiring protection."
		},
		{
			"acronym": "CAP",
			"card_type": "Capability",
			"description": "Implementation-independent ability that satisfies requirements."
		},
		{
			"acronym": "SYS",
			"card_type": "System",
			"description": "Top-level software system composed of applications and components."
		},
		{
			"acronym": "APP",
			"card_type": "Application",
			"description": "Deployable application within a system, composed of components."
		},
		{
			"acronym": "COM",
			"card_type": "Component",
			"common_subtypes": ["API", "Library", "Service", "Module", "Subsystem", "Class"],
			"description": "Modular unit with a single responsibility and explicit interfaces."
		},
		{
			"acronym": "DST",
			"card_type": "Data Store",
			"common_subtypes": ["Relational", "Object Store", "Event Log", "Key-Value", "Graph"],
			"description": "Persistent storage system that holds artifacts and data for retrieval and lineage."
		},
		{
			"acronym": "CON",
			"card_type": "Condition",
			"description": "Binary predicate influencing behavior."
		},
		{
			"acronym": "CNS",
			"card_type": "Constraint",
			"description": "Rule limiting allowable behavior or solutions."
		},
		{
			"acronym": "CTL",
			"card_type": "Control",
			"description": "Mechanism governing or constraining a process."
		},
		{
			"acronym": "DEP",
			"card_type": "Deployment",
			"description": "Defined environment or configuration where software executes."
		},
		{
			"acronym": "DSR",
			"card_type": "Data Source",
			"common_subtypes": ["External System", "Upstream Feed", "Sensor", "Third-Party API"],
			"description": "Origin of artifacts and data entering the system, used to model provenance and lineage."
		},
		{
			"acronym": "DRI",
			"card_type": "Driver",
			"description": "Motivation explaining why requirements exist."
		},
		{
			"acronym": "EVT",
			"card_type": "Event",
			"description": "Discrete occurrence initiating a process or triggering behavior."
		},
		{
			"acronym": "FEA",
			"card_type": "Feature",
			"description": "Externally observable behavior realizing one or more requirements."
		},
		{
			"acronym": "INT",
			"card_type": "Interface",
			"description": "Contract governing interaction across a boundary."
		},
		{
			"acronym": "MIS",
			"card_type": "Mission",
			"description": "Root intent that spawns every downstream driver."
		},
		{
			"acronym": "NOD",
			"card_type": "Node",
