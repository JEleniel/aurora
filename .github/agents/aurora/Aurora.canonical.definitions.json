			"description": "Verifiable statement of need/obligation."
		},
		{
			"acronym": "RIS",
			"card_type": "Risk",
			"description": "Potential for loss/harm from threats/vulnerabilities."
		},
		{
			"acronym": "STA",
			"card_type": "State",
			"description": "Observable condition that persists until a transition."
		},
		{
			"acronym": "STM",
