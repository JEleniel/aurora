{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "aurora",
	"version": "1.0.0",
	"identifier": "org.crystultima.aurora",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "AURORA Architecture",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"../static/AURORA.32.png",
			"../static/AURORA.64.png",
			"../static/AURORA.192.png",
			"../static/AURORA.512.png",
			"../static/AURORA.1024.png"
		]
	}
}
