digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				CAP_003[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Model Validation</B><BR/>
				<BR/>
				Ability to validate Aurora model invariants and provide actionable diagnostics b<BR/>efore any downstream rendering/export steps.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Model_Validation.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_002[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Model Discovery and Loading</B><BR/>
				<BR/>
				Ability to locate Aurora model homes from a user-provided path and load all card<BR/> JSON/JSJSON files into an indexed in-memory model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Model_Discovery_and_Loading.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_005[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>View Rendering</B><BR/>
				<BR/>
				Ability to render canonical Aurora views by generating DOT sources and producing<BR/> SVG diagrams using a Graphviz-compatible renderer.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/View_Rendering.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_006[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Compact Agent Export</B><BR/>
				<BR/>
				Ability to write a compact, single-file snapshot of a mission-scoped model for a<BR/>gent consumption.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Compact_Agent_Export.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_008[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Registry Backed Tooling</B><BR/>
				<BR/>
				Ability to validate and render using embedded canonical registries for card defi<BR/>nitions, relationship rules, and view specifications.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Registry_Backed_Tooling.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_007[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Audit Version Bumping</B><BR/>
				<BR/>
				Ability to update card audit trail versions (patch/minor/major) and append an au<BR/>dit event in a deterministic, tool-driven manner.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Audit_Version_Bumping.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_004[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Markdown Rendering</B><BR/>
				<BR/>
				Ability to render human-readable Markdown documentation for every card plus a mi<BR/>ssion-level executive summary.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-003-views/Markdown_Rendering.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
			CAP_003 -> REQ_003 [label="satisfies"];
									CAP_002 -> REQ_002 [label="satisfies"];
									CAP_005 -> REQ_005 [label="satisfies"];
									CAP_006 -> REQ_006 [label="satisfies"];
									CAP_008 -> REQ_008 [label="satisfies"];
									CAP_007 -> REQ_007 [label="satisfies"];
									CAP_004 -> REQ_004 [label="satisfies"];
								}