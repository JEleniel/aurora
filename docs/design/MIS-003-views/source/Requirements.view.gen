    {
      "_gvid": 6,
      "name": "REQ_006",
      "bb": null,
      "label": "\n\t\t\t\t<FONT COLOR=\"#FFFFFF\"><B>Requirement</B><BR/>\n\t\t\t\t<B>Write Compact Agent Export</B><BR/>\n\t\t\t\t<BR/>\n\t\t\t\tThe tooling SHALL generate a single-file compact export suitable for agent consu<BR/>mption (AGENT-&lt;MISSION_ID&gt;.jsjson by default) by removing non-essential fields (<BR/>e.g., $schema, audit trail metadata) while preserving the card graph structure.<BR/></FONT>\n\t\t\t",
      "pos": "5800.6,84.853",
      "nodes": null,
