    {
      "_gvid": 6,
      "name": "REQ_008",
      "bb": null,
      "label": "\n\t\t\t\t<FONT COLOR=\"#FFFFFF\"><B>Requirement</B><BR/>\n\t\t\t\t<B>Embed Canonical Registries</B><BR/>\n\t\t\t\t<BR/>\n\t\t\t\tThe tooling SHALL embed canonical registries for card types, relationship verbs,<BR/> and view definitions so validation and rendering can operate deterministically <BR/>without depending on external instruction files at runtime.<BR/></FONT>\n\t\t\t",
      "pos": "5167.7,84.853",
      "nodes": null,
      "edges": null,
      "subgraphs": null,
      "height": "1.8071",
