    {
      "_gvid": 5,
      "name": "REQ_008",
      "label": "\n\t\t\t\t<B>Requirement</B><BR/>\n\t\t\t\t<B>Embed Canonical Registries</B><BR/>\n\t\t\t\t<BR/>\n\t\t\t\tThe tooling SHALL embed canonical registries for card types, relationship verbs,<BR/> and view definitions so validation and rendering can operate deterministically <BR/>without depending on external instruction files at runtime.<BR/>\n\t\t\t",
