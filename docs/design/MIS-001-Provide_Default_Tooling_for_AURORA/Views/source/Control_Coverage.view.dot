digraph "Control Coverage View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"AST-001" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>Asset</B><br />Aurora Models<br /><br />Aurora model source files (cards and schema references)<br />that represent the authoritative architecture model<br />content.</FONT>>, shape="box"];
	"AST-002" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>Asset</B><br />Rendered Documentation Output<br /><br />Generated Markdown and view artifacts produced from<br />Aurora models (e.g., rendered card pages and view<br />markdown).</FONT>>, shape="box"];
	"AST-003" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>Asset</B><br />User Workspace Content<br /><br />The user’s workspace files and settings (including<br />source code and secrets) that tooling must not corrupt<br />or exfiltrate.</FONT>>, shape="box"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Workspace Trust Gate<br /><br />Gate potentially unsafe operations (e.g., file writes,<br />webview rendering, executing tools) behind workspace<br />trust checks and explicit user consent.</FONT>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Safe Path Handling and Atomic Writes<br /><br />Constrain paths to the intended workspace/model roots,<br />normalize and validate paths, and use atomic write<br />patterns to prevent partial writes and clobbering.</FONT>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Content Sanitization<br /><br />Sanitize rendered Markdown and webview content, restrict<br />resource loading, and disable script execution to<br />prevent injection.</FONT>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Least Privilege File Access<br /><br />Minimize read/write permissions and scope operations to<br />explicit user-selected paths; avoid reading or writing<br />unrelated workspace files.</FONT>>, shape="octagon"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>Feature</B><br />Safe File Operations<br /><br />Perform safe, constrained file operations with clear<br />user intent boundaries and reliable persistence<br />semantics.</FONT>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>Feature</B><br />Workspace Trust Gating<br /><br />Respect workspace trust boundaries by limiting<br />operations when the workspace is untrusted.</FONT>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>Feature</B><br />Sanitized Rendering<br /><br />Render Markdown and webview content safely, preventing<br />script injection and unsafe resource access.</FONT>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Safe File Operations<br /><br />Tools MUST perform file operations safely (prevent<br />unintended overwrites, constrain paths, and avoid<br />writing outside the user’s intended workspace<br />locations).</FONT>>, shape="box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Workspace Trust Gating<br /><br />Tools MUST respect workspace trust boundaries by<br />limiting potentially unsafe operations in untrusted<br />workspaces.</FONT>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Sanitized Rendering<br /><br />Tools MUST render Markdown and any webview content<br />safely by sanitizing untrusted content and preventing<br />script injection.</FONT>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Injected Content in Rendered Output<br /><br />Rendered output could contain unsafe content that<br />misleads users or executes in a webview context.</FONT>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Unintended File Modification<br /><br />Tooling could overwrite or corrupt files outside the<br />intended model output locations.</FONT>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Data Exposure from Untrusted Workspace<br /><br />Operating against untrusted workspace content could lead<br />to disclosure of sensitive data or unintended access<br />beyond user intent.</FONT>>, shape="octagon"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Script Injection via Markdown<br /><br />Untrusted content in model descriptions or rendered<br />Markdown could inject script or unsafe resources into a<br />webview-based renderer.</FONT>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Path Traversal or Arbitrary Write<br /><br />A crafted input path or unsafe write behavior could<br />cause tooling to write outside the intended<br />model/workspace directory, overwriting unrelated files.</FONT>>, shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Untrusted Workspace Execution or Access<br /><br />Operating in an untrusted workspace could allow unsafe<br />operations that lead to data exposure or unintended<br />execution paths.</FONT>>, shape="octagon"];
	"CTL-001" -> "RIS-003" [label="mitigates"];
	"CTL-001" -> "THR-003" [label="mitigates"];
	"CTL-002" -> "RIS-002" [label="mitigates"];
	"CTL-002" -> "THR-002" [label="mitigates"];
	"CTL-003" -> "RIS-001" [label="mitigates"];
	"CTL-003" -> "THR-001" [label="mitigates"];
	"CTL-004" -> "RIS-002" [label="mitigates"];
	"CTL-004" -> "RIS-003" [label="mitigates"];
	"FEA-013" -> "REQ-015" [label="satisfies"];
	"FEA-013" -> "RIS-002" [label="mitigates"];
	"FEA-013" -> "THR-002" [label="mitigates"];
	"FEA-014" -> "REQ-016" [label="satisfies"];
	"FEA-014" -> "RIS-003" [label="mitigates"];
	"FEA-014" -> "THR-003" [label="mitigates"];
	"FEA-015" -> "REQ-017" [label="satisfies"];
	"FEA-015" -> "RIS-001" [label="mitigates"];
	"FEA-015" -> "THR-001" [label="mitigates"];
	"RIS-001" -> "AST-002" [label="impacts"];
	"RIS-001" -> "AST-003" [label="impacts"];
	"RIS-002" -> "AST-001" [label="impacts"];
	"RIS-002" -> "AST-003" [label="impacts"];
	"RIS-003" -> "AST-003" [label="impacts"];
	"THR-001" -> "RIS-001" [label="imposes"];
	"THR-002" -> "RIS-002" [label="imposes"];
	"THR-003" -> "RIS-003" [label="imposes"];
}