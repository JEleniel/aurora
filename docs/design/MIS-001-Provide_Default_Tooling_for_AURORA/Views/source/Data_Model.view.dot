digraph "Data Model View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Aurora Schema<br /><br />The Aurora JSON schema(s) that define valid card<br />structure and related invariants for validation tooling.</FONT>>, shape="tab"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Aurora Tooling<br /><br />Default tooling suite for Aurora, including CLI, editor,<br />and VS Code extension surfaces.</FONT>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Card Registry<br /><br />Canonical registries for card types, view definitions,<br />and relationship definitions used by the Aurora model.</FONT>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Markdown Documentation<br /><br />Human-readable Markdown documentation generated from the<br />model, including card pages and indexes.</FONT>>, shape="tab"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />View Diagram Set<br /><br />A set of rendered view diagrams (e.g., Mermaid) produced<br />from an Aurora model.</FONT>>, shape="tab"];
	"ART-006" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Compact Model Format<br /><br />Compact, agent-friendly representation of the model<br />(e.g., AGENT-&lt;MISSION_ID&gt;.jsjson) used for interchange<br />and machine consumption.</FONT>>, shape="tab"];
	"ART-007" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Validation Report<br /><br />Structured and/or human-readable validation report and<br />diagnostics output for a model.</FONT>>, shape="tab"];
	"ART-008" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Webview Rendered Markdown<br /><br />Rendered Markdown content displayed inside a sandboxed<br />webview (e.g., VS Code or Tauri webview).</FONT>>, shape="tab"];
	"ART-009" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Requirements.view.md<br /><br />Rendered Requirements View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-010" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Component.view.md<br /><br />Rendered Component View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-011" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Deployment.view.md<br /><br />Rendered Deployment View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-012" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Process.view.md<br /><br />Rendered Process (Activity) View Markdown generated from<br />the Aurora model.</FONT>>, shape="tab"];
	"ART-013" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />State_Machine.view.md<br /><br />Rendered State Machine View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-014" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Threat_Model.view.md<br /><br />Rendered Threat Model View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-015" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />ACT-001.md<br /><br />Rendered Actor card page for ACT-001.</FONT>>, shape="tab"];
	"ART-016" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />AST-001.md<br /><br />Rendered Asset card page for AST-001.</FONT>>, shape="tab"];
	"ART-017" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />ATV-001.md<br /><br />Rendered Activity card page for ATV-001.</FONT>>, shape="tab"];
	"ART-018" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />CAP-001.md<br /><br />Rendered Capability card page for CAP-001.</FONT>>, shape="tab"];
	"ART-019" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />COM-001.md<br /><br />Rendered Component card page for COM-001.</FONT>>, shape="tab"];
	"ART-020" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />CNS-001.md<br /><br />Rendered Constraint card page for CNS-001.</FONT>>, shape="tab"];
	"ART-021" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />FEA-001.md<br /><br />Rendered Feature card page for FEA-001.</FONT>>, shape="tab"];
	"ART-022" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />PRO-001.md<br /><br />Rendered Process card page for PRO-001.</FONT>>, shape="tab"];
	"ART-023" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />REQ-001.md<br /><br />Rendered Requirement card page for REQ-001.</FONT>>, shape="tab"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Shared Library<br /><br />Shared library component used across tooling surfaces to<br />load, validate, update, and save Aurora models. It is<br />the implementation home for common parsing, invariants,<br />deterministic rendering, and safe write semantics.</FONT>>, shape="box3d"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Tauri Svelte UI<br /><br />The Tauri/Svelte front-end UI component for the Editor<br />application.</FONT>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Tauri Rust Backend<br /><br />The Rust backend component for the Editor application,<br />hosting the native Tauri commands and integrations.</FONT>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />MCP Server<br /><br />Model Context Protocol (MCP) server component used by<br />the VSCode extension to expose Aurora model operations<br />via the shared library.</FONT>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B> (struct)<br />Aurora<br /><br />Core Aurora domain component providing the aggregate<br />root for working with a set of models.</FONT>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B> (struct)<br />Model<br /><br />Aurora model domain component representing a directed<br />graph of cards and links.</FONT>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B> (struct)<br />Card<br /><br />Aurora card domain component representing a single<br />architectural element with links and audit trail.</FONT>>, shape="box3d"];
	"COM-012" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Aurora CLI<br /><br />Command-line interface component that orchestrates<br />validation, view rendering, and compact export for<br />Aurora models.</FONT>>, shape="box3d"];
	"COM-013" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />VSCode Extension Host<br /><br />Extension host component responsible for activation,<br />command registration, workspace integration, and<br />coordinating model operations for the VSCode extension.</FONT>>, shape="box3d"];
	"COM-014" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Webview UI Host<br /><br />Webview UI component hosting interactive model browsing,<br />editing, visualization, and preview experiences within<br />VSCode.</FONT>>, shape="box3d"];
	"COM-015" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>🧊 Component</B><br />Workspace Adapter<br /><br />Component that mediates workspace file operations (open,<br />watch, and save) with safe defaults and trust-aware<br />behaviors.</FONT>>, shape="box3d"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Local File System<br /><br />Local file system (workspace) used as the primary<br />persistence mechanism for Aurora model files and<br />generated outputs.</FONT>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Extension State Store<br /><br />VSCode extension storage for persisted settings and<br />non-source-of-truth state (cache, UI state, last-opened<br />model, etc.).</FONT>>, shape="cylinder"];
	"INT-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<FONT><B>🔌 Interface</B><br />CLI Interface<br /><br />Command-line interface surface exposing Aurora model<br />operations as subcommands (validate, render-all,<br />compact, etc.).</FONT>>, shape="note"];
	"INT-002" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<FONT><B>🔌 Interface</B><br />MCP Interface<br /><br />Model Context Protocol interface surface exposing Aurora<br />operations to in-editor tooling via an MCP server.</FONT>>, shape="note"];
	"INT-003" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<FONT><B>🔌 Interface</B><br />Editor Backend API<br /><br />Native command interface between the Editor UI and the<br />Tauri Rust backend for model operations (load, validate,<br />update, render previews, save).</FONT>>, shape="note"];
	"INT-004" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<FONT><B>🔌 Interface</B><br />VSCode Webview Messaging API<br /><br />Message-based interface between VSCode extension host<br />and webview UI for model navigation, editing, and<br />preview rendering.</FONT>>, shape="note"];
	"INT-005" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<FONT><B>🔌 Interface</B><br />VSCode Commands Interface<br /><br />VSCode command surface for invoking Aurora tooling<br />actions (validate, render, open views, export compact,<br />etc.) from the command palette and context menus.</FONT>>, shape="note"];
