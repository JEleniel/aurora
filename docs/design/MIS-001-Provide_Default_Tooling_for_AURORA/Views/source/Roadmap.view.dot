digraph "Roadmap View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-001: <B>Artifact</B><BR/>Aurora Schema<BR/>&#160;<BR/>The Aurora JSON schema(s) that define valid card<BR/>structure and related invariants for validation tooling.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-002: <B>Artifact</B><BR/>Aurora Tooling<BR/>&#160;<BR/>Default tooling suite for Aurora, including CLI, editor,<BR/>and VS Code extension surfaces.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-003: <B>Artifact</B><BR/>Card Registry<BR/>&#160;<BR/>Canonical registries for card types, view definitions,<BR/>and relationship definitions used by the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-004: <B>Artifact</B><BR/>Markdown Documentation<BR/>&#160;<BR/>Human-readable Markdown documentation generated from the<BR/>model, including card pages and indexes.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-005: <B>Artifact</B><BR/>View Diagram Set<BR/>&#160;<BR/>A set of rendered view diagrams (e.g., Mermaid) produced<BR/>from an Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-006" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-006: <B>Artifact</B><BR/>Compact Model Format<BR/>&#160;<BR/>Compact, agent-friendly representation of the model<BR/>(e.g., AGENT-&lt;MISSION_ID&gt;.jsjson) used for interchange<BR/>and machine consumption.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-007" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-007: <B>Artifact</B><BR/>Validation Report<BR/>&#160;<BR/>Structured and/or human-readable validation report and<BR/>diagnostics output for a model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-008" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-008: <B>Artifact</B><BR/>Webview Rendered Markdown<BR/>&#160;<BR/>Rendered Markdown content displayed inside a sandboxed<BR/>webview (e.g., VS Code or Tauri webview).</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-009" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-009: <B>Artifact</B><BR/>Requirements.view.md<BR/>&#160;<BR/>Rendered Requirements View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-010" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-010: <B>Artifact</B><BR/>Component.view.md<BR/>&#160;<BR/>Rendered Component View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-011" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-011: <B>Artifact</B><BR/>Deployment.view.md<BR/>&#160;<BR/>Rendered Deployment View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-012" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-012: <B>Artifact</B><BR/>Process.view.md<BR/>&#160;<BR/>Rendered Process (Activity) View Markdown generated from<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
