digraph "Environment View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-001: <B>Application</B><BR/>Command Line Tools<BR/>&#160;<BR/>A deployable command-line application that validates,<BR/>renders, and manages Aurora models. The CLI is optimized<BR/>for deterministic, automatable workflows (local<BR/>scripting and CI), and delegates model semantics<BR/>(parsing, invariants, rendering) to the shared library.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-002: <B>Application</B><BR/>Editor<BR/>&#160;<BR/>A deployable application that provides an interactive<BR/>experience for creating, editing, and navigating Aurora<BR/>models. The Editor focuses on discoverability and safe,<BR/>incremental iteration with immediate validation<BR/>feedback.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-003: <B>Application</B><BR/>VSCode Extension<BR/>&#160;<BR/>A VS Code extension that enables authoring, validation,<BR/>and visualization of Aurora models within the editor. It<BR/>provides trust-aware workspace integration,<BR/>webview-based UI experiences, and (optionally) an MCP<BR/>server surface for other in-editor tooling.</FONT></TD></TR></TABLE>>, shape="component"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-001: <B>Component</B><BR/>Shared Library<BR/>&#160;<BR/>Shared library component used across tooling surfaces to<BR/>load, validate, update, and save Aurora models. It is<BR/>the implementation home for common parsing, invariants,<BR/>deterministic rendering, and safe write semantics.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-002: <B>Component</B><BR/>Tauri Svelte UI<BR/>&#160;<BR/>The Tauri/Svelte front-end UI component for the Editor<BR/>application.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-003: <B>Component</B><BR/>Tauri Rust Backend<BR/>&#160;<BR/>The Rust backend component for the Editor application,<BR/>hosting the native Tauri commands and integrations.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-004: <B>Component</B><BR/>Explorer Tree View<BR/>&#160;<BR/>Editor UI component that presents an explorer tree over<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-005: <B>Component</B><BR/>Mind-Map Like View<BR/>&#160;<BR/>Editor UI component that provides a mind-map-like<BR/>visualization for navigating the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-006: <B>Component</B><BR/>Edit View<BR/>&#160;<BR/>Editor UI component for editing cards, attributes, and<BR/>links in an Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-007: <B>Component</B><BR/>Markdown View<BR/>&#160;<BR/>Editor UI component for viewing and editing<BR/>human-readable Markdown renderings of the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-008: <B>Component</B><BR/>MCP Server<BR/>&#160;<BR/>Model Context Protocol (MCP) server component used by<BR/>the VSCode extension to expose Aurora model operations<BR/>via the shared library.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-009: <B>Component</B> (struct)<BR/>Aurora<BR/>&#160;<BR/>Core Aurora domain component providing the aggregate<BR/>root for working with a set of models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-010: <B>Component</B> (struct)<BR/>Model<BR/>&#160;<BR/>Aurora model domain component representing a directed<BR/>graph of cards and links.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-011: <B>Component</B> (struct)<BR/>Card<BR/>&#160;<BR/>Aurora card domain component representing a single<BR/>architectural element with links and audit trail.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-012" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-012: <B>Component</B><BR/>Aurora CLI<BR/>&#160;<BR/>Command-line interface component that orchestrates<BR/>validation, view rendering, and compact export for<BR/>Aurora models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-013" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-013: <B>Component</B><BR/>VSCode Extension Host<BR/>&#160;<BR/>Extension host component responsible for activation,<BR/>command registration, workspace integration, and<BR/>coordinating model operations for the VSCode extension.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-014" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-014: <B>Component</B><BR/>Webview UI Host<BR/>&#160;<BR/>Webview UI component hosting interactive model browsing,<BR/>editing, visualization, and preview experiences within<BR/>VSCode.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-015" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-015: <B>Component</B><BR/>Workspace Adapter<BR/>&#160;<BR/>Component that mediates workspace file operations (open,<BR/>watch, and save) with safe defaults and trust-aware<BR/>behaviors.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-001: <B>Control</B><BR/>Workspace Trust Gate<BR/>&#160;<BR/>Gate potentially unsafe operations (e.g., file writes,<BR/>webview rendering, executing tools) behind workspace<BR/>trust checks and explicit user consent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-002: <B>Control</B><BR/>Safe Path Handling and Atomic Writes<BR/>&#160;<BR/>Constrain paths to the intended workspace/model roots,<BR/>normalize and validate paths, and use atomic write<BR/>patterns to prevent partial writes and clobbering.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-003: <B>Control</B><BR/>Content Sanitization<BR/>&#160;<BR/>Sanitize rendered Markdown and webview content, restrict<BR/>resource loading, and disable script execution to<BR/>prevent injection.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-004: <B>Control</B><BR/>Least Privilege File Access<BR/>&#160;<BR/>Minimize read/write permissions and scope operations to<BR/>explicit user-selected paths; avoid reading or writing<BR/>unrelated workspace files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"DEP-001" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☁️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DEP-001: <B>Deployment</B><BR/>Local Development<BR/>&#160;<BR/>A local development deployment where Aurora tooling is<BR/>built and run during development.</FONT></TD></TR></TABLE>>, shape="box"];
	"DEP-002" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☁️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DEP-002: <B>Deployment</B><BR/>User Environment<BR/>&#160;<BR/>A user workstation environment where the Editor, CLI,<BR/>and VSCode extension execute against workspace content.</FONT></TD></TR></TABLE>>, shape="box"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DTS-001: <B>Data Store</B><BR/>Local File System<BR/>&#160;<BR/>Local file system (workspace) used as the primary<BR/>persistence mechanism for Aurora model files and<BR/>generated outputs.</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DTS-002: <B>Data Store</B><BR/>Extension State Store<BR/>&#160;<BR/>VSCode extension storage for persisted settings and<BR/>non-source-of-truth state (cache, UI state, last-opened<BR/>model, etc.).</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"NOD-001" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-001: <B>Node</B><BR/>User Workstation<BR/>&#160;<BR/>A user workstation that hosts local CLI and desktop<BR/>tooling and provides workspace file system access.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-002" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-002: <B>Node</B><BR/>VSCode Extension Host<BR/>&#160;<BR/>VSCode extension host runtime where the extension<BR/>executes and performs workspace operations.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-003" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-003: <B>Node</B><BR/>Webview Sandbox<BR/>&#160;<BR/>Sandboxed webview runtime used for interactive UI<BR/>surfaces inside VSCode.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-004" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-004: <B>Node</B><BR/>Tauri Runtime<BR/>&#160;<BR/>Desktop runtime environment hosting the Tauri backend<BR/>used by the Editor.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOT-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗒️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOT-001: <B>Note</B><BR/>Shareable<BR/>&#160;<BR/>Tooling surfaces should prioritize shareable, portable<BR/>artifacts (e.g., rendered views and model packages)<BR/>without compromising workspace trust and path safety.</FONT></TD></TR></TABLE>>, shape="note"];
