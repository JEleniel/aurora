digraph "Executive Summary View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-001: <B>Application</B><BR/>Command Line Tools<BR/>&#160;<BR/>A deployable command-line application that validates,<BR/>renders, and manages Aurora models. The CLI is optimized<BR/>for deterministic, automatable workflows (local<BR/>scripting and CI), and delegates model semantics<BR/>(parsing, invariants, rendering) to the shared library.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-002: <B>Application</B><BR/>Editor<BR/>&#160;<BR/>A deployable application that provides an interactive<BR/>experience for creating, editing, and navigating Aurora<BR/>models. The Editor focuses on discoverability and safe,<BR/>incremental iteration with immediate validation<BR/>feedback.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-003: <B>Application</B><BR/>VSCode Extension<BR/>&#160;<BR/>A VS Code extension that enables authoring, validation,<BR/>and visualization of Aurora models within the editor. It<BR/>provides trust-aware workspace integration,<BR/>webview-based UI experiences, and (optionally) an MCP<BR/>server surface for other in-editor tooling.</FONT></TD></TR></TABLE>>, shape="component"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-001: <B>Capability</B><BR/>Model IO<BR/>&#160;<BR/>Ability to load and save Aurora models from and to disk<BR/>in stable formats.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-002: <B>Capability</B><BR/>Model Validation<BR/>&#160;<BR/>Ability to validate Aurora models for schema correctness<BR/>and structural invariants with actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-003: <B>Capability</B><BR/>Model Update<BR/>&#160;<BR/>Ability to update Aurora models by creating, editing,<BR/>and deleting cards and links while preserving<BR/>invariants.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-004: <B>Capability</B><BR/>View Rendering<BR/>&#160;<BR/>Ability to render human-readable views and documentation<BR/>from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-005: <B>Capability</B><BR/>Model Compaction<BR/>&#160;<BR/>Ability to emit a compact, machine-friendly<BR/>representation of an Aurora model for agents and<BR/>interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-006: <B>Capability</B><BR/>Interactive Authoring<BR/>&#160;<BR/>Ability to author and modify Aurora models interactively<BR/>with guardrails, validation feedback, and consistent<BR/>persistence.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-007: <B>Capability</B><BR/>In-Editor Visualization<BR/>&#160;<BR/>Ability to visualize, navigate, and comprehend Aurora<BR/>models inside interactive tooling surfaces.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-008: <B>Capability</B><BR/>Workspace Integration<BR/>&#160;<BR/>Ability to integrate Aurora tooling with workspace file<BR/>systems, editors, and automation loops (open, watch,<BR/>save, refresh).</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-009: <B>Capability</B><BR/>Safe and Trusted Operation<BR/>&#160;<BR/>Ability to operate safely against untrusted workspace<BR/>content, including safe file operations, trust gating,<BR/>and sanitized rendering.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-001: <B>Constraint</B><BR/>Text Based Data Format<BR/>&#160;<BR/>In order to remain human readable and editable, the data<BR/>format must be text based.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-002: <B>Constraint</B> (Invariant)<BR/>Directed, Locally Cyclic Graph<BR/>&#160;<BR/>The model must form a Directed Graph in which all paths<BR/>start from a root card (&quot;Mission&quot;) and monotonically<BR/>increase in length until either encountering a card<BR/>already encountered or reaching a leaf card (one with no<BR/>outgoing links).</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-003: <B>Constraint</B><BR/>No Inherent Semantic Meaning<BR/>&#160;<BR/>The nodes and edges of the model must not carry any<BR/>semantic meaning; semantic meaning is imposed when<BR/>interpreted for some use, such as generating views.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-004: <B>Constraint</B><BR/>No Orphans<BR/>&#160;<BR/>All cards other than `Mission` must have at least one<BR/>incoming link.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-005" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-005: <B>Constraint</B> (Graphviz)<BR/>Graphviz DOT View Conventions<BR/>&#160;<BR/>Defines the canonical Graphviz DOT conventions<BR/>(graph/node/edge defaults and boundary cluster styling)<BR/>used when rendering Aurora views to DOT/SVG.</FONT></TD></TR></TABLE>>, shape="box"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-001: <B>Control</B><BR/>Workspace Trust Gate<BR/>&#160;<BR/>Gate potentially unsafe operations (e.g., file writes,<BR/>webview rendering, executing tools) behind workspace<BR/>trust checks and explicit user consent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-002: <B>Control</B><BR/>Safe Path Handling and Atomic Writes<BR/>&#160;<BR/>Constrain paths to the intended workspace/model roots,<BR/>normalize and validate paths, and use atomic write<BR/>patterns to prevent partial writes and clobbering.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-003: <B>Control</B><BR/>Content Sanitization<BR/>&#160;<BR/>Sanitize rendered Markdown and webview content, restrict<BR/>resource loading, and disable script execution to<BR/>prevent injection.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-004: <B>Control</B><BR/>Least Privilege File Access<BR/>&#160;<BR/>Minimize read/write permissions and scope operations to<BR/>explicit user-selected paths; avoid reading or writing<BR/>unrelated workspace files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"DRI-001" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-001: <B>Driver</B><BR/>Produce Common Architectural Artifacts<BR/>&#160;<BR/>Produce the drawings, designs, and other artifacts<BR/>commonly expected for software architecture.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-002" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-002: <B>Driver</B><BR/>Explain Entire Model in Simple Language<BR/>&#160;<BR/>The entire model is expressible by listing the nodes and<BR/>their relationships in simple sentences.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-003" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-003: <B>Driver</B><BR/>One Model to Rule Them All<BR/>&#160;<BR/>A single Aurora model captures every aspect of the<BR/>architecture in one cohesive model.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-004" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-004: <B>Driver</B><BR/>Human and Agent Friendly<BR/>&#160;<BR/>Express the model in a form that is easy to parse and<BR/>understand for both humans and machine agents.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-005" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-005: <B>Driver</B><BR/>Open and Unencumbered<BR/>&#160;<BR/>The data formats and other elements will be open and<BR/>uncumbered, allowing anyone to implement tooling against<BR/>AURORA.</FONT></TD></TR></TABLE>>, shape="box"];
	"MIS-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🎯</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>MIS-001: <B>Mission</B><BR/>Provide Default Tooling for AURORA<BR/>&#160;<BR/>Provide command line, GUI, and VSCode Extension tools<BR/>for the AURORA architectural system.</FONT></TD></TR></TABLE>>, shape="doubleoctagon"];
	"NOT-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗒️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOT-001: <B>Note</B><BR/>Shareable<BR/>&#160;<BR/>Tooling surfaces should prioritize shareable, portable<BR/>artifacts (e.g., rendered views and model packages)<BR/>without compromising workspace trust and path safety.</FONT></TD></TR></TABLE>>, shape="note"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-001: <B>Requirement</B><BR/>Boundary Cards<BR/>&#160;<BR/>There must exist a special card, `Boundary`, with the<BR/>optional property `recursive` (default true) which can<BR/>represent the containment of other elements without<BR/>altering the meaning or relationship of the model; in<BR/>other words a logical boundary.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-002" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-002: <B>Requirement</B><BR/>Note Cards<BR/>&#160;<BR/>There must be a special card called `Note` that allows<BR/>the capture of arbitrary text and annotates an existing<BR/>node in the model without modifying it or the model. The<BR/>`Note` card must have only one incoming link from the<BR/>card it modifies.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-003" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-003: <B>Requirement</B><BR/>Load Models<BR/>&#160;<BR/>Tools MUST be able to load one or more Aurora models<BR/>from disk for use in validation, editing, and rendering<BR/>workflows.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-004" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-004: <B>Requirement</B><BR/>Validate Models<BR/>&#160;<BR/>Tools MUST validate Aurora models against the Aurora<BR/>schema and structural invariants, and report actionable<BR/>diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-005" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-005: <B>Requirement</B><BR/>Update Models<BR/>&#160;<BR/>Tools MUST support updating Aurora models, including<BR/>creating, editing, and deleting cards and links while<BR/>preserving model invariants.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-006" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-006: <B>Requirement</B><BR/>Save Models<BR/>&#160;<BR/>Tools MUST persist Aurora models to disk in a stable,<BR/>text-based representation suitable for diffing and<BR/>review.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-007: <B>Requirement</B><BR/>Render Views<BR/>&#160;<BR/>Tools MUST generate human-readable views (e.g., Mermaid<BR/>diagrams and markdown) from an Aurora model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-008" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-008: <B>Requirement</B><BR/>Compact Models<BR/>&#160;<BR/>Tools MUST be able to emit a compact, machine-friendly<BR/>representation of an Aurora model for agent consumption<BR/>and interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-009: <B>Requirement</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Tools MUST enable users to browse and search the cards<BR/>and links in an Aurora model efficiently.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-010: <B>Requirement</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Tools MUST enable users to create, edit, and delete<BR/>cards and links with immediate feedback and without<BR/>corrupting the model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-011: <B>Requirement</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Tools MUST surface schema and invariant validation<BR/>diagnostics in a form users can act on (including<BR/>location and remediation hints where possible).</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-012: <B>Requirement</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Tools MUST provide a graph-based visualization of the<BR/>model and its relationships to support navigation and<BR/>comprehension.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-013: <B>Requirement</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Tools MUST allow users to preview and navigate the<BR/>human-readable Markdown renderings generated from an<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-014: <B>Requirement</B><BR/>Workspace Integration<BR/>&#160;<BR/>Tools MUST integrate with the user’s workspace to<BR/>open, watch, and save model files using predictable,<BR/>user-controlled behaviors.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-015: <B>Requirement</B><BR/>Safe File Operations<BR/>&#160;<BR/>Tools MUST perform file operations safely (prevent<BR/>unintended overwrites, constrain paths, and avoid<BR/>writing outside the user’s intended workspace<BR/>locations).</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-016: <B>Requirement</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Tools MUST respect workspace trust boundaries by<BR/>limiting potentially unsafe operations in untrusted<BR/>workspaces.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-017: <B>Requirement</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Tools MUST render Markdown and any webview content<BR/>safely by sanitizing untrusted content and preventing<BR/>script injection.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-018: <B>Requirement</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>Tools MUST present the ability to compress the entire<BR/>model into a single file (for example, a ZIP) for<BR/>transport between instances.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-019: <B>Requirement</B><BR/>Render Canonical View Set<BR/>&#160;<BR/>Tools MUST render every view defined in the canonical<BR/>view registry (see<BR/>.github/instructions/View_Definitions.md), producing a<BR/>deterministic set of view outputs for a given model.</FONT></TD></TR></TABLE>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-001: <B>Risk</B><BR/>Injected Content in Rendered Output<BR/>&#160;<BR/>Rendered output could contain unsafe content that<BR/>misleads users or executes in a webview context.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-002: <B>Risk</B><BR/>Unintended File Modification<BR/>&#160;<BR/>Tooling could overwrite or corrupt files outside the<BR/>intended model output locations.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-003: <B>Risk</B><BR/>Data Exposure from Untrusted Workspace<BR/>&#160;<BR/>Operating against untrusted workspace content could lead<BR/>to disclosure of sensitive data or unintended access<BR/>beyond user intent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"SYS-001" [fillcolor="#172554", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧱</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>SYS-001: <B>System</B><BR/>Default Tooling Platform<BR/>&#160;<BR/>A bounded system that delivers the default Aurora<BR/>tooling surfaces: CLI, Editor, and VSCode Extension.</FONT></TD></TR></TABLE>>, shape="folder"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-001: <B>Threat</B><BR/>Script Injection via Markdown<BR/>&#160;<BR/>Untrusted content in model descriptions or rendered<BR/>Markdown could inject script or unsafe resources into a<BR/>webview-based renderer.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-002: <B>Threat</B><BR/>Path Traversal or Arbitrary Write<BR/>&#160;<BR/>A crafted input path or unsafe write behavior could<BR/>cause tooling to write outside the intended<BR/>model/workspace directory, overwriting unrelated files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-003: <B>Threat</B><BR/>Untrusted Workspace Execution or Access<BR/>&#160;<BR/>Operating in an untrusted workspace could allow unsafe<BR/>operations that lead to data exposure or unintended<BR/>execution paths.</FONT></TD></TR></TABLE>>, shape="octagon"];
