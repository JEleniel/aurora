digraph "Context View (C4-Style / System Context)" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>🪟 Application</B><br />Command Line Tools<br /><br />A deployable command-line application that validates,<br />renders, and manages Aurora models. The CLI is optimized<br />for deterministic, automatable workflows (local<br />scripting and CI), and delegates model semantics<br />(parsing, invariants, rendering) to the shared library.</FONT>>, shape="component"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>🪟 Application</B><br />Editor<br /><br />A deployable application that provides an interactive<br />experience for creating, editing, and navigating Aurora<br />models. The Editor focuses on discoverability and safe,<br />incremental iteration with immediate validation<br />feedback.</FONT>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>🪟 Application</B><br />VSCode Extension<br /><br />A VS Code extension that enables authoring, validation,<br />and visualization of Aurora models within the editor. It<br />provides trust-aware workspace integration,<br />webview-based UI experiences, and (optionally) an MCP<br />server surface for other in-editor tooling.</FONT>>, shape="component"];
	"DEP-001" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<FONT><B>☁️ Deployment</B><br />Local Development<br /><br />A local development deployment where Aurora tooling is<br />built and run during development.</FONT>>, shape="box"];
	"DEP-002" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<FONT><B>☁️ Deployment</B><br />User Environment<br /><br />A user workstation environment where the Editor, CLI,<br />and VSCode extension execute against workspace content.</FONT>>, shape="box"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Local File System<br /><br />Local file system (workspace) used as the primary<br />persistence mechanism for Aurora model files and<br />generated outputs.</FONT>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Extension State Store<br /><br />VSCode extension storage for persisted settings and<br />non-source-of-truth state (cache, UI state, last-opened<br />model, etc.).</FONT>>, shape="cylinder"];
	"NOD-001" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<FONT><B>🖥️ Node</B><br />User Workstation<br /><br />A user workstation that hosts local CLI and desktop<br />tooling and provides workspace file system access.</FONT>>, shape="box"];
	"NOD-002" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<FONT><B>🖥️ Node</B><br />VSCode Extension Host<br /><br />VSCode extension host runtime where the extension<br />executes and performs workspace operations.</FONT>>, shape="box"];
	"NOD-003" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<FONT><B>🖥️ Node</B><br />Webview Sandbox<br /><br />Sandboxed webview runtime used for interactive UI<br />surfaces inside VSCode.</FONT>>, shape="box"];
	"NOD-004" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<FONT><B>🖥️ Node</B><br />Tauri Runtime<br /><br />Desktop runtime environment hosting the Tauri backend<br />used by the Editor.</FONT>>, shape="box"];
	"NOT-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<FONT><B>🗒️ Note</B><br />Shareable<br /><br />Tooling surfaces should prioritize shareable, portable<br />artifacts (e.g., rendered views and model packages)<br />without compromising workspace trust and path safety.</FONT>>, shape="note"];
	"SYS-001" [fillcolor="#172554", fontcolor="#FFFFFF", label=<<FONT><B>🧱 System</B><br />Default Tooling Platform<br /><br />A bounded system that delivers the default Aurora<br />tooling surfaces: CLI, Editor, and VSCode Extension.</FONT>>, shape="folder"];
	"APP-003" -> "NOT-001" [label="uses"];
	"DEP-001" -> "NOD-001" [label="includes"];
	"DEP-002" -> "NOD-001" [label="includes"];
	"DEP-002" -> "NOD-002" [label="includes"];
	"DEP-002" -> "NOD-003" [label="includes"];
	"DEP-002" -> "NOD-004" [label="includes"];
	"NOD-001" -> "APP-001" [label="hosts"];
	"NOD-001" -> "APP-002" [label="hosts"];
	"NOD-001" -> "DTS-001" [label="hosts"];
	"NOD-002" -> "DTS-002" [label="hosts"];
	"SYS-001" -> "APP-001" [label="integrates"];
	"SYS-001" -> "APP-002" [label="integrates"];
	"SYS-001" -> "APP-003" [label="integrates"];
	"SYS-001" -> "DEP-001" [label="participates_in"];
	"SYS-001" -> "DEP-002" [label="participates_in"];
}