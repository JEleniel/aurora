digraph "Abuse/Misuse Case View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-001: <B>Actor</B><BR/>Architect<BR/>&#160;<BR/>Person responsible for authoring and maintaining the<BR/>Aurora model for a system.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-002: <B>Actor</B><BR/>User<BR/>&#160;<BR/>Person using Aurora tooling surfaces to browse, edit,<BR/>validate, and render models in a workspace.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-003" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-003: <B>Actor</B><BR/>Malicious Workspace Author<BR/>&#160;<BR/>Adversarial actor who crafts workspace content to<BR/>exploit tooling behavior.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-001: <B>Control</B><BR/>Workspace Trust Gate<BR/>&#160;<BR/>Gate potentially unsafe operations (e.g., file writes,<BR/>webview rendering, executing tools) behind workspace<BR/>trust checks and explicit user consent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-002: <B>Control</B><BR/>Safe Path Handling and Atomic Writes<BR/>&#160;<BR/>Constrain paths to the intended workspace/model roots,<BR/>normalize and validate paths, and use atomic write<BR/>patterns to prevent partial writes and clobbering.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-003: <B>Control</B><BR/>Content Sanitization<BR/>&#160;<BR/>Sanitize rendered Markdown and webview content, restrict<BR/>resource loading, and disable script execution to<BR/>prevent injection.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-004: <B>Control</B><BR/>Least Privilege File Access<BR/>&#160;<BR/>Minimize read/write permissions and scope operations to<BR/>explicit user-selected paths; avoid reading or writing<BR/>unrelated workspace files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-005: <B>Feature</B><BR/>Render Views<BR/>&#160;<BR/>Generate human-readable Markdown and Mermaid view<BR/>documentation from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-013: <B>Feature</B><BR/>Safe File Operations<BR/>&#160;<BR/>Perform safe, constrained file operations with clear<BR/>user intent boundaries and reliable persistence<BR/>semantics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-014: <B>Feature</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Respect workspace trust boundaries by limiting<BR/>operations when the workspace is untrusted.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-015: <B>Feature</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Render Markdown and webview content safely, preventing<BR/>script injection and unsafe resource access.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-007: <B>Requirement</B><BR/>Render Views<BR/>&#160;<BR/>Tools MUST generate human-readable views (e.g., Mermaid<BR/>diagrams and markdown) from an Aurora model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-015: <B>Requirement</B><BR/>Safe File Operations<BR/>&#160;<BR/>Tools MUST perform file operations safely (prevent<BR/>unintended overwrites, constrain paths, and avoid<BR/>writing outside the user’s intended workspace<BR/>locations).</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-016: <B>Requirement</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Tools MUST respect workspace trust boundaries by<BR/>limiting potentially unsafe operations in untrusted<BR/>workspaces.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-017: <B>Requirement</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Tools MUST render Markdown and any webview content<BR/>safely by sanitizing untrusted content and preventing<BR/>script injection.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-018: <B>Requirement</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>Tools MUST present the ability to compress the entire<BR/>model into a single file (for example, a ZIP) for<BR/>transport between instances.</FONT></TD></TR></TABLE>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-001: <B>Risk</B><BR/>Injected Content in Rendered Output<BR/>&#160;<BR/>Rendered output could contain unsafe content that<BR/>misleads users or executes in a webview context.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-002: <B>Risk</B><BR/>Unintended File Modification<BR/>&#160;<BR/>Tooling could overwrite or corrupt files outside the<BR/>intended model output locations.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-003: <B>Risk</B><BR/>Data Exposure from Untrusted Workspace<BR/>&#160;<BR/>Operating against untrusted workspace content could lead<BR/>to disclosure of sensitive data or unintended access<BR/>beyond user intent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"STO-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STO-001: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably. This card is retained only as a legacy<BR/>tombstone for historical continuity; it used a<BR/>non-canonical prefix and has been superseded by<BR/>`STR-004` (and the active story `STR-003`).</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-001: <B>Story</B><BR/>Author and Share Aurora Model<BR/>&#160;<BR/>As an architect, I want to author, validate, render, and<BR/>share an Aurora model so that stakeholders and tools<BR/>have a consistent source of truth.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-002" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-002: <B>Story</B><BR/>Edit Aurora Model in Tools<BR/>&#160;<BR/>As a user, I want to browse, edit, validate, and preview<BR/>an Aurora model inside the tooling surfaces so that I<BR/>can iterate quickly and confidently.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-003" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-003: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-004" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-004: <B>Story</B> (Tombstone)<BR/>Store the Model in a Postable Format (Tombstone)<BR/>&#160;<BR/>Legacy tombstone story retained for traceability. This<BR/>supersedes the earlier `STO-001` story card, which used<BR/>a non-canonical prefix. `STO-001` is retained as<BR/>`Deleted` for historical continuity.</FONT></TD></TR></TABLE>>, shape="cds"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-001: <B>Threat</B><BR/>Script Injection via Markdown<BR/>&#160;<BR/>Untrusted content in model descriptions or rendered<BR/>Markdown could inject script or unsafe resources into a<BR/>webview-based renderer.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-002: <B>Threat</B><BR/>Path Traversal or Arbitrary Write<BR/>&#160;<BR/>A crafted input path or unsafe write behavior could<BR/>cause tooling to write outside the intended<BR/>model/workspace directory, overwriting unrelated files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-003: <B>Threat</B><BR/>Untrusted Workspace Execution or Access<BR/>&#160;<BR/>Operating in an untrusted workspace could allow unsafe<BR/>operations that lead to data exposure or unintended<BR/>execution paths.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"ACT-001" -> "STR-001" [label="desires"];
	"ACT-001" -> "STR-003" [label="desires"];
	"ACT-002" -> "STR-002" [label="desires"];
	"ACT-003" -> "THR-001" [label="presents"];
	"ACT-003" -> "THR-002" [label="presents"];
	"ACT-003" -> "THR-003" [label="presents"];
	"CTL-001" -> "RIS-003" [label="mitigates"];
	"CTL-001" -> "THR-003" [label="mitigates"];
	"CTL-002" -> "RIS-002" [label="mitigates"];
	"CTL-002" -> "THR-002" [label="mitigates"];
	"CTL-003" -> "RIS-001" [label="mitigates"];
	"CTL-003" -> "THR-001" [label="mitigates"];
	"CTL-004" -> "RIS-002" [label="mitigates"];
	"CTL-004" -> "RIS-003" [label="mitigates"];
	"FEA-005" -> "REQ-007" [label="satisfies"];
	"FEA-005" -> "REQ-018" [label="satisfies"];
	"FEA-013" -> "REQ-015" [label="satisfies"];
	"FEA-013" -> "RIS-002" [label="mitigates"];
	"FEA-013" -> "THR-002" [label="mitigates"];
	"FEA-014" -> "REQ-016" [label="satisfies"];
	"FEA-014" -> "RIS-003" [label="mitigates"];
	"FEA-014" -> "THR-003" [label="mitigates"];
	"FEA-015" -> "REQ-017" [label="satisfies"];
	"FEA-015" -> "RIS-001" [label="mitigates"];
	"FEA-015" -> "THR-001" [label="mitigates"];
	"STO-001" -> "REQ-018" [label="explains"];
	"STR-003" -> "REQ-018" [label="explains"];
	"STR-003" -> "STR-004" [label="includes"];
	"STR-004" -> "REQ-018" [label="explains"];
	"STR-004" -> "STO-001" [label="includes"];
	"THR-001" -> "RIS-001" [label="imposes"];
	"THR-002" -> "RIS-002" [label="imposes"];
	"THR-003" -> "RIS-003" [label="imposes"];
	subgraph "cluster_BND-001" {
		graph [color="#000000", label="Untrusted (BND-001)", style="dashed"];
		"ACT-003";
		"RIS-001";
		"RIS-002";
		"RIS-003";
		"THR-001";
		"THR-002";
		"THR-003";
	}
}