digraph "Policy and Standards Compliance View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"AST-001" [fillcolor="#334155", fontcolor="#FFFFFF", label="🛡️ Asset: Aurora Models\n(AST-001)", shape="box"];
	"AST-002" [fillcolor="#334155", fontcolor="#FFFFFF", label="🛡️ Asset: Rendered Documentation Output\n(AST-002)", shape="box"];
	"AST-003" [fillcolor="#334155", fontcolor="#FFFFFF", label="🛡️ Asset: User Workspace Content\n(AST-003)", shape="box"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label="📏 Constraint: Text Based Data Format\n(CNS-001)", shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label="📏 Constraint (Invariant): Directed, Locally Cyclic Graph\n(CNS-002)", shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label="📏 Constraint: No Inherent Semantic Meaning\n(CNS-003)", shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label="📏 Constraint: No Orphans\n(CNS-004)", shape="box"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label="🔒 Control: Workspace Trust Gate\n(CTL-001)", shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label="🔒 Control: Safe Path Handling and Atomic Writes\n(CTL-002)", shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label="🔒 Control: Content Sanitization\n(CTL-003)", shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label="🔒 Control: Least Privilege File Access\n(CTL-004)", shape="octagon"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label="⚠️ Risk: Injected Content in Rendered Output\n(RIS-001)", shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label="⚠️ Risk: Unintended File Modification\n(RIS-002)", shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label="⚠️ Risk: Data Exposure from Untrusted Workspace\n(RIS-003)", shape="octagon"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label="🐞 Threat: Script Injection via Markdown\n(THR-001)", shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label="🐞 Threat: Path Traversal or Arbitrary Write\n(THR-002)", shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label="🐞 Threat: Untrusted Workspace Execution or Access\n(THR-003)", shape="octagon"];
	"CNS-002" -> "CNS-004" [label="includes"];
	"CTL-001" -> "RIS-003" [label="mitigates"];
	"CTL-001" -> "THR-003" [label="mitigates"];
	"CTL-002" -> "RIS-002" [label="mitigates"];
	"CTL-002" -> "THR-002" [label="mitigates"];
	"CTL-003" -> "RIS-001" [label="mitigates"];
	"CTL-003" -> "THR-001" [label="mitigates"];
	"CTL-004" -> "RIS-002" [label="mitigates"];
	"CTL-004" -> "RIS-003" [label="mitigates"];
	"RIS-001" -> "AST-002" [label="impacts"];
	"RIS-001" -> "AST-003" [label="impacts"];
	"RIS-002" -> "AST-001" [label="impacts"];
	"RIS-002" -> "AST-003" [label="impacts"];
	"RIS-003" -> "AST-003" [label="impacts"];
	"THR-001" -> "RIS-001" [label="imposes"];
	"THR-002" -> "RIS-002" [label="imposes"];
	"THR-003" -> "RIS-003" [label="imposes"];
}