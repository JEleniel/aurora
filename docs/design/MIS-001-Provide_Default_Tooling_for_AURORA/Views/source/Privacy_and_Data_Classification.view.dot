digraph "Privacy and Data Classification View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"AST-001" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>🛡️ Asset</B><br />Aurora Models<br /><br />Aurora model source files (cards and schema references)<br />that represent the authoritative architecture model<br />content.</FONT>>, shape="box"];
	"AST-002" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>🛡️ Asset</B><br />Rendered Documentation Output<br /><br />Generated Markdown and view artifacts produced from<br />Aurora models (e.g., rendered card pages and view<br />markdown).</FONT>>, shape="box"];
	"AST-003" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<FONT><B>🛡️ Asset</B><br />User Workspace Content<br /><br />The user’s workspace files and settings (including<br />source code and secrets) that tooling must not corrupt<br />or exfiltrate.</FONT>>, shape="box"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>🔒 Control</B><br />Workspace Trust Gate<br /><br />Gate potentially unsafe operations (e.g., file writes,<br />webview rendering, executing tools) behind workspace<br />trust checks and explicit user consent.</FONT>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>🔒 Control</B><br />Safe Path Handling and Atomic Writes<br /><br />Constrain paths to the intended workspace/model roots,<br />normalize and validate paths, and use atomic write<br />patterns to prevent partial writes and clobbering.</FONT>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>🔒 Control</B><br />Content Sanitization<br /><br />Sanitize rendered Markdown and webview content, restrict<br />resource loading, and disable script execution to<br />prevent injection.</FONT>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>🔒 Control</B><br />Least Privilege File Access<br /><br />Minimize read/write permissions and scope operations to<br />explicit user-selected paths; avoid reading or writing<br />unrelated workspace files.</FONT>>, shape="octagon"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Local File System<br /><br />Local file system (workspace) used as the primary<br />persistence mechanism for Aurora model files and<br />generated outputs.</FONT>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>🗄️ Data Store</B><br />Extension State Store<br /><br />VSCode extension storage for persisted settings and<br />non-source-of-truth state (cache, UI state, last-opened<br />model, etc.).</FONT>>, shape="cylinder"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>⚠️ Risk</B><br />Injected Content in Rendered Output<br /><br />Rendered output could contain unsafe content that<br />misleads users or executes in a webview context.</FONT>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>⚠️ Risk</B><br />Unintended File Modification<br /><br />Tooling could overwrite or corrupt files outside the<br />intended model output locations.</FONT>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>⚠️ Risk</B><br />Data Exposure from Untrusted Workspace<br /><br />Operating against untrusted workspace content could lead<br />to disclosure of sensitive data or unintended access<br />beyond user intent.</FONT>>, shape="octagon"];
	"CTL-001" -> "RIS-003" [label="mitigates"];
	"CTL-002" -> "RIS-002" [label="mitigates"];
	"CTL-003" -> "RIS-001" [label="mitigates"];
	"CTL-004" -> "RIS-002" [label="mitigates"];
	"CTL-004" -> "RIS-003" [label="mitigates"];
	"RIS-001" -> "AST-002" [label="impacts"];
	"RIS-001" -> "AST-003" [label="impacts"];
	"RIS-002" -> "AST-001" [label="impacts"];
	"RIS-002" -> "AST-003" [label="impacts"];
	"RIS-003" -> "AST-003" [label="impacts"];
}