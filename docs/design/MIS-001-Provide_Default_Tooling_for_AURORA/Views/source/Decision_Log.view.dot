digraph "Decision Log View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>Constraint</B><br />Text Based Data Format<br /><br />In order to remain human readable and editable, the data<br />format must be text based.</FONT>>, shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>Constraint</B> (Invariant)<br />Directed, Locally Cyclic Graph<br /><br />The model must form a Directed Graph in which all paths<br />start from a root card (&quot;Mission&quot;) and monotonically<br />increase in length until either encountering a card<br />already encountered or reaching a leaf card (one with no<br />outgoing links).</FONT>>, shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>Constraint</B><br />No Inherent Semantic Meaning<br /><br />The nodes and edges of the model must not carry any<br />semantic meaning; semantic meaning is imposed when<br />interpreted for some use, such as generating views.</FONT>>, shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>Constraint</B><br />No Orphans<br /><br />All cards other than `Mission` must have at least one<br />incoming link.</FONT>>, shape="box"];
	"CNS-005" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>Constraint</B> (Graphviz)<br />Graphviz DOT View Conventions<br /><br />Defines the canonical Graphviz DOT conventions<br />(graph/node/edge defaults and boundary cluster styling)<br />used when rendering Aurora views to DOT/SVG.</FONT>>, shape="box"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Boundary Cards<br /><br />There must exist a special card, `Boundary`, with the<br />optional property `recursive` (default true) which can<br />represent the containment of other elements without<br />altering the meaning or relationship of the model; in<br />other words a logical boundary.</FONT>>, shape="box"];
	"REQ-002" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Note Cards<br /><br />There must be a special card called `Note` that allows<br />the capture of arbitrary text and annotates an existing<br />node in the model without modifying it or the model. The<br />`Note` card must have only one incoming link from the<br />card it modifies.</FONT>>, shape="box"];
	"REQ-003" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Load Models<br /><br />Tools MUST be able to load one or more Aurora models<br />from disk for use in validation, editing, and rendering<br />workflows.</FONT>>, shape="box"];
	"REQ-004" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Validate Models<br /><br />Tools MUST validate Aurora models against the Aurora<br />schema and structural invariants, and report actionable<br />diagnostics.</FONT>>, shape="box"];
	"REQ-005" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Update Models<br /><br />Tools MUST support updating Aurora models, including<br />creating, editing, and deleting cards and links while<br />preserving model invariants.</FONT>>, shape="box"];
	"REQ-006" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Save Models<br /><br />Tools MUST persist Aurora models to disk in a stable,<br />text-based representation suitable for diffing and<br />review.</FONT>>, shape="box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Render Views<br /><br />Tools MUST generate human-readable views (e.g., Mermaid<br />diagrams and markdown) from an Aurora model.</FONT>>, shape="box"];
	"REQ-008" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Compact Models<br /><br />Tools MUST be able to emit a compact, machine-friendly<br />representation of an Aurora model for agent consumption<br />and interchange.</FONT>>, shape="box"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Browse and Search Models<br /><br />Tools MUST enable users to browse and search the cards<br />and links in an Aurora model efficiently.</FONT>>, shape="box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Edit Models Interactively<br /><br />Tools MUST enable users to create, edit, and delete<br />cards and links with immediate feedback and without<br />corrupting the model.</FONT>>, shape="box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Show Validation Diagnostics<br /><br />Tools MUST surface schema and invariant validation<br />diagnostics in a form users can act on (including<br />location and remediation hints where possible).</FONT>>, shape="box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Visualize Model Graph<br /><br />Tools MUST provide a graph-based visualization of the<br />model and its relationships to support navigation and<br />comprehension.</FONT>>, shape="box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Preview Rendered Markdown<br /><br />Tools MUST allow users to preview and navigate the<br />human-readable Markdown renderings generated from an<br />Aurora model.</FONT>>, shape="box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Workspace Integration<br /><br />Tools MUST integrate with the user’s workspace to<br />open, watch, and save model files using predictable,<br />user-controlled behaviors.</FONT>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Safe File Operations<br /><br />Tools MUST perform file operations safely (prevent<br />unintended overwrites, constrain paths, and avoid<br />writing outside the user’s intended workspace<br />locations).</FONT>>, shape="box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Workspace Trust Gating<br /><br />Tools MUST respect workspace trust boundaries by<br />limiting potentially unsafe operations in untrusted<br />workspaces.</FONT>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Sanitized Rendering<br /><br />Tools MUST render Markdown and any webview content<br />safely by sanitizing untrusted content and preventing<br />script injection.</FONT>>, shape="box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Store the Model in a Postable Format<br /><br />Tools MUST present the ability to compress the entire<br />model into a single file (for example, a ZIP) for<br />transport between instances.</FONT>>, shape="box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>Requirement</B><br />Render Canonical View Set<br /><br />Tools MUST render every view defined in the canonical<br />view registry (see<br />.github/instructions/View_Definitions.md), producing a<br />deterministic set of view outputs for a given model.</FONT>>, shape="box"];
	"CNS-002" -> "CNS-004" [label="includes"];
}