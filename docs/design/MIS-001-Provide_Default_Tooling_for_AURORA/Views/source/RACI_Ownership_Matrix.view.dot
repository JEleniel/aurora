digraph "RACI / Ownership Matrix View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />Architect<br /><br />Person responsible for authoring and maintaining the<br />Aurora model for a system.</FONT>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />User<br /><br />Person using Aurora tooling surfaces to browse, edit,<br />validate, and render models in a workspace.</FONT>>, shape="ellipse"];
	"ACT-003" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />Malicious Workspace Author<br /><br />Adversarial actor who crafts workspace content to<br />exploit tooling behavior.</FONT>>, shape="ellipse"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>Application</B><br />Command Line Tools<br /><br />A deployable command-line application that validates,<br />renders, and manages Aurora models. The CLI is optimized<br />for deterministic, automatable workflows (local<br />scripting and CI), and delegates model semantics<br />(parsing, invariants, rendering) to the shared library.</FONT>>, shape="component"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>Application</B><br />Editor<br /><br />A deployable application that provides an interactive<br />experience for creating, editing, and navigating Aurora<br />models. The Editor focuses on discoverability and safe,<br />incremental iteration with immediate validation<br />feedback.</FONT>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<FONT><B>Application</B><br />VSCode Extension<br /><br />A VS Code extension that enables authoring, validation,<br />and visualization of Aurora models within the editor. It<br />provides trust-aware workspace integration,<br />webview-based UI experiences, and (optionally) an MCP<br />server surface for other in-editor tooling.</FONT>>, shape="component"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Model IO<br /><br />Ability to load and save Aurora models from and to disk<br />in stable formats.</FONT>>, shape="box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Model Validation<br /><br />Ability to validate Aurora models for schema correctness<br />and structural invariants with actionable diagnostics.</FONT>>, shape="box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Model Update<br /><br />Ability to update Aurora models by creating, editing,<br />and deleting cards and links while preserving<br />invariants.</FONT>>, shape="box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />View Rendering<br /><br />Ability to render human-readable views and documentation<br />from Aurora models.</FONT>>, shape="box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Model Compaction<br /><br />Ability to emit a compact, machine-friendly<br />representation of an Aurora model for agents and<br />interchange.</FONT>>, shape="box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Interactive Authoring<br /><br />Ability to author and modify Aurora models interactively<br />with guardrails, validation feedback, and consistent<br />persistence.</FONT>>, shape="box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />In-Editor Visualization<br /><br />Ability to visualize, navigate, and comprehend Aurora<br />models inside interactive tooling surfaces.</FONT>>, shape="box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Workspace Integration<br /><br />Ability to integrate Aurora tooling with workspace file<br />systems, editors, and automation loops (open, watch,<br />save, refresh).</FONT>>, shape="box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>Capability</B><br />Safe and Trusted Operation<br /><br />Ability to operate safely against untrusted workspace<br />content, including safe file operations, trust gating,<br />and sanitized rendering.</FONT>>, shape="box"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Shared Library<br /><br />Shared library component used across tooling surfaces to<br />load, validate, update, and save Aurora models. It is<br />the implementation home for common parsing, invariants,<br />deterministic rendering, and safe write semantics.</FONT>>, shape="box3d"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Tauri Svelte UI<br /><br />The Tauri/Svelte front-end UI component for the Editor<br />application.</FONT>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Tauri Rust Backend<br /><br />The Rust backend component for the Editor application,<br />hosting the native Tauri commands and integrations.</FONT>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Explorer Tree View<br /><br />Editor UI component that presents an explorer tree over<br />the Aurora model.</FONT>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Mind-Map Like View<br /><br />Editor UI component that provides a mind-map-like<br />visualization for navigating the Aurora model.</FONT>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Edit View<br /><br />Editor UI component for editing cards, attributes, and<br />links in an Aurora model.</FONT>>, shape="box3d"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Markdown View<br /><br />Editor UI component for viewing and editing<br />human-readable Markdown renderings of the Aurora model.</FONT>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />MCP Server<br /><br />Model Context Protocol (MCP) server component used by<br />the VSCode extension to expose Aurora model operations<br />via the shared library.</FONT>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B> (struct)<br />Aurora<br /><br />Core Aurora domain component providing the aggregate<br />root for working with a set of models.</FONT>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B> (struct)<br />Model<br /><br />Aurora model domain component representing a directed<br />graph of cards and links.</FONT>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B> (struct)<br />Card<br /><br />Aurora card domain component representing a single<br />architectural element with links and audit trail.</FONT>>, shape="box3d"];
	"COM-012" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Aurora CLI<br /><br />Command-line interface component that orchestrates<br />validation, view rendering, and compact export for<br />Aurora models.</FONT>>, shape="box3d"];
	"COM-013" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />VSCode Extension Host<br /><br />Extension host component responsible for activation,<br />command registration, workspace integration, and<br />coordinating model operations for the VSCode extension.</FONT>>, shape="box3d"];
	"COM-014" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Webview UI Host<br /><br />Webview UI component hosting interactive model browsing,<br />editing, visualization, and preview experiences within<br />VSCode.</FONT>>, shape="box3d"];
	"COM-015" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<FONT><B>Component</B><br />Workspace Adapter<br /><br />Component that mediates workspace file operations (open,<br />watch, and save) with safe defaults and trust-aware<br />behaviors.</FONT>>, shape="box3d"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Workspace Trust Gate<br /><br />Gate potentially unsafe operations (e.g., file writes,<br />webview rendering, executing tools) behind workspace<br />trust checks and explicit user consent.</FONT>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Safe Path Handling and Atomic Writes<br /><br />Constrain paths to the intended workspace/model roots,<br />normalize and validate paths, and use atomic write<br />patterns to prevent partial writes and clobbering.</FONT>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Content Sanitization<br /><br />Sanitize rendered Markdown and webview content, restrict<br />resource loading, and disable script execution to<br />prevent injection.</FONT>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Least Privilege File Access<br /><br />Minimize read/write permissions and scope operations to<br />explicit user-selected paths; avoid reading or writing<br />unrelated workspace files.</FONT>>, shape="octagon"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>Data Store</B><br />Local File System<br /><br />Local file system (workspace) used as the primary<br />persistence mechanism for Aurora model files and<br />generated outputs.</FONT>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<FONT><B>Data Store</B><br />Extension State Store<br /><br />VSCode extension storage for persisted settings and<br />non-source-of-truth state (cache, UI state, last-opened<br />model, etc.).</FONT>>, shape="cylinder"];
	"NOT-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<FONT><B>Note</B><br />Shareable<br /><br />Tooling surfaces should prioritize shareable, portable<br />artifacts (e.g., rendered views and model packages)<br />without compromising workspace trust and path safety.</FONT>>, shape="note"];
	"SYS-001" [fillcolor="#172554", fontcolor="#FFFFFF", label=<<FONT><B>System</B><br />Default Tooling Platform<br /><br />A bounded system that delivers the default Aurora<br />tooling surfaces: CLI, Editor, and VSCode Extension.</FONT>>, shape="folder"];
	"APP-001" -> "COM-001" [label="includes"];
	"APP-001" -> "COM-012" [label="includes"];
	"APP-002" -> "COM-001" [label="includes"];
	"APP-002" -> "COM-002" [label="includes"];
	"APP-002" -> "COM-003" [label="includes"];
	"APP-002" -> "COM-004" [label="includes"];
	"APP-002" -> "COM-005" [label="includes"];
