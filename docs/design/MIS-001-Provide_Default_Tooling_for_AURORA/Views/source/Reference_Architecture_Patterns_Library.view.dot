digraph "Reference Architecture / Patterns Library View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-001: <B>Artifact</B><BR/>Aurora Schema<BR/>&#160;<BR/>The Aurora JSON schema(s) that define valid card<BR/>structure and related invariants for validation tooling.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-002: <B>Artifact</B><BR/>Aurora Tooling<BR/>&#160;<BR/>Default tooling suite for Aurora, including CLI, editor,<BR/>and VS Code extension surfaces.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-003: <B>Artifact</B><BR/>Card Registry<BR/>&#160;<BR/>Canonical registries for card types, view definitions,<BR/>and relationship definitions used by the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-004: <B>Artifact</B><BR/>Markdown Documentation<BR/>&#160;<BR/>Human-readable Markdown documentation generated from the<BR/>model, including card pages and indexes.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-005: <B>Artifact</B><BR/>View Diagram Set<BR/>&#160;<BR/>A set of rendered view diagrams (e.g., Mermaid) produced<BR/>from an Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-006" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-006: <B>Artifact</B><BR/>Compact Model Format<BR/>&#160;<BR/>Compact, agent-friendly representation of the model<BR/>(e.g., AGENT-&lt;MISSION_ID&gt;.jsjson) used for interchange<BR/>and machine consumption.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-007" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-007: <B>Artifact</B><BR/>Validation Report<BR/>&#160;<BR/>Structured and/or human-readable validation report and<BR/>diagnostics output for a model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-008" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-008: <B>Artifact</B><BR/>Webview Rendered Markdown<BR/>&#160;<BR/>Rendered Markdown content displayed inside a sandboxed<BR/>webview (e.g., VS Code or Tauri webview).</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-009" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-009: <B>Artifact</B><BR/>Requirements.view.md<BR/>&#160;<BR/>Rendered Requirements View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-010" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-010: <B>Artifact</B><BR/>Component.view.md<BR/>&#160;<BR/>Rendered Component View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-011" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-011: <B>Artifact</B><BR/>Deployment.view.md<BR/>&#160;<BR/>Rendered Deployment View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-012" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-012: <B>Artifact</B><BR/>Process.view.md<BR/>&#160;<BR/>Rendered Process (Activity) View Markdown generated from<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-013" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-013: <B>Artifact</B><BR/>State_Machine.view.md<BR/>&#160;<BR/>Rendered State Machine View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-014" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-014: <B>Artifact</B><BR/>Threat_Model.view.md<BR/>&#160;<BR/>Rendered Threat Model View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-015" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-015: <B>Artifact</B><BR/>ACT-001.md<BR/>&#160;<BR/>Rendered Actor card page for ACT-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-016" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-016: <B>Artifact</B><BR/>AST-001.md<BR/>&#160;<BR/>Rendered Asset card page for AST-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-017" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-017: <B>Artifact</B><BR/>ATV-001.md<BR/>&#160;<BR/>Rendered Activity card page for ATV-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-018" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-018: <B>Artifact</B><BR/>CAP-001.md<BR/>&#160;<BR/>Rendered Capability card page for CAP-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-019" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-019: <B>Artifact</B><BR/>COM-001.md<BR/>&#160;<BR/>Rendered Component card page for COM-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-020" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-020: <B>Artifact</B><BR/>CNS-001.md<BR/>&#160;<BR/>Rendered Constraint card page for CNS-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-021" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-021: <B>Artifact</B><BR/>FEA-001.md<BR/>&#160;<BR/>Rendered Feature card page for FEA-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-022" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-022: <B>Artifact</B><BR/>PRO-001.md<BR/>&#160;<BR/>Rendered Process card page for PRO-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-023" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-023: <B>Artifact</B><BR/>REQ-001.md<BR/>&#160;<BR/>Rendered Requirement card page for REQ-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-001: <B>Capability</B><BR/>Model IO<BR/>&#160;<BR/>Ability to load and save Aurora models from and to disk<BR/>in stable formats.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-002: <B>Capability</B><BR/>Model Validation<BR/>&#160;<BR/>Ability to validate Aurora models for schema correctness<BR/>and structural invariants with actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-003: <B>Capability</B><BR/>Model Update<BR/>&#160;<BR/>Ability to update Aurora models by creating, editing,<BR/>and deleting cards and links while preserving<BR/>invariants.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-004: <B>Capability</B><BR/>View Rendering<BR/>&#160;<BR/>Ability to render human-readable views and documentation<BR/>from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-005: <B>Capability</B><BR/>Model Compaction<BR/>&#160;<BR/>Ability to emit a compact, machine-friendly<BR/>representation of an Aurora model for agents and<BR/>interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-006: <B>Capability</B><BR/>Interactive Authoring<BR/>&#160;<BR/>Ability to author and modify Aurora models interactively<BR/>with guardrails, validation feedback, and consistent<BR/>persistence.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-007: <B>Capability</B><BR/>In-Editor Visualization<BR/>&#160;<BR/>Ability to visualize, navigate, and comprehend Aurora<BR/>models inside interactive tooling surfaces.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-008: <B>Capability</B><BR/>Workspace Integration<BR/>&#160;<BR/>Ability to integrate Aurora tooling with workspace file<BR/>systems, editors, and automation loops (open, watch,<BR/>save, refresh).</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-009: <B>Capability</B><BR/>Safe and Trusted Operation<BR/>&#160;<BR/>Ability to operate safely against untrusted workspace<BR/>content, including safe file operations, trust gating,<BR/>and sanitized rendering.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-001: <B>Constraint</B><BR/>Text Based Data Format<BR/>&#160;<BR/>In order to remain human readable and editable, the data<BR/>format must be text based.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-002: <B>Constraint</B> (Invariant)<BR/>Directed, Locally Cyclic Graph<BR/>&#160;<BR/>The model must form a Directed Graph in which all paths<BR/>start from a root card (&quot;Mission&quot;) and monotonically<BR/>increase in length until either encountering a card<BR/>already encountered or reaching a leaf card (one with no<BR/>outgoing links).</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-003: <B>Constraint</B><BR/>No Inherent Semantic Meaning<BR/>&#160;<BR/>The nodes and edges of the model must not carry any<BR/>semantic meaning; semantic meaning is imposed when<BR/>interpreted for some use, such as generating views.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-004: <B>Constraint</B><BR/>No Orphans<BR/>&#160;<BR/>All cards other than `Mission` must have at least one<BR/>incoming link.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-005" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-005: <B>Constraint</B> (Graphviz)<BR/>Graphviz DOT View Conventions<BR/>&#160;<BR/>Defines the canonical Graphviz DOT conventions<BR/>(graph/node/edge defaults and boundary cluster styling)<BR/>used when rendering Aurora views to DOT/SVG.</FONT></TD></TR></TABLE>>, shape="box"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-001: <B>Component</B><BR/>Shared Library<BR/>&#160;<BR/>Shared library component used across tooling surfaces to<BR/>load, validate, update, and save Aurora models. It is<BR/>the implementation home for common parsing, invariants,<BR/>deterministic rendering, and safe write semantics.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-002: <B>Component</B><BR/>Tauri Svelte UI<BR/>&#160;<BR/>The Tauri/Svelte front-end UI component for the Editor<BR/>application.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-003: <B>Component</B><BR/>Tauri Rust Backend<BR/>&#160;<BR/>The Rust backend component for the Editor application,<BR/>hosting the native Tauri commands and integrations.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-004: <B>Component</B><BR/>Explorer Tree View<BR/>&#160;<BR/>Editor UI component that presents an explorer tree over<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-005: <B>Component</B><BR/>Mind-Map Like View<BR/>&#160;<BR/>Editor UI component that provides a mind-map-like<BR/>visualization for navigating the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-006: <B>Component</B><BR/>Edit View<BR/>&#160;<BR/>Editor UI component for editing cards, attributes, and<BR/>links in an Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-007: <B>Component</B><BR/>Markdown View<BR/>&#160;<BR/>Editor UI component for viewing and editing<BR/>human-readable Markdown renderings of the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-008: <B>Component</B><BR/>MCP Server<BR/>&#160;<BR/>Model Context Protocol (MCP) server component used by<BR/>the VSCode extension to expose Aurora model operations<BR/>via the shared library.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-009: <B>Component</B> (struct)<BR/>Aurora<BR/>&#160;<BR/>Core Aurora domain component providing the aggregate<BR/>root for working with a set of models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-010: <B>Component</B> (struct)<BR/>Model<BR/>&#160;<BR/>Aurora model domain component representing a directed<BR/>graph of cards and links.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-011: <B>Component</B> (struct)<BR/>Card<BR/>&#160;<BR/>Aurora card domain component representing a single<BR/>architectural element with links and audit trail.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-012" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-012: <B>Component</B><BR/>Aurora CLI<BR/>&#160;<BR/>Command-line interface component that orchestrates<BR/>validation, view rendering, and compact export for<BR/>Aurora models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-013" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-013: <B>Component</B><BR/>VSCode Extension Host<BR/>&#160;<BR/>Extension host component responsible for activation,<BR/>command registration, workspace integration, and<BR/>coordinating model operations for the VSCode extension.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-014" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-014: <B>Component</B><BR/>Webview UI Host<BR/>&#160;<BR/>Webview UI component hosting interactive model browsing,<BR/>editing, visualization, and preview experiences within<BR/>VSCode.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-015" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-015: <B>Component</B><BR/>Workspace Adapter<BR/>&#160;<BR/>Component that mediates workspace file operations (open,<BR/>watch, and save) with safe defaults and trust-aware<BR/>behaviors.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-001: <B>Feature</B><BR/>Load Models<BR/>&#160;<BR/>Load Aurora model cards from disk into memory,<BR/>preserving identifiers, links, and schema references.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-002" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-002: <B>Feature</B><BR/>Model Validation<BR/>&#160;<BR/>Validate Aurora models against schemas and invariants<BR/>and produce actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-003" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-003: <B>Feature</B><BR/>Update Models<BR/>&#160;<BR/>Create, edit, and delete Aurora cards and links with<BR/>invariant-preserving operations.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-004" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-004: <B>Feature</B><BR/>Save Models<BR/>&#160;<BR/>Persist Aurora model cards and links to disk in a<BR/>stable, reviewable format.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-005: <B>Feature</B><BR/>Render Views<BR/>&#160;<BR/>Generate human-readable Markdown and Mermaid view<BR/>documentation from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-006" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-006: <B>Feature</B><BR/>Model Compaction<BR/>&#160;<BR/>Emit a compact representation of an Aurora model<BR/>suitable for machine agents and interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-007" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-007: <B>Feature</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Browse, filter, and search cards and links in an Aurora<BR/>model with fast navigation primitives.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-008" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-008: <B>Feature</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Interactive editing UI and operations for creating and<BR/>updating cards and links with immediate feedback.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-009" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-009: <B>Feature</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Show schema and invariant validation diagnostics inline<BR/>and in structured panels.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-010" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-010: <B>Feature</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Provide an interactive graph visualization of the model<BR/>with zoom, pan, and focus-on-card navigation.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-011" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-011: <B>Feature</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Preview and navigate rendered Markdown documentation<BR/>from Aurora models inside tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-012" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-012: <B>Feature</B><BR/>Workspace Integration<BR/>&#160;<BR/>Integrate with the user workspace: open models, watch<BR/>for changes, and keep views in sync.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-013: <B>Feature</B><BR/>Safe File Operations<BR/>&#160;<BR/>Perform safe, constrained file operations with clear<BR/>user intent boundaries and reliable persistence<BR/>semantics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-014: <B>Feature</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Respect workspace trust boundaries by limiting<BR/>operations when the workspace is untrusted.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-015: <B>Feature</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Render Markdown and webview content safely, preventing<BR/>script injection and unsafe resource access.</FONT></TD></TR></TABLE>>, shape="box"];
	"INT-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-001: <B>Interface</B><BR/>CLI Interface<BR/>&#160;<BR/>Command-line interface surface exposing Aurora model<BR/>operations as subcommands (validate, render-all,<BR/>compact, etc.).</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-002" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-002: <B>Interface</B><BR/>MCP Interface<BR/>&#160;<BR/>Model Context Protocol interface surface exposing Aurora<BR/>operations to in-editor tooling via an MCP server.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-003" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-003: <B>Interface</B><BR/>Editor Backend API<BR/>&#160;<BR/>Native command interface between the Editor UI and the<BR/>Tauri Rust backend for model operations (load, validate,<BR/>update, render previews, save).</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-004" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-004: <B>Interface</B><BR/>VSCode Webview Messaging API<BR/>&#160;<BR/>Message-based interface between VSCode extension host<BR/>and webview UI for model navigation, editing, and<BR/>preview rendering.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-005" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-005: <B>Interface</B><BR/>VSCode Commands Interface<BR/>&#160;<BR/>VSCode command surface for invoking Aurora tooling<BR/>actions (validate, render, open views, export compact,<BR/>etc.) from the command palette and context menus.</FONT></TD></TR></TABLE>>, shape="note"];
