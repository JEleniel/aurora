digraph "Object View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Aurora Schema<br /><br />The Aurora JSON schema(s) that define valid card<br />structure and related invariants for validation tooling.</FONT>>, shape="tab"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Aurora Tooling<br /><br />Default tooling suite for Aurora, including CLI, editor,<br />and VS Code extension surfaces.</FONT>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Card Registry<br /><br />Canonical registries for card types, view definitions,<br />and relationship definitions used by the Aurora model.</FONT>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Markdown Documentation<br /><br />Human-readable Markdown documentation generated from the<br />model, including card pages and indexes.</FONT>>, shape="tab"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />View Diagram Set<br /><br />A set of rendered view diagrams (e.g., Mermaid) produced<br />from an Aurora model.</FONT>>, shape="tab"];
	"ART-006" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Compact Model Format<br /><br />Compact, agent-friendly representation of the model<br />(e.g., AGENT-&lt;MISSION_ID&gt;.jsjson) used for interchange<br />and machine consumption.</FONT>>, shape="tab"];
	"ART-007" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Validation Report<br /><br />Structured and/or human-readable validation report and<br />diagnostics output for a model.</FONT>>, shape="tab"];
	"ART-008" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Webview Rendered Markdown<br /><br />Rendered Markdown content displayed inside a sandboxed<br />webview (e.g., VS Code or Tauri webview).</FONT>>, shape="tab"];
	"ART-009" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Requirements.view.md<br /><br />Rendered Requirements View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-010" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Component.view.md<br /><br />Rendered Component View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-011" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Deployment.view.md<br /><br />Rendered Deployment View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-012" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Process.view.md<br /><br />Rendered Process (Activity) View Markdown generated from<br />the Aurora model.</FONT>>, shape="tab"];
	"ART-013" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />State_Machine.view.md<br /><br />Rendered State Machine View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-014" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />Threat_Model.view.md<br /><br />Rendered Threat Model View Markdown generated from the<br />Aurora model.</FONT>>, shape="tab"];
	"ART-015" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />ACT-001.md<br /><br />Rendered Actor card page for ACT-001.</FONT>>, shape="tab"];
	"ART-016" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />AST-001.md<br /><br />Rendered Asset card page for AST-001.</FONT>>, shape="tab"];
	"ART-017" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />ATV-001.md<br /><br />Rendered Activity card page for ATV-001.</FONT>>, shape="tab"];
	"ART-018" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />CAP-001.md<br /><br />Rendered Capability card page for CAP-001.</FONT>>, shape="tab"];
	"ART-019" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />COM-001.md<br /><br />Rendered Component card page for COM-001.</FONT>>, shape="tab"];
	"ART-020" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />CNS-001.md<br /><br />Rendered Constraint card page for CNS-001.</FONT>>, shape="tab"];
	"ART-021" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />FEA-001.md<br /><br />Rendered Feature card page for FEA-001.</FONT>>, shape="tab"];
	"ART-022" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />PRO-001.md<br /><br />Rendered Process card page for PRO-001.</FONT>>, shape="tab"];
	"ART-023" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<FONT><B>📁 Artifact</B><br />REQ-001.md<br /><br />Rendered Requirement card page for REQ-001.</FONT>>, shape="tab"];
}