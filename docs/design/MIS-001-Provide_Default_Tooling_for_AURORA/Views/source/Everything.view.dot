digraph "Everything View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-001: <B>Actor</B><BR/>Architect<BR/>&#160;<BR/>Person responsible for authoring and maintaining the<BR/>Aurora model for a system.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-002: <B>Actor</B><BR/>User<BR/>&#160;<BR/>Person using Aurora tooling surfaces to browse, edit,<BR/>validate, and render models in a workspace.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-003" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ACT-003: <B>Actor</B><BR/>Malicious Workspace Author<BR/>&#160;<BR/>Adversarial actor who crafts workspace content to<BR/>exploit tooling behavior.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-001: <B>Application</B><BR/>Command Line Tools<BR/>&#160;<BR/>A deployable command-line application that validates,<BR/>renders, and manages Aurora models. The CLI is optimized<BR/>for deterministic, automatable workflows (local<BR/>scripting and CI), and delegates model semantics<BR/>(parsing, invariants, rendering) to the shared library.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-002: <B>Application</B><BR/>Editor<BR/>&#160;<BR/>A deployable application that provides an interactive<BR/>experience for creating, editing, and navigating Aurora<BR/>models. The Editor focuses on discoverability and safe,<BR/>incremental iteration with immediate validation<BR/>feedback.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>APP-003: <B>Application</B><BR/>VSCode Extension<BR/>&#160;<BR/>A VS Code extension that enables authoring, validation,<BR/>and visualization of Aurora models within the editor. It<BR/>provides trust-aware workspace integration,<BR/>webview-based UI experiences, and (optionally) an MCP<BR/>server surface for other in-editor tooling.</FONT></TD></TR></TABLE>>, shape="component"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-001: <B>Artifact</B><BR/>Aurora Schema<BR/>&#160;<BR/>The Aurora JSON schema(s) that define valid card<BR/>structure and related invariants for validation tooling.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-002: <B>Artifact</B><BR/>Aurora Tooling<BR/>&#160;<BR/>Default tooling suite for Aurora, including CLI, editor,<BR/>and VS Code extension surfaces.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-003: <B>Artifact</B><BR/>Card Registry<BR/>&#160;<BR/>Canonical registries for card types, view definitions,<BR/>and relationship definitions used by the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-004: <B>Artifact</B><BR/>Markdown Documentation<BR/>&#160;<BR/>Human-readable Markdown documentation generated from the<BR/>model, including card pages and indexes.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-005: <B>Artifact</B><BR/>View Diagram Set<BR/>&#160;<BR/>A set of rendered view diagrams (e.g., Mermaid) produced<BR/>from an Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-006" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-006: <B>Artifact</B><BR/>Compact Model Format<BR/>&#160;<BR/>Compact, agent-friendly representation of the model<BR/>(e.g., AGENT-&lt;MISSION_ID&gt;.jsjson) used for interchange<BR/>and machine consumption.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-007" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-007: <B>Artifact</B><BR/>Validation Report<BR/>&#160;<BR/>Structured and/or human-readable validation report and<BR/>diagnostics output for a model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-008" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-008: <B>Artifact</B><BR/>Webview Rendered Markdown<BR/>&#160;<BR/>Rendered Markdown content displayed inside a sandboxed<BR/>webview (e.g., VS Code or Tauri webview).</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-009" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-009: <B>Artifact</B><BR/>Requirements.view.md<BR/>&#160;<BR/>Rendered Requirements View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-010" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-010: <B>Artifact</B><BR/>Component.view.md<BR/>&#160;<BR/>Rendered Component View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-011" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-011: <B>Artifact</B><BR/>Deployment.view.md<BR/>&#160;<BR/>Rendered Deployment View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-012" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-012: <B>Artifact</B><BR/>Process.view.md<BR/>&#160;<BR/>Rendered Process (Activity) View Markdown generated from<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-013" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-013: <B>Artifact</B><BR/>State_Machine.view.md<BR/>&#160;<BR/>Rendered State Machine View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-014" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-014: <B>Artifact</B><BR/>Threat_Model.view.md<BR/>&#160;<BR/>Rendered Threat Model View Markdown generated from the<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-015" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-015: <B>Artifact</B><BR/>ACT-001.md<BR/>&#160;<BR/>Rendered Actor card page for ACT-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-016" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-016: <B>Artifact</B><BR/>AST-001.md<BR/>&#160;<BR/>Rendered Asset card page for AST-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-017" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-017: <B>Artifact</B><BR/>ATV-001.md<BR/>&#160;<BR/>Rendered Activity card page for ATV-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-018" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-018: <B>Artifact</B><BR/>CAP-001.md<BR/>&#160;<BR/>Rendered Capability card page for CAP-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-019" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-019: <B>Artifact</B><BR/>COM-001.md<BR/>&#160;<BR/>Rendered Component card page for COM-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-020" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-020: <B>Artifact</B><BR/>CNS-001.md<BR/>&#160;<BR/>Rendered Constraint card page for CNS-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-021" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-021: <B>Artifact</B><BR/>FEA-001.md<BR/>&#160;<BR/>Rendered Feature card page for FEA-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-022" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-022: <B>Artifact</B><BR/>PRO-001.md<BR/>&#160;<BR/>Rendered Process card page for PRO-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-023" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ART-023: <B>Artifact</B><BR/>REQ-001.md<BR/>&#160;<BR/>Rendered Requirement card page for REQ-001.</FONT></TD></TR></TABLE>>, shape="tab"];
	"AST-001" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🛡️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>AST-001: <B>Asset</B><BR/>Aurora Models<BR/>&#160;<BR/>Aurora model source files (cards and schema references)<BR/>that represent the authoritative architecture model<BR/>content.</FONT></TD></TR></TABLE>>, shape="box"];
	"AST-002" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🛡️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>AST-002: <B>Asset</B><BR/>Rendered Documentation Output<BR/>&#160;<BR/>Generated Markdown and view artifacts produced from<BR/>Aurora models (e.g., rendered card pages and view<BR/>markdown).</FONT></TD></TR></TABLE>>, shape="box"];
	"AST-003" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🛡️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>AST-003: <B>Asset</B><BR/>User Workspace Content<BR/>&#160;<BR/>The user’s workspace files and settings (including<BR/>source code and secrets) that tooling must not corrupt<BR/>or exfiltrate.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-001" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-001: <B>Activity</B><BR/>Load Model<BR/>&#160;<BR/>Load a model from disk into memory.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-002" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-002: <B>Activity</B><BR/>Validate Model<BR/>&#160;<BR/>Validate a model and review diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-003" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-003: <B>Activity</B><BR/>Render Views<BR/>&#160;<BR/>Generate rendered views and Markdown documentation from<BR/>the model.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-004" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-004: <B>Activity</B><BR/>Compact Model<BR/>&#160;<BR/>Export a compact representation for machine agents.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-005" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-005: <B>Activity</B><BR/>Open Model in Tool<BR/>&#160;<BR/>Open an Aurora model in an interactive tooling surface.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-006" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-006: <B>Activity</B><BR/>Navigate Model<BR/>&#160;<BR/>Navigate the model by browsing, searching, and exploring<BR/>relationships.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-007" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-007: <B>Activity</B><BR/>Edit Cards and Links<BR/>&#160;<BR/>Create and update cards and links in the model.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-008" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-008: <B>Activity</B><BR/>Review Validation Diagnostics<BR/>&#160;<BR/>Review validation results, navigate to affected cards,<BR/>and apply fixes.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-009" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-009: <B>Activity</B><BR/>Preview Output<BR/>&#160;<BR/>Preview rendered views and Markdown representations of<BR/>the model.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-010" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">👣</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>ATV-010: <B>Activity</B><BR/>Save Model Safely<BR/>&#160;<BR/>Save the model with safe file operations and optional<BR/>export formats.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-001: <B>Capability</B><BR/>Model IO<BR/>&#160;<BR/>Ability to load and save Aurora models from and to disk<BR/>in stable formats.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-002: <B>Capability</B><BR/>Model Validation<BR/>&#160;<BR/>Ability to validate Aurora models for schema correctness<BR/>and structural invariants with actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-003: <B>Capability</B><BR/>Model Update<BR/>&#160;<BR/>Ability to update Aurora models by creating, editing,<BR/>and deleting cards and links while preserving<BR/>invariants.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-004: <B>Capability</B><BR/>View Rendering<BR/>&#160;<BR/>Ability to render human-readable views and documentation<BR/>from Aurora models.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-005: <B>Capability</B><BR/>Model Compaction<BR/>&#160;<BR/>Ability to emit a compact, machine-friendly<BR/>representation of an Aurora model for agents and<BR/>interchange.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-006: <B>Capability</B><BR/>Interactive Authoring<BR/>&#160;<BR/>Ability to author and modify Aurora models interactively<BR/>with guardrails, validation feedback, and consistent<BR/>persistence.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-007: <B>Capability</B><BR/>In-Editor Visualization<BR/>&#160;<BR/>Ability to visualize, navigate, and comprehend Aurora<BR/>models inside interactive tooling surfaces.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-008: <B>Capability</B><BR/>Workspace Integration<BR/>&#160;<BR/>Ability to integrate Aurora tooling with workspace file<BR/>systems, editors, and automation loops (open, watch,<BR/>save, refresh).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-009: <B>Capability</B><BR/>Safe and Trusted Operation<BR/>&#160;<BR/>Ability to operate safely against untrusted workspace<BR/>content, including safe file operations, trust gating,<BR/>and sanitized rendering.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-001: <B>Constraint</B><BR/>Text Based Data Format<BR/>&#160;<BR/>In order to remain human readable and editable, the data<BR/>format must be text based.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-002: <B>Constraint</B> (Invariant)<BR/>Directed, Locally Cyclic Graph<BR/>&#160;<BR/>The model must form a Directed Graph in which all paths<BR/>start from a root card (&quot;Mission&quot;) and monotonically<BR/>increase in length until either encountering a card<BR/>already encountered or reaching a leaf card (one with no<BR/>outgoing links).</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-003: <B>Constraint</B><BR/>No Inherent Semantic Meaning<BR/>&#160;<BR/>The nodes and edges of the model must not carry any<BR/>semantic meaning; semantic meaning is imposed when<BR/>interpreted for some use, such as generating views.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-004: <B>Constraint</B><BR/>No Orphans<BR/>&#160;<BR/>All cards other than `Mission` must have at least one<BR/>incoming link.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-005" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CNS-005: <B>Constraint</B> (Graphviz)<BR/>Graphviz DOT View Conventions<BR/>&#160;<BR/>Defines the canonical Graphviz DOT conventions<BR/>(graph/node/edge defaults and boundary cluster styling)<BR/>used when rendering Aurora views to DOT/SVG.</FONT></TD></TR></TABLE>>, shape="box"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-001: <B>Component</B><BR/>Shared Library<BR/>&#160;<BR/>Shared library component used across tooling surfaces to<BR/>load, validate, update, and save Aurora models. It is<BR/>the implementation home for common parsing, invariants,<BR/>deterministic rendering, and safe write semantics.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-002: <B>Component</B><BR/>Tauri Svelte UI<BR/>&#160;<BR/>The Tauri/Svelte front-end UI component for the Editor<BR/>application.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-003: <B>Component</B><BR/>Tauri Rust Backend<BR/>&#160;<BR/>The Rust backend component for the Editor application,<BR/>hosting the native Tauri commands and integrations.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-004: <B>Component</B><BR/>Explorer Tree View<BR/>&#160;<BR/>Editor UI component that presents an explorer tree over<BR/>the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-005: <B>Component</B><BR/>Mind-Map Like View<BR/>&#160;<BR/>Editor UI component that provides a mind-map-like<BR/>visualization for navigating the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-006: <B>Component</B><BR/>Edit View<BR/>&#160;<BR/>Editor UI component for editing cards, attributes, and<BR/>links in an Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-007: <B>Component</B><BR/>Markdown View<BR/>&#160;<BR/>Editor UI component for viewing and editing<BR/>human-readable Markdown renderings of the Aurora model.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-008: <B>Component</B><BR/>MCP Server<BR/>&#160;<BR/>Model Context Protocol (MCP) server component used by<BR/>the VSCode extension to expose Aurora model operations<BR/>via the shared library.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-009: <B>Component</B> (struct)<BR/>Aurora<BR/>&#160;<BR/>Core Aurora domain component providing the aggregate<BR/>root for working with a set of models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-010: <B>Component</B> (struct)<BR/>Model<BR/>&#160;<BR/>Aurora model domain component representing a directed<BR/>graph of cards and links.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-011: <B>Component</B> (struct)<BR/>Card<BR/>&#160;<BR/>Aurora card domain component representing a single<BR/>architectural element with links and audit trail.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-012" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-012: <B>Component</B><BR/>Aurora CLI<BR/>&#160;<BR/>Command-line interface component that orchestrates<BR/>validation, view rendering, and compact export for<BR/>Aurora models.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-013" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-013: <B>Component</B><BR/>VSCode Extension Host<BR/>&#160;<BR/>Extension host component responsible for activation,<BR/>command registration, workspace integration, and<BR/>coordinating model operations for the VSCode extension.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-014" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-014: <B>Component</B><BR/>Webview UI Host<BR/>&#160;<BR/>Webview UI component hosting interactive model browsing,<BR/>editing, visualization, and preview experiences within<BR/>VSCode.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-015" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>COM-015: <B>Component</B><BR/>Workspace Adapter<BR/>&#160;<BR/>Component that mediates workspace file operations (open,<BR/>watch, and save) with safe defaults and trust-aware<BR/>behaviors.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-001: <B>Control</B><BR/>Workspace Trust Gate<BR/>&#160;<BR/>Gate potentially unsafe operations (e.g., file writes,<BR/>webview rendering, executing tools) behind workspace<BR/>trust checks and explicit user consent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-002: <B>Control</B><BR/>Safe Path Handling and Atomic Writes<BR/>&#160;<BR/>Constrain paths to the intended workspace/model roots,<BR/>normalize and validate paths, and use atomic write<BR/>patterns to prevent partial writes and clobbering.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-003: <B>Control</B><BR/>Content Sanitization<BR/>&#160;<BR/>Sanitize rendered Markdown and webview content, restrict<BR/>resource loading, and disable script execution to<BR/>prevent injection.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CTL-004: <B>Control</B><BR/>Least Privilege File Access<BR/>&#160;<BR/>Minimize read/write permissions and scope operations to<BR/>explicit user-selected paths; avoid reading or writing<BR/>unrelated workspace files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"DEP-001" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☁️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DEP-001: <B>Deployment</B><BR/>Local Development<BR/>&#160;<BR/>A local development deployment where Aurora tooling is<BR/>built and run during development.</FONT></TD></TR></TABLE>>, shape="box"];
	"DEP-002" [fillcolor="#1e1b4b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☁️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DEP-002: <B>Deployment</B><BR/>User Environment<BR/>&#160;<BR/>A user workstation environment where the Editor, CLI,<BR/>and VSCode extension execute against workspace content.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-001" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-001: <B>Driver</B><BR/>Produce Common Architectural Artifacts<BR/>&#160;<BR/>Produce the drawings, designs, and other artifacts<BR/>commonly expected for software architecture.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-002" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-002: <B>Driver</B><BR/>Explain Entire Model in Simple Language<BR/>&#160;<BR/>The entire model is expressible by listing the nodes and<BR/>their relationships in simple sentences.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-003" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-003: <B>Driver</B><BR/>One Model to Rule Them All<BR/>&#160;<BR/>A single Aurora model captures every aspect of the<BR/>architecture in one cohesive model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-004" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-004: <B>Driver</B><BR/>Human and Agent Friendly<BR/>&#160;<BR/>Express the model in a form that is easy to parse and<BR/>understand for both humans and machine agents.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-005" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-005: <B>Driver</B><BR/>Open and Unencumbered<BR/>&#160;<BR/>The data formats and other elements will be open and<BR/>uncumbered, allowing anyone to implement tooling against<BR/>AURORA.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DTS-001: <B>Data Store</B><BR/>Local File System<BR/>&#160;<BR/>Local file system (workspace) used as the primary<BR/>persistence mechanism for Aurora model files and<BR/>generated outputs.</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DTS-002: <B>Data Store</B><BR/>Extension State Store<BR/>&#160;<BR/>VSCode extension storage for persisted settings and<BR/>non-source-of-truth state (cache, UI state, last-opened<BR/>model, etc.).</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-001: <B>Feature</B><BR/>Load Models<BR/>&#160;<BR/>Load Aurora model cards from disk into memory,<BR/>preserving identifiers, links, and schema references.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-002" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-002: <B>Feature</B><BR/>Model Validation<BR/>&#160;<BR/>Validate Aurora models against schemas and invariants<BR/>and produce actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-003" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-003: <B>Feature</B><BR/>Update Models<BR/>&#160;<BR/>Create, edit, and delete Aurora cards and links with<BR/>invariant-preserving operations.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-004" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-004: <B>Feature</B><BR/>Save Models<BR/>&#160;<BR/>Persist Aurora model cards and links to disk in a<BR/>stable, reviewable format.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-005: <B>Feature</B><BR/>Render Views<BR/>&#160;<BR/>Generate human-readable Markdown and Mermaid view<BR/>documentation from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-006" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-006: <B>Feature</B><BR/>Model Compaction<BR/>&#160;<BR/>Emit a compact representation of an Aurora model<BR/>suitable for machine agents and interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-007" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-007: <B>Feature</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Browse, filter, and search cards and links in an Aurora<BR/>model with fast navigation primitives.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-008" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-008: <B>Feature</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Interactive editing UI and operations for creating and<BR/>updating cards and links with immediate feedback.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-009" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-009: <B>Feature</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Show schema and invariant validation diagnostics inline<BR/>and in structured panels.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-010" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-010: <B>Feature</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Provide an interactive graph visualization of the model<BR/>with zoom, pan, and focus-on-card navigation.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-011" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-011: <B>Feature</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Preview and navigate rendered Markdown documentation<BR/>from Aurora models inside tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-012" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-012: <B>Feature</B><BR/>Workspace Integration<BR/>&#160;<BR/>Integrate with the user workspace: open models, watch<BR/>for changes, and keep views in sync.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-013: <B>Feature</B><BR/>Safe File Operations<BR/>&#160;<BR/>Perform safe, constrained file operations with clear<BR/>user intent boundaries and reliable persistence<BR/>semantics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-014: <B>Feature</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Respect workspace trust boundaries by limiting<BR/>operations when the workspace is untrusted.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-015: <B>Feature</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Render Markdown and webview content safely, preventing<BR/>script injection and unsafe resource access.</FONT></TD></TR></TABLE>>, shape="box"];
	"INT-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-001: <B>Interface</B><BR/>CLI Interface<BR/>&#160;<BR/>Command-line interface surface exposing Aurora model<BR/>operations as subcommands (validate, render-all,<BR/>compact, etc.).</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-002" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-002: <B>Interface</B><BR/>MCP Interface<BR/>&#160;<BR/>Model Context Protocol interface surface exposing Aurora<BR/>operations to in-editor tooling via an MCP server.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-003" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-003: <B>Interface</B><BR/>Editor Backend API<BR/>&#160;<BR/>Native command interface between the Editor UI and the<BR/>Tauri Rust backend for model operations (load, validate,<BR/>update, render previews, save).</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-004" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-004: <B>Interface</B><BR/>VSCode Webview Messaging API<BR/>&#160;<BR/>Message-based interface between VSCode extension host<BR/>and webview UI for model navigation, editing, and<BR/>preview rendering.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-005" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>INT-005: <B>Interface</B><BR/>VSCode Commands Interface<BR/>&#160;<BR/>VSCode command surface for invoking Aurora tooling<BR/>actions (validate, render, open views, export compact,<BR/>etc.) from the command palette and context menus.</FONT></TD></TR></TABLE>>, shape="note"];
	"MIS-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🎯</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>MIS-001: <B>Mission</B><BR/>Provide Default Tooling for AURORA<BR/>&#160;<BR/>Provide command line, GUI, and VSCode Extension tools<BR/>for the AURORA architectural system.</FONT></TD></TR></TABLE>>, shape="double-octagon"];
	"NOD-001" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-001: <B>Node</B><BR/>User Workstation<BR/>&#160;<BR/>A user workstation that hosts local CLI and desktop<BR/>tooling and provides workspace file system access.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-002" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-002: <B>Node</B><BR/>VSCode Extension Host<BR/>&#160;<BR/>VSCode extension host runtime where the extension<BR/>executes and performs workspace operations.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-003" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-003: <B>Node</B><BR/>Webview Sandbox<BR/>&#160;<BR/>Sandboxed webview runtime used for interactive UI<BR/>surfaces inside VSCode.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOD-004" [fillcolor="#312e81", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🖥️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOD-004: <B>Node</B><BR/>Tauri Runtime<BR/>&#160;<BR/>Desktop runtime environment hosting the Tauri backend<BR/>used by the Editor.</FONT></TD></TR></TABLE>>, shape="box"];
	"NOT-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🗒️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>NOT-001: <B>Note</B><BR/>Shareable<BR/>&#160;<BR/>Tooling surfaces should prioritize shareable, portable<BR/>artifacts (e.g., rendered views and model packages)<BR/>without compromising workspace trust and path safety.</FONT></TD></TR></TABLE>>, shape="note"];
	"PRO-001" [fillcolor="#2e1065", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>PRO-001: <B>Process</B><BR/>Model Authoring Workflow<BR/>&#160;<BR/>A repeatable workflow for authoring, validating,<BR/>rendering, and exporting an Aurora model.</FONT></TD></TR></TABLE>>, shape="box"];
	"PRO-002" [fillcolor="#2e1065", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🔁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>PRO-002: <B>Process</B><BR/>In-Tool Model Editing Workflow<BR/>&#160;<BR/>A repeatable workflow for interactively opening,<BR/>navigating, editing, validating, previewing, and saving<BR/>an Aurora model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-001: <B>Requirement</B><BR/>Boundary Cards<BR/>&#160;<BR/>There must exist a special card, `Boundary`, with the<BR/>optional property `recursive` (default true) which can<BR/>represent the containment of other elements without<BR/>altering the meaning or relationship of the model; in<BR/>other words a logical boundary.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-002" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-002: <B>Requirement</B><BR/>Note Cards<BR/>&#160;<BR/>There must be a special card called `Note` that allows<BR/>the capture of arbitrary text and annotates an existing<BR/>node in the model without modifying it or the model. The<BR/>`Note` card must have only one incoming link from the<BR/>card it modifies.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-003" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-003: <B>Requirement</B><BR/>Load Models<BR/>&#160;<BR/>Tools MUST be able to load one or more Aurora models<BR/>from disk for use in validation, editing, and rendering<BR/>workflows.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-004" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-004: <B>Requirement</B><BR/>Validate Models<BR/>&#160;<BR/>Tools MUST validate Aurora models against the Aurora<BR/>schema and structural invariants, and report actionable<BR/>diagnostics.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-005" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-005: <B>Requirement</B><BR/>Update Models<BR/>&#160;<BR/>Tools MUST support updating Aurora models, including<BR/>creating, editing, and deleting cards and links while<BR/>preserving model invariants.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-006" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-006: <B>Requirement</B><BR/>Save Models<BR/>&#160;<BR/>Tools MUST persist Aurora models to disk in a stable,<BR/>text-based representation suitable for diffing and<BR/>review.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-007: <B>Requirement</B><BR/>Render Views<BR/>&#160;<BR/>Tools MUST generate human-readable views (e.g., Mermaid<BR/>diagrams and markdown) from an Aurora model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-008" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-008: <B>Requirement</B><BR/>Compact Models<BR/>&#160;<BR/>Tools MUST be able to emit a compact, machine-friendly<BR/>representation of an Aurora model for agent consumption<BR/>and interchange.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-009: <B>Requirement</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Tools MUST enable users to browse and search the cards<BR/>and links in an Aurora model efficiently.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-010: <B>Requirement</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Tools MUST enable users to create, edit, and delete<BR/>cards and links with immediate feedback and without<BR/>corrupting the model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-011: <B>Requirement</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Tools MUST surface schema and invariant validation<BR/>diagnostics in a form users can act on (including<BR/>location and remediation hints where possible).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-012: <B>Requirement</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Tools MUST provide a graph-based visualization of the<BR/>model and its relationships to support navigation and<BR/>comprehension.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-013: <B>Requirement</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Tools MUST allow users to preview and navigate the<BR/>human-readable Markdown renderings generated from an<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-014: <B>Requirement</B><BR/>Workspace Integration<BR/>&#160;<BR/>Tools MUST integrate with the user’s workspace to<BR/>open, watch, and save model files using predictable,<BR/>user-controlled behaviors.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-015: <B>Requirement</B><BR/>Safe File Operations<BR/>&#160;<BR/>Tools MUST perform file operations safely (prevent<BR/>unintended overwrites, constrain paths, and avoid<BR/>writing outside the user’s intended workspace<BR/>locations).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-016: <B>Requirement</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Tools MUST respect workspace trust boundaries by<BR/>limiting potentially unsafe operations in untrusted<BR/>workspaces.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-017: <B>Requirement</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Tools MUST render Markdown and any webview content<BR/>safely by sanitizing untrusted content and preventing<BR/>script injection.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-018: <B>Requirement</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>Tools MUST present the ability to compress the entire<BR/>model into a single file (for example, a ZIP) for<BR/>transport between instances.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-019: <B>Requirement</B><BR/>Render Canonical View Set<BR/>&#160;<BR/>Tools MUST render every view defined in the canonical<BR/>view registry (see<BR/>.github/instructions/View_Definitions.md), producing a<BR/>deterministic set of view outputs for a given model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-001: <B>Risk</B><BR/>Injected Content in Rendered Output<BR/>&#160;<BR/>Rendered output could contain unsafe content that<BR/>misleads users or executes in a webview context.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-002: <B>Risk</B><BR/>Unintended File Modification<BR/>&#160;<BR/>Tooling could overwrite or corrupt files outside the<BR/>intended model output locations.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>RIS-003: <B>Risk</B><BR/>Data Exposure from Untrusted Workspace<BR/>&#160;<BR/>Operating against untrusted workspace content could lead<BR/>to disclosure of sensitive data or unintended access<BR/>beyond user intent.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"STO-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STO-001: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably. This card is retained only as a legacy<BR/>tombstone for historical continuity; it used a<BR/>non-canonical prefix and has been superseded by<BR/>`STR-004` (and the active story `STR-003`).</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-001: <B>Story</B><BR/>Author and Share Aurora Model<BR/>&#160;<BR/>As an architect, I want to author, validate, render, and<BR/>share an Aurora model so that stakeholders and tools<BR/>have a consistent source of truth.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-002" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-002: <B>Story</B><BR/>Edit Aurora Model in Tools<BR/>&#160;<BR/>As a user, I want to browse, edit, validate, and preview<BR/>an Aurora model inside the tooling surfaces so that I<BR/>can iterate quickly and confidently.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-003" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-003: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-004" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-004: <B>Story</B> (Tombstone)<BR/>Store the Model in a Postable Format (Tombstone)<BR/>&#160;<BR/>Legacy tombstone story retained for traceability. This<BR/>existed to record the transition away from a<BR/>non-canonical Story prefix. The legacy card is `STO-001`<BR/>(status: Deleted). The active story is `STR-003`.</FONT></TD></TR></TABLE>>, shape="cds"];
	"SYS-001" [fillcolor="#172554", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧱</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>SYS-001: <B>System</B><BR/>Default Tooling Platform<BR/>&#160;<BR/>A bounded system that delivers the default Aurora<BR/>tooling surfaces: CLI, Editor, and VSCode Extension.</FONT></TD></TR></TABLE>>, shape="folder"];
	"TES-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-001: <B>Test</B><BR/>Validate Model Command<BR/>&#160;<BR/>Verify that the validate command detects<BR/>schema/invariant violations and succeeds on a valid<BR/>model.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"TES-002" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-002: <B>Test</B><BR/>Render All Command<BR/>&#160;<BR/>Verify that render-all produces rendered card markdown<BR/>and view files for a valid model.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"TES-003" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-003: <B>Test</B><BR/>Compact Command<BR/>&#160;<BR/>Verify that compact export emits a compact model<BR/>representation conforming to the compact schema.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-001: <B>Threat</B><BR/>Script Injection via Markdown<BR/>&#160;<BR/>Untrusted content in model descriptions or rendered<BR/>Markdown could inject script or unsafe resources into a<BR/>webview-based renderer.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-002: <B>Threat</B><BR/>Path Traversal or Arbitrary Write<BR/>&#160;<BR/>A crafted input path or unsafe write behavior could<BR/>cause tooling to write outside the intended<BR/>model/workspace directory, overwriting unrelated files.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>THR-003: <B>Threat</B><BR/>Untrusted Workspace Execution or Access<BR/>&#160;<BR/>Operating in an untrusted workspace could allow unsafe<BR/>operations that lead to data exposure or unintended<BR/>execution paths.</FONT></TD></TR></TABLE>>, shape="octagon"];
