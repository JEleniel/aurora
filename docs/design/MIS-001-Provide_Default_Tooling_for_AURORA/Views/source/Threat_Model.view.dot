digraph "Threat Model View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />Architect<br /><br />Person responsible for authoring and maintaining the<br />Aurora model for a system.</FONT>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />User<br /><br />Person using Aurora tooling surfaces to browse, edit,<br />validate, and render models in a workspace.</FONT>>, shape="ellipse"];
	"ACT-003" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<FONT><B>Actor</B><br />Malicious Workspace Author<br /><br />Adversarial actor who crafts workspace content to<br />exploit tooling behavior.</FONT>>, shape="ellipse"];
	"ATV-001" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Load Model<br /><br />Load a model from disk into memory.</FONT>>, shape="box"];
	"ATV-002" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Validate Model<br /><br />Validate a model and review diagnostics.</FONT>>, shape="box"];
	"ATV-003" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Render Views<br /><br />Generate rendered views and Markdown documentation from<br />the model.</FONT>>, shape="box"];
	"ATV-004" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Compact Model<br /><br />Export a compact representation for machine agents.</FONT>>, shape="box"];
	"ATV-005" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Open Model in Tool<br /><br />Open an Aurora model in an interactive tooling surface.</FONT>>, shape="box"];
	"ATV-006" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Navigate Model<br /><br />Navigate the model by browsing, searching, and exploring<br />relationships.</FONT>>, shape="box"];
	"ATV-007" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Edit Cards and Links<br /><br />Create and update cards and links in the model.</FONT>>, shape="box"];
	"ATV-008" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Review Validation Diagnostics<br /><br />Review validation results, navigate to affected cards,<br />and apply fixes.</FONT>>, shape="box"];
	"ATV-009" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Preview Output<br /><br />Preview rendered views and Markdown representations of<br />the model.</FONT>>, shape="box"];
	"ATV-010" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><br />Save Model Safely<br /><br />Save the model with safe file operations and optional<br />export formats.</FONT>>, shape="box"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Workspace Trust Gate<br /><br />Gate potentially unsafe operations (e.g., file writes,<br />webview rendering, executing tools) behind workspace<br />trust checks and explicit user consent.</FONT>>, shape="octagon"];
	"CTL-002" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Safe Path Handling and Atomic Writes<br /><br />Constrain paths to the intended workspace/model roots,<br />normalize and validate paths, and use atomic write<br />patterns to prevent partial writes and clobbering.</FONT>>, shape="octagon"];
	"CTL-003" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Content Sanitization<br /><br />Sanitize rendered Markdown and webview content, restrict<br />resource loading, and disable script execution to<br />prevent injection.</FONT>>, shape="octagon"];
	"CTL-004" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<FONT><B>Control</B><br />Least Privilege File Access<br /><br />Minimize read/write permissions and scope operations to<br />explicit user-selected paths; avoid reading or writing<br />unrelated workspace files.</FONT>>, shape="octagon"];
	"PRO-001" [fillcolor="#2e1065", fontcolor="#FFFFFF", label=<<FONT><B>Process</B><br />Model Authoring Workflow<br /><br />A repeatable workflow for authoring, validating,<br />rendering, and exporting an Aurora model.</FONT>>, shape="box"];
	"PRO-002" [fillcolor="#2e1065", fontcolor="#FFFFFF", label=<<FONT><B>Process</B><br />In-Tool Model Editing Workflow<br /><br />A repeatable workflow for interactively opening,<br />navigating, editing, validating, previewing, and saving<br />an Aurora model.</FONT>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Injected Content in Rendered Output<br /><br />Rendered output could contain unsafe content that<br />misleads users or executes in a webview context.</FONT>>, shape="octagon"];
	"RIS-002" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Unintended File Modification<br /><br />Tooling could overwrite or corrupt files outside the<br />intended model output locations.</FONT>>, shape="octagon"];
	"RIS-003" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<FONT><B>Risk</B><br />Data Exposure from Untrusted Workspace<br /><br />Operating against untrusted workspace content could lead<br />to disclosure of sensitive data or unintended access<br />beyond user intent.</FONT>>, shape="octagon"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Script Injection via Markdown<br /><br />Untrusted content in model descriptions or rendered<br />Markdown could inject script or unsafe resources into a<br />webview-based renderer.</FONT>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Path Traversal or Arbitrary Write<br /><br />A crafted input path or unsafe write behavior could<br />cause tooling to write outside the intended<br />model/workspace directory, overwriting unrelated files.</FONT>>, shape="octagon"];
	"THR-003" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<FONT><B>Threat</B><br />Untrusted Workspace Execution or Access<br /><br />Operating in an untrusted workspace could allow unsafe<br />operations that lead to data exposure or unintended<br />execution paths.</FONT>>, shape="octagon"];
	"ACT-003" -> "THR-001" [label="presents"];
	"ACT-003" -> "THR-002" [label="presents"];
	"ACT-003" -> "THR-003" [label="presents"];
	"CTL-001" -> "RIS-003" [label="mitigates"];
	"CTL-001" -> "THR-003" [label="mitigates"];
	"CTL-002" -> "RIS-002" [label="mitigates"];
	"CTL-002" -> "THR-002" [label="mitigates"];
	"CTL-003" -> "RIS-001" [label="mitigates"];
	"CTL-003" -> "THR-001" [label="mitigates"];
	"CTL-004" -> "RIS-002" [label="mitigates"];
	"CTL-004" -> "RIS-003" [label="mitigates"];
	"PRO-001" -> "ACT-001" [label="involves"];
	"PRO-001" -> "ATV-001" [label="includes"];
	"PRO-001" -> "ATV-002" [label="includes"];
	"PRO-001" -> "ATV-003" [label="includes"];
	"PRO-001" -> "ATV-004" [label="includes"];
	"PRO-002" -> "ACT-002" [label="involves"];
	"PRO-002" -> "ATV-005" [label="includes"];
	"PRO-002" -> "ATV-006" [label="includes"];
	"PRO-002" -> "ATV-007" [label="includes"];
	"PRO-002" -> "ATV-008" [label="includes"];
	"PRO-002" -> "ATV-009" [label="includes"];
	"PRO-002" -> "ATV-010" [label="includes"];
	"THR-001" -> "RIS-001" [label="imposes"];
	"THR-002" -> "RIS-002" [label="imposes"];
	"THR-003" -> "RIS-003" [label="imposes"];
}