digraph "Requirements View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Model IO<br /><br />Ability to load and save Aurora models from and to disk<br />in stable formats.</FONT>>, shape="box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Model Validation<br /><br />Ability to validate Aurora models for schema correctness<br />and structural invariants with actionable diagnostics.</FONT>>, shape="box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Model Update<br /><br />Ability to update Aurora models by creating, editing,<br />and deleting cards and links while preserving<br />invariants.</FONT>>, shape="box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />View Rendering<br /><br />Ability to render human-readable views and documentation<br />from Aurora models.</FONT>>, shape="box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Model Compaction<br /><br />Ability to emit a compact, machine-friendly<br />representation of an Aurora model for agents and<br />interchange.</FONT>>, shape="box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Interactive Authoring<br /><br />Ability to author and modify Aurora models interactively<br />with guardrails, validation feedback, and consistent<br />persistence.</FONT>>, shape="box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />In-Editor Visualization<br /><br />Ability to visualize, navigate, and comprehend Aurora<br />models inside interactive tooling surfaces.</FONT>>, shape="box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Workspace Integration<br /><br />Ability to integrate Aurora tooling with workspace file<br />systems, editors, and automation loops (open, watch,<br />save, refresh).</FONT>>, shape="box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<FONT><B>✨ Capability</B><br />Safe and Trusted Operation<br /><br />Ability to operate safely against untrusted workspace<br />content, including safe file operations, trust gating,<br />and sanitized rendering.</FONT>>, shape="box"];
	"CNS-001" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>📏 Constraint</B><br />Text Based Data Format<br /><br />In order to remain human readable and editable, the data<br />format must be text based.</FONT>>, shape="box"];
	"CNS-002" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>📏 Constraint</B> (Invariant)<br />Directed, Locally Cyclic Graph<br /><br />The model must form a Directed Graph in which all paths<br />start from a root card (&quot;Mission&quot;) and monotonically<br />increase in length until either encountering a card<br />already encountered or reaching a leaf card (one with no<br />outgoing links).</FONT>>, shape="box"];
	"CNS-003" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>📏 Constraint</B><br />No Inherent Semantic Meaning<br /><br />The nodes and edges of the model must not carry any<br />semantic meaning; semantic meaning is imposed when<br />interpreted for some use, such as generating views.</FONT>>, shape="box"];
	"CNS-004" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>📏 Constraint</B><br />No Orphans<br /><br />All cards other than `Mission` must have at least one<br />incoming link.</FONT>>, shape="box"];
	"CNS-005" [fillcolor="#854d0e", fontcolor="#FFFFFF", label=<<FONT><B>📏 Constraint</B> (Graphviz)<br />Graphviz DOT View Conventions<br /><br />Defines the canonical Graphviz DOT conventions<br />(graph/node/edge defaults and boundary cluster styling)<br />used when rendering Aurora views to DOT/SVG.</FONT>>, shape="box"];
	"DRI-001" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<FONT><B>🧭 Driver</B><br />Produce Common Architectural Artifacts<br /><br />Produce the drawings, designs, and other artifacts<br />commonly expected for software architecture.</FONT>>, shape="box"];
	"DRI-002" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<FONT><B>🧭 Driver</B><br />Explain Entire Model in Simple Language<br /><br />The entire model is expressible by listing the nodes and<br />their relationships in simple sentences.</FONT>>, shape="box"];
	"DRI-003" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<FONT><B>🧭 Driver</B><br />One Model to Rule Them All<br /><br />A single Aurora model captures every aspect of the<br />architecture in one cohesive model.</FONT>>, shape="box"];
	"DRI-004" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<FONT><B>🧭 Driver</B><br />Human and Agent Friendly<br /><br />Express the model in a form that is easy to parse and<br />understand for both humans and machine agents.</FONT>>, shape="box"];
	"DRI-005" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<FONT><B>🧭 Driver</B><br />Open and Unencumbered<br /><br />The data formats and other elements will be open and<br />uncumbered, allowing anyone to implement tooling against<br />AURORA.</FONT>>, shape="box"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Load Models<br /><br />Load Aurora model cards from disk into memory,<br />preserving identifiers, links, and schema references.</FONT>>, shape="box"];
	"FEA-002" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Model Validation<br /><br />Validate Aurora models against schemas and invariants<br />and produce actionable diagnostics.</FONT>>, shape="box"];
	"FEA-003" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Update Models<br /><br />Create, edit, and delete Aurora cards and links with<br />invariant-preserving operations.</FONT>>, shape="box"];
	"FEA-004" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Save Models<br /><br />Persist Aurora model cards and links to disk in a<br />stable, reviewable format.</FONT>>, shape="box"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Render Views<br /><br />Generate human-readable Markdown and Mermaid view<br />documentation from Aurora models.</FONT>>, shape="box"];
	"FEA-006" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Model Compaction<br /><br />Emit a compact representation of an Aurora model<br />suitable for machine agents and interchange.</FONT>>, shape="box"];
	"FEA-007" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Browse and Search Models<br /><br />Browse, filter, and search cards and links in an Aurora<br />model with fast navigation primitives.</FONT>>, shape="box"];
	"FEA-008" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Edit Models Interactively<br /><br />Interactive editing UI and operations for creating and<br />updating cards and links with immediate feedback.</FONT>>, shape="box"];
	"FEA-009" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Show Validation Diagnostics<br /><br />Show schema and invariant validation diagnostics inline<br />and in structured panels.</FONT>>, shape="box"];
	"FEA-010" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Visualize Model Graph<br /><br />Provide an interactive graph visualization of the model<br />with zoom, pan, and focus-on-card navigation.</FONT>>, shape="box"];
	"FEA-011" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Preview Rendered Markdown<br /><br />Preview and navigate rendered Markdown documentation<br />from Aurora models inside tooling.</FONT>>, shape="box"];
	"FEA-012" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Workspace Integration<br /><br />Integrate with the user workspace: open models, watch<br />for changes, and keep views in sync.</FONT>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Safe File Operations<br /><br />Perform safe, constrained file operations with clear<br />user intent boundaries and reliable persistence<br />semantics.</FONT>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Workspace Trust Gating<br /><br />Respect workspace trust boundaries by limiting<br />operations when the workspace is untrusted.</FONT>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<FONT><B>⭐ Feature</B><br />Sanitized Rendering<br /><br />Render Markdown and webview content safely, preventing<br />script injection and unsafe resource access.</FONT>>, shape="box"];
	"MIS-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<FONT><B>🎯 Mission</B><br />Provide Default Tooling for AURORA<br /><br />Provide command line, GUI, and VSCode Extension tools<br />for the AURORA architectural system.</FONT>>, shape="doubleoctagon"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Boundary Cards<br /><br />There must exist a special card, `Boundary`, with the<br />optional property `recursive` (default true) which can<br />represent the containment of other elements without<br />altering the meaning or relationship of the model; in<br />other words a logical boundary.</FONT>>, shape="box"];
	"REQ-002" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Note Cards<br /><br />There must be a special card called `Note` that allows<br />the capture of arbitrary text and annotates an existing<br />node in the model without modifying it or the model. The<br />`Note` card must have only one incoming link from the<br />card it modifies.</FONT>>, shape="box"];
	"REQ-003" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Load Models<br /><br />Tools MUST be able to load one or more Aurora models<br />from disk for use in validation, editing, and rendering<br />workflows.</FONT>>, shape="box"];
	"REQ-004" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Validate Models<br /><br />Tools MUST validate Aurora models against the Aurora<br />schema and structural invariants, and report actionable<br />diagnostics.</FONT>>, shape="box"];
	"REQ-005" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Update Models<br /><br />Tools MUST support updating Aurora models, including<br />creating, editing, and deleting cards and links while<br />preserving model invariants.</FONT>>, shape="box"];
	"REQ-006" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Save Models<br /><br />Tools MUST persist Aurora models to disk in a stable,<br />text-based representation suitable for diffing and<br />review.</FONT>>, shape="box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Render Views<br /><br />Tools MUST generate human-readable views (e.g., Mermaid<br />diagrams and markdown) from an Aurora model.</FONT>>, shape="box"];
	"REQ-008" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Compact Models<br /><br />Tools MUST be able to emit a compact, machine-friendly<br />representation of an Aurora model for agent consumption<br />and interchange.</FONT>>, shape="box"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Browse and Search Models<br /><br />Tools MUST enable users to browse and search the cards<br />and links in an Aurora model efficiently.</FONT>>, shape="box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Edit Models Interactively<br /><br />Tools MUST enable users to create, edit, and delete<br />cards and links with immediate feedback and without<br />corrupting the model.</FONT>>, shape="box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Show Validation Diagnostics<br /><br />Tools MUST surface schema and invariant validation<br />diagnostics in a form users can act on (including<br />location and remediation hints where possible).</FONT>>, shape="box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Visualize Model Graph<br /><br />Tools MUST provide a graph-based visualization of the<br />model and its relationships to support navigation and<br />comprehension.</FONT>>, shape="box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Preview Rendered Markdown<br /><br />Tools MUST allow users to preview and navigate the<br />human-readable Markdown renderings generated from an<br />Aurora model.</FONT>>, shape="box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Workspace Integration<br /><br />Tools MUST integrate with the user’s workspace to<br />open, watch, and save model files using predictable,<br />user-controlled behaviors.</FONT>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Safe File Operations<br /><br />Tools MUST perform file operations safely (prevent<br />unintended overwrites, constrain paths, and avoid<br />writing outside the user’s intended workspace<br />locations).</FONT>>, shape="box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Workspace Trust Gating<br /><br />Tools MUST respect workspace trust boundaries by<br />limiting potentially unsafe operations in untrusted<br />workspaces.</FONT>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Sanitized Rendering<br /><br />Tools MUST render Markdown and any webview content<br />safely by sanitizing untrusted content and preventing<br />script injection.</FONT>>, shape="box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Store the Model in a Postable Format<br /><br />Tools MUST present the ability to compress the entire<br />model into a single file (for example, a ZIP) for<br />transport between instances.</FONT>>, shape="box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<FONT><B>☑️ Requirement</B><br />Render Canonical View Set<br /><br />Tools MUST render every view defined in the canonical<br />view registry (see<br />.github/instructions/View_Definitions.md), producing a<br />deterministic set of view outputs for a given model.</FONT>>, shape="box"];
	"STO-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<FONT><B>📖 Story</B><br />Store the Model in a Postable Format<br /><br />As an architect, I want to package an Aurora model into<br />a single portable file (for example, a ZIP) so that I<br />can transport it between instances and share it<br />reliably. This card is retained only as a legacy<br />tombstone for historical continuity; it used a<br />non-canonical prefix and has been superseded by<br />`STR-004` (and the active story `STR-003`).</FONT>>, shape="cds"];
	"STR-003" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<FONT><B>📖 Story</B><br />Store the Model in a Postable Format<br /><br />As an architect, I want to package an Aurora model into<br />a single portable file (for example, a ZIP) so that I<br />can transport it between instances and share it<br />reliably.</FONT>>, shape="cds"];
	"STR-004" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<FONT><B>📖 Story</B> (Tombstone)<br />Store the Model in a Postable Format (Tombstone)<br /><br />Legacy tombstone story retained for traceability. This<br />supersedes the earlier `STO-001` story card, which used<br />a non-canonical prefix. `STO-001` is retained as<br />`Deleted` for historical continuity.</FONT>>, shape="cds"];
	"TES-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<FONT><B>🧪 Test</B><br />Validate Model Command<br /><br />Verify that the validate command detects<br />schema/invariant violations and succeeds on a valid<br />model.</FONT>>, shape="hexagon"];
	"TES-002" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<FONT><B>🧪 Test</B><br />Render All Command<br /><br />Verify that render-all produces rendered card markdown<br />and view files for a valid model.</FONT>>, shape="hexagon"];
	"TES-003" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<FONT><B>🧪 Test</B><br />Compact Command<br /><br />Verify that compact export emits a compact model<br />representation conforming to the compact schema.</FONT>>, shape="hexagon"];
	"CAP-001" -> "REQ-003" [label="satisfies"];
	"CAP-001" -> "REQ-006" [label="satisfies"];
