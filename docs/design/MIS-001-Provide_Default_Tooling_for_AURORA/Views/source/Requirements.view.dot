digraph "Requirements View" {
	graph [bgcolor="#FFFFFF", fontname="Inter", rankdir="LR", splines="spline"];
	node [color="#111827", fillcolor="#E5E7EB", fontcolor="#111827", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-001: <B>Capability</B><BR/>Model IO<BR/>&#160;<BR/>Ability to load and save Aurora models from and to disk<BR/>in stable formats.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-002: <B>Capability</B><BR/>Model Validation<BR/>&#160;<BR/>Ability to validate Aurora models for schema correctness<BR/>and structural invariants with actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-003: <B>Capability</B><BR/>Model Update<BR/>&#160;<BR/>Ability to update Aurora models by creating, editing,<BR/>and deleting cards and links while preserving<BR/>invariants.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-004: <B>Capability</B><BR/>View Rendering<BR/>&#160;<BR/>Ability to render human-readable views and documentation<BR/>from Aurora models.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-005: <B>Capability</B><BR/>Model Compaction<BR/>&#160;<BR/>Ability to emit a compact, machine-friendly<BR/>representation of an Aurora model for agents and<BR/>interchange.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-006: <B>Capability</B><BR/>Interactive Authoring<BR/>&#160;<BR/>Ability to author and modify Aurora models interactively<BR/>with guardrails, validation feedback, and consistent<BR/>persistence.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-007: <B>Capability</B><BR/>In-Editor Visualization<BR/>&#160;<BR/>Ability to visualize, navigate, and comprehend Aurora<BR/>models inside interactive tooling surfaces.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-008: <B>Capability</B><BR/>Workspace Integration<BR/>&#160;<BR/>Ability to integrate Aurora tooling with workspace file<BR/>systems, editors, and automation loops (open, watch,<BR/>save, refresh).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>CAP-009: <B>Capability</B><BR/>Safe and Trusted Operation<BR/>&#160;<BR/>Ability to operate safely against untrusted workspace<BR/>content, including safe file operations, trust gating,<BR/>and sanitized rendering.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-001" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-001: <B>Driver</B><BR/>Produce Common Architectural Artifacts<BR/>&#160;<BR/>Produce the drawings, designs, and other artifacts<BR/>commonly expected for software architecture.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-002" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-002: <B>Driver</B><BR/>Explain Entire Model in Simple Language<BR/>&#160;<BR/>The entire model is expressible by listing the nodes and<BR/>their relationships in simple sentences.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-003" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-003: <B>Driver</B><BR/>One Model to Rule Them All<BR/>&#160;<BR/>A single Aurora model captures every aspect of the<BR/>architecture in one cohesive model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-004" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-004: <B>Driver</B><BR/>Human and Agent Friendly<BR/>&#160;<BR/>Express the model in a form that is easy to parse and<BR/>understand for both humans and machine agents.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"DRI-005" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>DRI-005: <B>Driver</B><BR/>Open and Unencumbered<BR/>&#160;<BR/>The data formats and other elements will be open and<BR/>uncumbered, allowing anyone to implement tooling against<BR/>AURORA.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-001: <B>Feature</B><BR/>Load Models<BR/>&#160;<BR/>Load Aurora model cards from disk into memory,<BR/>preserving identifiers, links, and schema references.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-002" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-002: <B>Feature</B><BR/>Model Validation<BR/>&#160;<BR/>Validate Aurora models against schemas and invariants<BR/>and produce actionable diagnostics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-003" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-003: <B>Feature</B><BR/>Update Models<BR/>&#160;<BR/>Create, edit, and delete Aurora cards and links with<BR/>invariant-preserving operations.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-004" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-004: <B>Feature</B><BR/>Save Models<BR/>&#160;<BR/>Persist Aurora model cards and links to disk in a<BR/>stable, reviewable format.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-005: <B>Feature</B><BR/>Render Views<BR/>&#160;<BR/>Generate human-readable Markdown and Mermaid view<BR/>documentation from Aurora models.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-006" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-006: <B>Feature</B><BR/>Model Compaction<BR/>&#160;<BR/>Emit a compact representation of an Aurora model<BR/>suitable for machine agents and interchange.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-007" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-007: <B>Feature</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Browse, filter, and search cards and links in an Aurora<BR/>model with fast navigation primitives.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-008" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-008: <B>Feature</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Interactive editing UI and operations for creating and<BR/>updating cards and links with immediate feedback.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-009" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-009: <B>Feature</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Show schema and invariant validation diagnostics inline<BR/>and in structured panels.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-010" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-010: <B>Feature</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Provide an interactive graph visualization of the model<BR/>with zoom, pan, and focus-on-card navigation.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-011" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-011: <B>Feature</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Preview and navigate rendered Markdown documentation<BR/>from Aurora models inside tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-012" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-012: <B>Feature</B><BR/>Workspace Integration<BR/>&#160;<BR/>Integrate with the user workspace: open models, watch<BR/>for changes, and keep views in sync.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-013: <B>Feature</B><BR/>Safe File Operations<BR/>&#160;<BR/>Perform safe, constrained file operations with clear<BR/>user intent boundaries and reliable persistence<BR/>semantics.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-014: <B>Feature</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Respect workspace trust boundaries by limiting<BR/>operations when the workspace is untrusted.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>FEA-015: <B>Feature</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Render Markdown and webview content safely, preventing<BR/>script injection and unsafe resource access.</FONT></TD></TR></TABLE>>, shape="box"];
	"MIS-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🎯</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>MIS-001: <B>Mission</B><BR/>Provide Default Tooling for AURORA<BR/>&#160;<BR/>Provide command line, GUI, and VSCode Extension tools<BR/>for the AURORA architectural system.</FONT></TD></TR></TABLE>>, shape="double-octagon"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-001: <B>Requirement</B><BR/>Boundary Cards<BR/>&#160;<BR/>There must exist a special card, `Boundary`, with the<BR/>optional property `recursive` (default true) which can<BR/>represent the containment of other elements without<BR/>altering the meaning or relationship of the model; in<BR/>other words a logical boundary.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-002" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-002: <B>Requirement</B><BR/>Note Cards<BR/>&#160;<BR/>There must be a special card called `Note` that allows<BR/>the capture of arbitrary text and annotates an existing<BR/>node in the model without modifying it or the model. The<BR/>`Note` card must have only one incoming link from the<BR/>card it modifies.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-003" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-003: <B>Requirement</B><BR/>Load Models<BR/>&#160;<BR/>Tools MUST be able to load one or more Aurora models<BR/>from disk for use in validation, editing, and rendering<BR/>workflows.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-004" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-004: <B>Requirement</B><BR/>Validate Models<BR/>&#160;<BR/>Tools MUST validate Aurora models against the Aurora<BR/>schema and structural invariants, and report actionable<BR/>diagnostics.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-005" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-005: <B>Requirement</B><BR/>Update Models<BR/>&#160;<BR/>Tools MUST support updating Aurora models, including<BR/>creating, editing, and deleting cards and links while<BR/>preserving model invariants.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-006" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-006: <B>Requirement</B><BR/>Save Models<BR/>&#160;<BR/>Tools MUST persist Aurora models to disk in a stable,<BR/>text-based representation suitable for diffing and<BR/>review.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-007" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-007: <B>Requirement</B><BR/>Render Views<BR/>&#160;<BR/>Tools MUST generate human-readable views (e.g., Mermaid<BR/>diagrams and markdown) from an Aurora model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-008" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-008: <B>Requirement</B><BR/>Compact Models<BR/>&#160;<BR/>Tools MUST be able to emit a compact, machine-friendly<BR/>representation of an Aurora model for agent consumption<BR/>and interchange.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-009: <B>Requirement</B><BR/>Browse and Search Models<BR/>&#160;<BR/>Tools MUST enable users to browse and search the cards<BR/>and links in an Aurora model efficiently.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-010: <B>Requirement</B><BR/>Edit Models Interactively<BR/>&#160;<BR/>Tools MUST enable users to create, edit, and delete<BR/>cards and links with immediate feedback and without<BR/>corrupting the model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-011: <B>Requirement</B><BR/>Show Validation Diagnostics<BR/>&#160;<BR/>Tools MUST surface schema and invariant validation<BR/>diagnostics in a form users can act on (including<BR/>location and remediation hints where possible).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-012: <B>Requirement</B><BR/>Visualize Model Graph<BR/>&#160;<BR/>Tools MUST provide a graph-based visualization of the<BR/>model and its relationships to support navigation and<BR/>comprehension.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-013: <B>Requirement</B><BR/>Preview Rendered Markdown<BR/>&#160;<BR/>Tools MUST allow users to preview and navigate the<BR/>human-readable Markdown renderings generated from an<BR/>Aurora model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-014: <B>Requirement</B><BR/>Workspace Integration<BR/>&#160;<BR/>Tools MUST integrate with the user’s workspace to<BR/>open, watch, and save model files using predictable,<BR/>user-controlled behaviors.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-015: <B>Requirement</B><BR/>Safe File Operations<BR/>&#160;<BR/>Tools MUST perform file operations safely (prevent<BR/>unintended overwrites, constrain paths, and avoid<BR/>writing outside the user’s intended workspace<BR/>locations).</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-016: <B>Requirement</B><BR/>Workspace Trust Gating<BR/>&#160;<BR/>Tools MUST respect workspace trust boundaries by<BR/>limiting potentially unsafe operations in untrusted<BR/>workspaces.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-017: <B>Requirement</B><BR/>Sanitized Rendering<BR/>&#160;<BR/>Tools MUST render Markdown and any webview content<BR/>safely by sanitizing untrusted content and preventing<BR/>script injection.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-018: <B>Requirement</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>Tools MUST present the ability to compress the entire<BR/>model into a single file (for example, a ZIP) for<BR/>transport between instances.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>REQ-019: <B>Requirement</B><BR/>Render Canonical View Set<BR/>&#160;<BR/>Tools MUST render every view defined in the canonical<BR/>view registry (see<BR/>.github/instructions/View_Definitions.md), producing a<BR/>deterministic set of view outputs for a given model.</FONT></TD></TR></TABLE>>, shape="rounded box"];
	"STO-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STO-001: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably. This card is retained only as a legacy<BR/>tombstone for historical continuity; it used a<BR/>non-canonical prefix and has been superseded by<BR/>`STR-004` (and the active story `STR-003`).</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-003" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-003: <B>Story</B><BR/>Store the Model in a Postable Format<BR/>&#160;<BR/>As an architect, I want to package an Aurora model into<BR/>a single portable file (for example, a ZIP) so that I<BR/>can transport it between instances and share it<BR/>reliably.</FONT></TD></TR></TABLE>>, shape="cds"];
	"STR-004" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>STR-004: <B>Story</B> (Tombstone)<BR/>Store the Model in a Postable Format (Tombstone)<BR/>&#160;<BR/>Legacy tombstone story retained for traceability. This<BR/>existed to record the transition away from a<BR/>non-canonical Story prefix. The legacy card is `STO-001`<BR/>(status: Deleted). The active story is `STR-003`.</FONT></TD></TR></TABLE>>, shape="cds"];
	"TES-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-001: <B>Test</B><BR/>Validate Model Command<BR/>&#160;<BR/>Verify that the validate command detects<BR/>schema/invariant violations and succeeds on a valid<BR/>model.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"TES-002" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-002: <B>Test</B><BR/>Render All Command<BR/>&#160;<BR/>Verify that render-all produces rendered card markdown<BR/>and view files for a valid model.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"TES-003" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="33">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT>TES-003: <B>Test</B><BR/>Compact Command<BR/>&#160;<BR/>Verify that compact export emits a compact model<BR/>representation conforming to the compact schema.</FONT></TD></TR></TABLE>>, shape="hexagon"];
