      "links": [],
      "name": "Safe Workspace Persistence"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "The editor SHALL provide a left-pane tree view for navigation, where the tree is derived from a chosen shortest path from the mission root to each card.",
