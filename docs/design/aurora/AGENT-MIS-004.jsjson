    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "The editor SHALL provide a central mind-map / TheBrain style view with the focused card centered. The view SHALL show the parent (from the chosen shortest-path chain), and MAY show siblings (same card_type) linked from that parent even if they are not linked to the focused card.",
      "id": "REQ-011",
