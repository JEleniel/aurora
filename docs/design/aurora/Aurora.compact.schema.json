{
	"$id": "https://crystultima.org/aurora/compact.schema.json",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Aurora Compact Model Schema",
	"description": "JSON schema for Compact.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["cards"],
	"properties": {
		"$schema": {
			"type": "string",
			"minLength": 1
		},
		"cards": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/definitions/card"
			}
		}
	},
	"definitions": {
		"non_empty": {
			"type": "string",
			"minLength": 1
		},
		"id_ref": {
			"type": "string",
			"pattern": "^[A-Z]{3}-\\d{3,}$"
		},
		"link": {
			"type": "object",
			"additionalProperties": false,
			"required": ["relationship", "target"],
			"properties": {
				"relationship": {
					"$ref": "#/definitions/non_empty"
				},
				"target": {
					"$ref": "#/definitions/id_ref"
				}
			}
		},
		"card": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "card_type", "name", "links", "attributes"],
			"properties": {
				"boundary": {
					"type": "string",
					"minLength": 1
				},
				"attributes": {
					"type": "object",
					"additionalProperties": true
				},
				"card_subtype": {
					"$ref": "#/definitions/non_empty"
				},
				"card_type": {
					"$ref": "#/definitions/non_empty"
				},
				"id": {
					"$ref": "#/definitions/id_ref"
				},
				"links": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"$ref": "#/definitions/link"
					}
				},
				"name": {
					"$ref": "#/definitions/non_empty"
				},
				"notes": {
					"$ref": "#/definitions/non_empty"
				},
				"status": {
					"$ref": "#/definitions/non_empty"
				}
			}
		}
	}
}
