      "card_subtype": "Graphviz",
      "card_type": "Constraint",
      "description": "Defines the canonical Graphviz DOT conventions (graph/node/edge defaults and boundary cluster styling) used when rendering Aurora views to DOT/SVG.",
      "id": "CNS-005",
      "links": [],
      "name": "Graphviz DOT View Conventions"
    },
    {
      "attributes": null,
      "card_subtype": "Invariant",
      "card_type": "Constraint",
      "description": "The model must form a Directed Graph in which all paths start from a root card (\"Mission\") and monotonically increase in length until either encountering a card already encountered or reaching a leaf card (one with no outgoing links).",
      "id": "CNS-002",
      "links": [
        {
          "relationship": "includes",
          "target": "CNS-004"
        }
      ],
      "name": "Directed, Locally Cyclic Graph"
    },
    {
      "attributes": null,
      "card_type": "Constraint",
      "description": "All cards other than `Mission` must have at least one incoming link.",
      "id": "CNS-004",
      "links": [],
      "name": "No Orphans"
    },
    {
      "attributes": null,
      "card_type": "Constraint",
      "description": "The nodes and edges of the model must not carry any semantic meaning; semantic meaning is imposed when interpreted for some use, such as generating views.",
      "id": "CNS-003",
      "links": [],
      "name": "No Inherent Semantic Meaning"
    },
    {
      "attributes": null,
      "card_type": "Constraint",
      "description": "In order to remain human readable and editable, the data format must be text based.",
      "id": "CNS-001",
      "links": [],
      "name": "Text Based Data Format"
    },
    {
      "attributes": null,
      "card_type": "Note",
      "description": "Tooling surfaces should prioritize shareable, portable artifacts (e.g., rendered views and model packages) without compromising workspace trust and path safety.",
      "id": "NOT-001",
      "links": [],
      "name": "Shareable"
    },
