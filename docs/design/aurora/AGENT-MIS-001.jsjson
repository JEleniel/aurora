    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST allow users to preview and navigate the human-readable Markdown renderings generated from an Aurora model.",
      "id": "REQ-013",
      "links": [],
      "name": "Preview Rendered Markdown"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST persist Aurora models to disk in a stable, text-based representation suitable for diffing and review.",
      "id": "REQ-006",
      "links": [],
      "name": "Save Models"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST support updating Aurora models, including creating, editing, and deleting cards and links while preserving model invariants.",
      "id": "REQ-005",
      "links": [],
      "name": "Update Models"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST enable users to create, edit, and delete cards and links with immediate feedback and without corrupting the model.",
      "id": "REQ-010",
      "links": [],
      "name": "Edit Models Interactively"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST enable users to browse and search the cards and links in an Aurora model efficiently.",
      "id": "REQ-009",
      "links": [],
      "name": "Browse and Search Models"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST present the ability to compress the entire model into a single file (for example, a ZIP) for transport between instances.",
      "id": "REQ-018",
      "links": [],
      "name": "Store the Model in a Postable Format"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST surface schema and invariant validation diagnostics in a form users can act on (including location and remediation hints where possible).",
      "id": "REQ-011",
      "links": [],
      "name": "Show Validation Diagnostics"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST render Markdown and any webview content safely by sanitizing untrusted content and preventing script injection.",
      "id": "REQ-017",
      "links": [],
      "name": "Sanitized Rendering"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST perform file operations safely (prevent unintended overwrites, constrain paths, and avoid writing outside the user’s intended workspace locations).",
      "id": "REQ-015",
      "links": [],
      "name": "Safe File Operations"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "There must exist a special card, `Boundary`, with the optional property `recursive` (default true) which can represent the containment of other elements without altering the meaning or relationship of the model; in other words a logical boundary.",
      "id": "REQ-001",
      "links": [],
      "name": "Boundary Cards"
    },
    {
      "attributes": {
        "output_convention": {
          "diagram_dot_file": "{View_Slug}.view.dot",
          "diagram_svg_file": "{View_Slug}.view.svg",
          "markdown_file": "{View_Slug}.view.md"
        },
        "view_registry_path": ".github/instructions/View_Definitions.md"
      },
      "card_type": "Requirement",
      "description": "Tools MUST render every view defined in the canonical view registry (see .github/instructions/View_Definitions.md), producing a deterministic set of view outputs for a given model.",
      "id": "REQ-019",
      "links": [],
      "name": "Render Canonical View Set"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST be able to load one or more Aurora models from disk for use in validation, editing, and rendering workflows.",
      "id": "REQ-003",
      "links": [],
      "name": "Load Models"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST respect workspace trust boundaries by limiting potentially unsafe operations in untrusted workspaces.",
      "id": "REQ-016",
      "links": [],
      "name": "Workspace Trust Gating"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "There must be a special card called `Note` that allows the capture of arbitrary text and annotates an existing node in the model without modifying it or the model. The `Note` card must have only one incoming link from the card it modifies.",
      "id": "REQ-002",
      "links": [],
      "name": "Note Cards"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST integrate with the user’s workspace to open, watch, and save model files using predictable, user-controlled behaviors.",
      "id": "REQ-014",
      "links": [],
      "name": "Workspace Integration"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Tools MUST be able to emit a compact, machine-friendly representation of an Aurora model for agent consumption and interchange.",
      "id": "REQ-008",
      "links": [],
      "name": "Compact Models"
    },
