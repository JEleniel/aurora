      "name": "Canonical Registries and View Definitions"
    },
    {
      "attributes": null,
      "card_type": "Driver",
      "description": "Enable unambiguous interpretation and automated reasoning by enforcing deterministic model structure and traversal rules rooted at the Mission card.",
