      ],
      "name": "Deterministic Architectural Language"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora card files SHALL be stored as strict JSON (RFC 8259) using the .jsjson extension: double quotes, no comments, no trailing commas, UTF-8 encoding, and exactly one trailing newline.",
      "id": "REQ-016",
      "links": [],
      "name": "Strict JSJSON Card Encoding"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora models SHALL be machine-validatable for integrity: every non-Mission, non-Note card SHALL have at least one incoming link; every card SHALL be reachable from the Mission; and all links[].target values SHALL reference an existing card id.",
      "id": "REQ-025",
      "links": [],
      "name": "Model Integrity Validation"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Boundary cards SHALL be used to group related cards for rendering and navigation; they may have a subtype such as End to limit recursion. Note cards SHALL be used only as annotative leaves (incoming links only) and SHALL NOT introduce new structural model elements.",
      "id": "REQ-020",
      "links": [],
      "name": "Boundary and Note Semantics"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora tooling and documentation SHALL use a canonical registry of card types (and optional subtypes) to support consistent rendering, validation, and communication across tools.",
      "id": "REQ-021",
      "links": [],
      "name": "Canonical Card Registry"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora cards SHALL use stable identifiers (e.g., MIS-001) that MUST NOT change once issued. Card files SHALL be named <id>-<Sanitized_Name>.jsjson, where special characters are stripped and spaces are replaced with underscores. Models SHALL follow the Model Home and Mission folder layout conventions so tools can discover, validate, and render deterministically.",
      "id": "REQ-017",
      "links": [],
      "name": "Identifiers, Filenames, and Model Layout"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora card and relationship labels SHALL be treated as descriptive metadata; the meaning of the architecture SHALL be derived from the model’s invariant rules and the current view’s inclusion/projection of card types and links.",
      "id": "REQ-028",
      "links": [],
      "name": "Semantics Derived from Invariants"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora tooling and documentation SHALL use a canonical registry of view definitions that declare which card types are included and what root types anchor each view.",
      "id": "REQ-023",
      "links": [],
      "name": "Canonical View Registry"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Each Aurora model SHALL start with exactly one Mission card that serves as the root of the directed graph. The Mission card SHALL only have outgoing links and SHALL provide a consistent starting point for traversal and view generation.",
      "id": "REQ-018",
      "links": [],
      "name": "Single Root Mission"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Views SHALL be treated as projections of a single underlying model graph by selecting a set of card types (and optional subtypes) and rendering only those cards and the links between them; views SHALL NOT change the underlying model.",
      "id": "REQ-026",
      "links": [],
      "name": "Views as Projections"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "All Aurora links SHALL lead away from the Mission card. Local cycles MAY exist within bounded subgraphs (for example state machines) as long as no link creates a path back to the Mission.",
      "id": "REQ-019",
      "links": [],
      "name": "Directed Graph with Local Cycles"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "Aurora tooling and documentation SHALL use a canonical registry of relationship verbs, including allowed source and target card types, to enable deterministic validation and interoperable views.",
      "id": "REQ-022",
      "links": [],
      "name": "Canonical Relationship Registry"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "All Aurora cards SHALL include an audit_trail with a per-card SemVer version, an optional SHA256 hash (nullable), and a chronological history of created/edited/deleted events including editor identity and RFC3339 timestamps.",
      "id": "REQ-027",
      "links": [],
      "name": "Audit Trail and Versioning"
    },
    {
      "attributes": null,
      "card_type": "Requirement",
      "description": "All Aurora card files SHALL include a $schema field referencing the applicable Aurora schema using a relative path from the card file to the Model Home schema file.",
      "id": "REQ-024",
      "links": [],
      "name": "Schema Referencing Rules"
    },
    {
      "attributes": null,
      "card_type": "Artifact",
      "description": "The canonical registry that defines standard Aurora views (roots and included card types) used by tooling as convenient default projections of the model.",
      "id": "ART-010",
      "links": [],
      "name": "Canonical View Definitions"
    },
    {
      "attributes": null,
      "card_type": "Artifact",
      "description": "The canonical registry that defines relationship verbs and their allowed source/target card types to enable deterministic validation and consistent view semantics.",
      "id": "ART-009",
      "links": [],
      "name": "Canonical Relationship Definitions"
    },
    {
      "attributes": null,
      "card_type": "Artifact",
      "description": "The canonical JSON Schema that defines compact, agent-friendly exports (AGENT-<MISSION_ID>.jsjson) which omit audit_trail and store cards in a top-level array. In this repository it is stored at docs/design/aurora/Aurora.compact.schema.jsjson.",
      "id": "ART-007",
      "links": [],
      "name": "Aurora Compact Schema"
    },
    {
      "attributes": null,
      "card_type": "Artifact",
      "description": "The canonical registry that defines the Aurora card palette (card types, acronyms, shapes, and typical usage) for validation and rendering.",
      "id": "ART-008",
      "links": [],
      "name": "Canonical Card Definitions"
    },
    {
      "attributes": null,
      "card_type": "Artifact",
      "description": "The canonical JSON Schema that defines the required structure for full Aurora card files (including audit_trail). In this repository it is stored at docs/design/aurora/Aurora.schema.jsjson.",
      "id": "ART-006",
      "links": [],
      "name": "Aurora Card Schema"
    }
