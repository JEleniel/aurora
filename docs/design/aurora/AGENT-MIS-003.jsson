{
  "$schema": "Aurora.compact.schema.json",
  "cards": [
    {
      "attributes": {
        "tool": {
          "name": "aurora_vscode_extension",
          "tool_path": "tools/aurora_vscode_extension/",
          "default_input": {
            "model_root": "docs/design/aurora/"
          },
          "default_output": {
            "aggregate_index_readme": "docs/design/README.md",
            "per_mission_root": "docs/design/{MissionId}/",
            "per_mission_cards_root": "docs/design/{MissionId}/cards/",
            "per_mission_views_root": "docs/design/{MissionId}/views/",
            "per_mission_index_readme": "docs/design/{MissionId}/README-{MissionId}.md",
            "per_mission_compact_model": "docs/design/aurora/AGENT-{MissionId}.json"
          }
        }
      },
      "card_type": "Mission",
      "description": "Enable the integration of Aurora, Aurora modeling, and Copilot assistance with managing Aurora models in VSCode.",
      "id": "MIS-003",
      "links": [
        {
          "relationship": "establishes",
          "target": "DRI-001"
        },
        {
          "relationship": "establishes",
          "target": "DRI-002"
        },
        {
          "relationship": "establishes",
          "target": "DRI-003"
        },
        {
          "relationship": "establishes",
          "target": "DRI-004"
        },
        {
          "relationship": "establishes",
          "target": "DRI-005"
        },
        {
          "relationship": "involves",
          "target": "ACT-001"
        },
        {
          "relationship": "involves",
          "target": "ACT-002"
        },
        {
          "relationship": "necessitates",
          "target": "APP-001"
        },
        {
          "relationship": "necessitates",
          "target": "REQ-001"
        },
        {
          "relationship": "necessitates",
          "target": "REQ-002"
        },
        {
          "relationship": "necessitates",
          "target": "REQ-003"
        },
        {
          "relationship": "necessitates",
          "target": "REQ-004"
        },
        {
          "relationship": "necessitates",
          "target": "REQ-005"
        }
      ],
      "name": "Enable VSCode and Copilot Integration"
    },
    {
      "card_type": "Driver",
      "description": "Enable developers and developer agents to directly access the model in the same tooling they are using to develop.",
      "id": "DRI-003",
      "links": [
        {
          "relationship": "drives",
          "target": "REQ-003"
        }
      ],
      "name": "Give Developers Access to the Model"
    },
    {
      "card_type": "Requirement",
      "description": "Based on mind-map and multidimensional browser UIs, present a visual network view along with an editor view for humans to navigate and edit cards.",
      "id": "REQ-002",
      "name": "Present Flexible Modeling Interface"
    },
    {
      "card_type": "Driver",
      "description": "Ensure that the model is in a valid state that obeys the invariants at all times.",
      "id": "DRI-005",
      "links": [
        {
          "relationship": "drives",
          "target": "REQ-001"
        },
        {
          "relationship": "drives",
          "target": "REQ-004"
        }
      ],
      "name": "Maintain Model Integrity"
    },
    {
      "card_type": "Actor",
      "description": "An AI agent (for example, Copilot) collaborating with a user to build and maintain an Aurora model.",
      "id": "ACT-002",
      "links": [
        {
          "relationship": "desires",
          "target": "STR-001"
        }
      ],
      "name": "Agent"
    },
    {
      "card_type": "Story",
      "description": "Improve the response time of the agent when editing the model and eliminate manual steps.",
      "id": "STR-002",
      "links": [
        {
          "relationship": "explains",
          "target": "REQ-005"
        }
      ],
      "name": "Improve Model Response"
    },
    {
      "card_type": "Application",
      "description": "A VS Code extension that enables browsing, editing, and agent-assisted interaction with Aurora models inside VS Code.",
      "id": "APP-001",
      "links": [
        {
          "relationship": "comprises",
          "target": "COM-001"
        },
        {
          "relationship": "comprises",
          "target": "COM-002"
        },
        {
          "relationship": "comprises",
          "target": "COM-003"
        },
        {
          "relationship": "comprises",
          "target": "COM-004"
        }
      ],
      "name": "Aurora VSCode Extension"
    },
    {
      "card_type": "Component",
      "description": "Local MCP server component hosted by the extension to expose model operations and events to agents.",
      "id": "COM-002",
      "name": "MCP Server"
    },
    {
      "card_type": "Requirement",
      "description": "Enable, through a shared store, multi-user, multi-thread access to the model with conflict prevention and transactional integrity.",
      "id": "REQ-003",
      "links": [
        {
          "relationship": "necessitates",
          "target": "REQ-003"
        }
      ],
      "name": "Enable Access to the Shared Model(s)"
    },
    {
      "card_type": "Requirement",
      "description": "When writing the model to JSON, ensure that it is linted and formatted automatically.",
      "id": "REQ-005",
      "links": [
        {
          "relationship": "necessitates",
          "target": "REQ-003"
        }
      ],
      "name": "Lint and Format on Write"
    },
    {
      "card_type": "Driver",
      "description": "Remove the concerns about files, formatting, linting, etc. from the agent and into the tooling.",
      "id": "DRI-004",
      "links": [
        {
          "relationship": "drives",
          "target": "REQ-001"
        },
        {
          "relationship": "drives",
          "target": "REQ-004"
        },
        {
          "relationship": "drives",
          "target": "REQ-005"
        }
      ],
      "name": "Simplify Agent Workflow"
    },
    {
      "card_type": "Driver",
      "description": "Enable modeling and viewing in the same tool frequently used for implementation.",
      "id": "DRI-002",
      "links": [
        {
          "relationship": "drives",
          "target": "REQ-002"
        }
      ],
      "name": "Enable Modeling in VSCode"
    },
    {
      "card_type": "Driver",
      "description": "Enable Copilot to interact with an Aurora model isolated from the storage and file format to enable use in locked down environments.",
      "id": "DRI-001",
      "links": [
        {
          "relationship": "drives",
          "target": "REQ-001"
        }
      ],
      "name": "Enable Direct Copilot Assistance"
    },
    {
      "card_type": "Component",
      "description": "Language server component that provides validation feedback, navigation, and editor assistance for Aurora model content in VS Code.",
      "id": "COM-003",
      "name": "VSCode Language Server"
    },
    {
      "card_type": "Component",
      "description": "Core library that loads, validates, queries, and updates Aurora model cards and relationships for use by the VS Code extension.",
      "id": "COM-001",
      "name": "Aurora Model Library"
    },
    {
      "card_type": "Requirement",
      "description": "Expose a local (to the extension) MCP interface for agent use.",
      "id": "REQ-001",
      "links": [
        {
          "relationship": "necessitates",
          "target": "REQ-003"
        }
      ],
      "name": "Present an MCP Interface"
    },
    {
      "card_type": "Component",
      "description": "UI surfaces inside VS Code (views, webviews, panels) that let users browse, edit, and visualize Aurora models.",
      "id": "COM-004",
      "name": "VSCode Extension UI"
    },
    {
      "card_type": "Story",
      "description": "A user can actively collaborate with one or more agents to build and maintain an Aurora model.",
      "id": "STR-001",
      "links": [
        {
          "relationship": "explains",
          "target": "REQ-001"
        },
        {
          "relationship": "explains",
          "target": "REQ-002"
        }
      ],
      "name": "Collaborate"
    },
    {
      "card_type": "Requirement",
      "description": "With any change requested, verify that it will not break model validity and reject those that would.",
      "id": "REQ-004",
      "links": [
        {
          "relationship": "necessitates",
          "target": "REQ-003"
        }
      ],
      "name": "Ensure Model Integrity"
    },
    {
      "card_type": "Actor",
      "description": "A human using VS Code to build and maintain an Aurora model.",
      "id": "ACT-001",
      "links": [
        {
          "relationship": "desires",
          "target": "STR-001"
        },
        {
          "relationship": "desires",
          "target": "STR-002"
        }
      ],
      "name": "User"
    }
  ]
}