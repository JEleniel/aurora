digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				STA_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>State</B><BR/>
				<B>Reference State</B><BR/>
				<BR/>
				State that transitions to another state in the relationship-matrix reference mod<BR/>el.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_State.view.svg";
			style=filled;
			fillcolor="#701a75";
			svg_shape="circle";
			icon="dot";
		];
		STM_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>State Machine</B><BR/>
				<B>Reference State Machine</B><BR/>
				<BR/>
				State machine that starts in a defined initial state.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_State_Machine.view.svg";
			style=filled;
			fillcolor="#4a044e";
			svg_shape="octagon";
			icon="timeline";
		];
		STA_002[
			label=<
				<FONT COLOR="#FFFFFF"><B>State</B><BR/>
				<B>Secondary State</B><BR/>
				<BR/>
				Secondary state used as a target of State/Condition transitions in the reference<BR/> model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Secondary_State.view.svg";
			style=filled;
			fillcolor="#701a75";
			svg_shape="circle";
			icon="dot";
		];
			STA_001 -> STA_002 [label="transitions to"];
									STM_001 -> STA_001 [label="starts in"];
								}