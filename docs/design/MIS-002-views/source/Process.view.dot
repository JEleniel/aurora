digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				PRO_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>Process</B><BR/>
				<B>Reference Process</B><BR/>
				<BR/>
				Process necessitated by a capability in the relationship-matrix reference model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_Process.view.svg";
			style=filled;
			fillcolor="#2e1065";
			svg_shape="box";
			icon="workflow";
		];
		CAP_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Reference Capability</B><BR/>
				<BR/>
				Capability used to satisfy a requirement and necessitate a process.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_Capability.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
			CAP_001 -> PRO_001 [label="necessitates"];
									CAP_001 -> REQ_001 [label="satisfies"];
								}