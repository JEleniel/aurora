digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				ACT_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>Actor</B><BR/>
				<B>Reference Actor</B><BR/>
				<BR/>
				Actor exercising desire/own/perform/present relationships in the reference model<BR/>.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_Actor.view.svg";
			style=filled;
			fillcolor="#1a2e05";
			svg_shape="ellipse";
			icon="user";
		];
		STR_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>Story</B><BR/>
				<B>Reference Story</B><BR/>
				<BR/>
				Story desired by an actor and implying a constraint in the reference model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_Story.view.svg";
			style=filled;
			fillcolor="#365314";
			svg_shape="box";
			icon="book";
		];
		ACT_002[
			label=<
				<FONT COLOR="#FFFFFF"><B>Actor</B><BR/>
				<B>Triggered Actor</B><BR/>
				<BR/>
				Secondary actor involved in the relationship-matrix reference model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Triggered_Actor.view.svg";
			style=filled;
			fillcolor="#1a2e05";
			svg_shape="ellipse";
			icon="user";
		];
		CNS_001[
			label=<
				<FONT COLOR="#FFFFFF"><B>Constraint</B><BR/>
				<B>Reference Constraint</B><BR/>
				<BR/>
				Constraint implied by a story in the relationship-matrix reference model.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-002-views/Reference_Constraint.view.svg";
			style=filled;
			fillcolor="#082f49";
			svg_shape="box";
			icon="ruler";
		];
			ACT_001 -> STR_001 [label="desires"];
									ACT_001 -> AST_001 [label="owns"];
									ACT_001 -> ATV_001 [label="performs"];
									ACT_001 -> THR_001 [label="presents"];
									ACT_001 -> THR_002 [label="presents"];
									STR_001 -> CNS_001 [label="implies"];
								}