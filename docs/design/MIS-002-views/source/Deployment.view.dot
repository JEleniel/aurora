digraph {
	fontname="Noto Sans";
	fontcolor="#FFFFFF";
	fontsize=12.0;
	COM_001[
		label=<<FONT COLOR="#FFFFFF"><B>Component</B><BR/><B>Reference Component</B><BR/><BR/>Component used to exercise interface invocation, artifact generation, feature im<BR/>plementation, test fulfillment, class realization, control enforcement, and stat<BR/>e machine execution.<BR/></FONT>>
		height=1.0;
		width=1.6;
		href="../MIS-002-views/Reference_Component.view.svg";
		style=filled;
		fillcolor="#1e40af";
		svg_shape="component";
		icon="cube";
	];
	NOD_001[
		label=<<FONT COLOR="#FFFFFF"><B>Node</B><BR/><B>Reference Node</B><BR/><BR/>Node that hosts a component and data store and instantiates a node instance.<BR/></FONT>>
		height=1.0;
		width=1.6;
		href="../MIS-002-views/Reference_Node.view.svg";
		style=filled;
		fillcolor="#312e81";
		svg_shape="double-box";
		icon="server";
	];
	DEP_001[
		label=<<FONT COLOR="#FFFFFF"><B>Deployment</B><BR/><B>Reference Deployment</B><BR/><BR/>Deployment that provisions a node in the relationship-matrix reference model.<BR/></FONT>>
		height=1.0;
		width=1.6;
		href="../MIS-002-views/Reference_Deployment.view.svg";
		style=filled;
		fillcolor="#1e1b4b";
		svg_shape="deployment";
		icon="cloud";
	];
	COM_001 -> INT_001 [label="invokes"];
	COM_001 -> ART_001 [label="generates"];
	COM_001 -> FEA_001 [label="implements"];
	COM_001 -> TES_001 [label="fulfills"];
	COM_001 -> CLS_001 [label="realizes"];
	COM_001 -> CTL_001 [label="enforces"];
	COM_001 -> STM_001 [label="executes"];
	NOD_001 -> COM_001 [label="hosts"];
	NOD_001 -> DTS_001 [label="hosts"];
	NOD_001 -> NIN_001 [label="instantiates"];
	DEP_001 -> NOD_001 [label="provisions"];
}