digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				CAP_013[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Markdown Preview and Audit View</B><BR/>
				<BR/>
				Ability to render the focused card as a readable Markdown-style document with li<BR/>nk list, and to inspect audit trail history.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Markdown_Preview_and_Audit_View.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_011[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Context Graph Visualization</B><BR/>
				<BR/>
				Ability to visualize a local subgraph around the focused card (including parent,<BR/> siblings, and children) and navigate by clicking nodes.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Context_Graph_Visualization.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_014[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>aurora_shared Integration</B><BR/>
				<BR/>
				Ability to reuse aurora_shared for model discovery/loading, validation, renderin<BR/>g, and file layout conventions to keep editor behavior consistent with CLI tooli<BR/>ng.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/aurora_shared_Integration.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_012[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Interactive Card Editing</B><BR/>
				<BR/>
				Ability to edit card fields and links interactively while maintaining model inva<BR/>riants and persisting changes safely.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Interactive_Card_Editing.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_009[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Desktop UI Shell</B><BR/>
				<BR/>
				Ability to present a desktop application UI with a stable three-pane layout and <BR/>shared selection state.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Desktop_UI_Shell.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
		CAP_010[
			label=<
				<FONT COLOR="#FFFFFF"><B>Capability</B><BR/>
				<B>Navigation and Focus Management</B><BR/>
				<BR/>
				Ability to navigate the model by card id and keep the focused card synchronized <BR/>across panes.<BR/></FONT>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Navigation_and_Focus_Management.view.svg";
			style=filled;
			fillcolor="#052e16";
			svg_shape="rounded-rectangle";
			icon="spark";
		];
			CAP_013 -> REQ_012 [label="satisfies"];
									CAP_011 -> REQ_011 [label="satisfies"];
									CAP_014 -> REQ_014 [label="satisfies"];
									CAP_012 -> REQ_015 [label="satisfies"];
									CAP_009 -> REQ_009 [label="satisfies"];
									CAP_009 -> REQ_013 [label="satisfies"];
									CAP_010 -> REQ_010 [label="satisfies"];
								}