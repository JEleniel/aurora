digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				REQ_015[
			label=<
				<B>Requirement</B><BR/>
				<B>Safe Workspace Persistence</B><BR/>
				<BR/>
				The editor SHALL persist edits to model files in a safe manner that avoids parti<BR/>al writes and preserves schema validity (e.g., atomic replace per card file).<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Safe_Workspace_Persistence.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		DRI_004[
			label=<
				<B>Driver</B><BR/>
				<B>Visual Model Authoring</B><BR/>
				<BR/>
				Enable rapid comprehension and editing of an Aurora model through a visual, mult<BR/>i-pane editor that reduces cognitive load and navigation friction.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Visual_Model_Authoring.view.svg";
			style=filled;
			fillcolor="#064e3b";
			svg_shape="rounded-rectangle";
			icon="compass";
		];
		REQ_010[
			label=<
				<B>Requirement</B><BR/>
				<B>Shortest Path Tree Navigation</B><BR/>
				<BR/>
				The editor SHALL provide a left-pane tree view for navigation, where the tree is<BR/> derived from a chosen shortest path from the mission root to each card.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Shortest_Path_Tree_Navigation.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_009[
			label=<
				<B>Requirement</B><BR/>
				<B>Three Pane Layout</B><BR/>
				<BR/>
				The editor SHALL present a three-pane layout (similar to Visual Studio or Obsidi<BR/>an): left navigation tree, central graph view, and right inspector.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Three_Pane_Layout.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		DRI_005[
			label=<
				<B>Driver</B><BR/>
				<B>Reuse Shared Aurora Semantics</B><BR/>
				<BR/>
				Minimize duplicated logic and inconsistencies across tooling surfaces by reusing<BR/> the aurora_shared library for model discovery, parsing, validation, and renderi<BR/>ng.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Reuse_Shared_Aurora_Semantics.view.svg";
			style=filled;
			fillcolor="#064e3b";
			svg_shape="rounded-rectangle";
			icon="compass";
		];
		MIS_004[
			label=<
				<B>Mission</B><BR/>
				<B>Standalone Editor</B><BR/>
				<BR/>
				Provide a standalone application capable of creating and manipulating Aurora mod<BR/>els visually, reusing the aurora_shared library to facilitate development.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Standalone_Editor.view.svg";
			style=filled;
			fillcolor="#022c22";
			svg_shape="octagon";
			icon="target";
		];
		SYS_003[
			label=<
				<B>System</B><BR/>
				<B>Aurora Standalone Editor System</B><BR/>
				<BR/>
				Bounded system that provides a desktop UI for exploring and editing Aurora model<BR/>s with a three-pane workflow (navigation, graph context, inspector).<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Aurora_Standalone_Editor_System.view.svg";
			style=filled;
			fillcolor="#172554";
			svg_shape="folder";
			icon="layers";
		];
		REQ_013[
			label=<
				<B>Requirement</B><BR/>
				<B>Dioxus UI</B><BR/>
				<BR/>
				The standalone editor SHOULD be implemented using Dioxus as the primary UI libra<BR/>ry.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Dioxus_UI.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_014[
			label=<
				<B>Requirement</B><BR/>
				<B>Reuse aurora_shared</B><BR/>
				<BR/>
				The editor SHALL reuse aurora_shared for model discovery/loading and validation/<BR/>rendering semantics to stay consistent with other Aurora tooling.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Reuse_aurora_shared.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_012[
			label=<
				<B>Requirement</B><BR/>
				<B>Edit, Preview, and Audit Inspector</B><BR/>
				<BR/>
				The editor SHALL provide a right-pane inspector: the top half edits the focused <BR/>card; the bottom half renders a Markdown-style view of the card (including links<BR/>). The bottom half SHALL provide a tab to reveal the card’s audit trail details.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Edit,_Preview,_and_Audit_Inspector.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_011[
			label=<
				<B>Requirement</B><BR/>
				<B>Brain Style Graph Navigation</B><BR/>
				<BR/>
				The editor SHALL provide a central mind-map / TheBrain style view with the focus<BR/>ed card centered. The view SHALL show the parent (from the chosen shortest-path <BR/>chain), and MAY show siblings (same card_type) linked from that parent even if t<BR/>hey are not linked to the focused card.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-004-views/Brain_Style_Graph_Navigation.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
			DRI_004 -> REQ_009 [label="drives"];
									DRI_004 -> REQ_010 [label="drives"];
									DRI_004 -> REQ_011 [label="drives"];
									DRI_004 -> REQ_012 [label="drives"];
									DRI_004 -> REQ_015 [label="drives"];
									DRI_005 -> REQ_013 [label="drives"];
									DRI_005 -> REQ_014 [label="drives"];
									MIS_004 -> DRI_004 [label="establishes"];
									MIS_004 -> DRI_005 [label="establishes"];
									MIS_004 -> ACT_004 [label="involves"];
									MIS_004 -> SYS_003 [label="requires"];
									SYS_003 -> APP_004 [label="integrates"];
								}