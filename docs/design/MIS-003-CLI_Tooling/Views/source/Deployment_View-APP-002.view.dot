digraph "Deployment (APP-002)" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Application</B><BR/><B>APP-002</B><BR/>&#160;<BR/>aurora_cli — Command-line interface that discovers<BR/>Aurora model homes, validates mission-scoped models,<BR/>renders Markdown + SVG views, and writes compact agent<BR/>exports.</FONT></TD></TR></TABLE>>, shape="component"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-002</B><BR/>&#160;<BR/>CLI Command Runner — CLI entrypoint and command<BR/>dispatcher (clap subcommands) that orchestrates<BR/>discovery, validation, rendering, and compact export<BR/>workflows and reports diagnostics and summaries.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"APP-002" -> "COM-002" [label="composes"];
}