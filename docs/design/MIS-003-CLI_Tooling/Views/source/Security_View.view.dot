digraph "Security" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-003" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-003</B><BR/>&#160;<BR/>Architect — Human operator responsible for authoring<BR/>Aurora models and running CLI tooling (validate, render,<BR/>compact) to maintain deterministic design artifacts.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-002</B><BR/>&#160;<BR/>CLI Command Runner — CLI entrypoint and command<BR/>dispatcher (clap subcommands) that orchestrates<BR/>discovery, validation, rendering, and compact export<BR/>workflows and reports diagnostics and summaries.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-003</B><BR/>&#160;<BR/>Model Discovery and Loading — Discovery and parsing<BR/>layer that locates model homes (schema-based), loads<BR/>card files (JSON/JSJSON) from disk, and builds a<BR/>searchable AuroraModel index.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-004</B><BR/>&#160;<BR/>Validation Engine — Validator that checks structural<BR/>invariants (duplicate ids, mission presence, link<BR/>targets, reachability) plus policy checks (secret asset<BR/>ownership) and relationship-matrix compliance using<BR/>embedded registries.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-005</B><BR/>&#160;<BR/>Rendering Engine — Renderer that produces per-card<BR/>Markdown documentation, executive summaries, canonical<BR/>view DOT sources, and themed SVG diagrams; also writes<BR/>compact agent exports.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-006</B><BR/>&#160;<BR/>Embedded Registries — Compile-time canonical<BR/>registries for card definitions (palette), relationship<BR/>definitions (matrix rules), and view definitions<BR/>(canonical view set) used by validation and rendering.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"INT-002" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-002</B><BR/>&#160;<BR/>Graphviz DOT Renderer — External executable interface<BR/>for rendering Graphviz DOT into a layout used to<BR/>generate themed SVG views (default: 'dot', override via<BR/>AURORA_DOT_COMMAND).</FONT></TD></TR></TABLE>>, shape="note"];
	"COM-005" -> "INT-002" [label="invokes"];
	subgraph "cluster_BND-002" {
		graph [color="#000000", label="Local Workspace (BND-002)", penwidth="4", style="dashed"];
		"INT-002";
	}
}