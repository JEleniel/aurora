digraph "Class" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-002" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Application</B><BR/><B>APP-002</B><BR/>&#160;<BR/>aurora_cli — Command-line interface that discovers<BR/>Aurora model homes, validates mission-scoped models,<BR/>renders Markdown + SVG views, and writes compact agent<BR/>exports.</FONT></TD></TR></TABLE>>, shape="component"];
	"APP-003" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Application</B><BR/><B>APP-003</B><BR/>&#160;<BR/>aurora_shared — Shared domain library that implements<BR/>model discovery, parsing, validation, rendering, and<BR/>compact export helpers for Aurora tooling surfaces.</FONT></TD></TR></TABLE>>, shape="component"];
	"ART-002" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Artifact</B><BR/><B>ART-002</B><BR/>&#160;<BR/>Rendered Markdown Documentation — Per-card Markdown<BR/>files and mission executive summary emitted by the<BR/>renderer into docs/design/&lt;MISSION_NAME&gt;/...</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-003" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Artifact</B><BR/><B>ART-003</B><BR/>&#160;<BR/>Rendered View Diagrams — Canonical view outputs<BR/>emitted under Views/: DOT sources under Views/source and<BR/>themed SVG diagrams under Views/.</FONT></TD></TR></TABLE>>, shape="tab"];
	"ART-004" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Artifact</B><BR/><B>ART-004</B><BR/>&#160;<BR/>Compact Agent Export — Single-file compact model<BR/>export emitted as AGENT-&lt;MISSION_ID&gt;.jsjson (default<BR/>location: model home root).</FONT></TD></TR></TABLE>>, shape="tab"];
	"COM-002" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-002</B><BR/>&#160;<BR/>CLI Command Runner — CLI entrypoint and command<BR/>dispatcher (clap subcommands) that orchestrates<BR/>discovery, validation, rendering, and compact export<BR/>workflows and reports diagnostics and summaries.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-003" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-003</B><BR/>&#160;<BR/>Model Discovery and Loading — Discovery and parsing<BR/>layer that locates model homes (schema-based), loads<BR/>card files (JSON/JSJSON) from disk, and builds a<BR/>searchable AuroraModel index.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-004" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-004</B><BR/>&#160;<BR/>Validation Engine — Validator that checks structural<BR/>invariants (duplicate ids, mission presence, link<BR/>targets, reachability) plus policy checks (secret asset<BR/>ownership) and relationship-matrix compliance using<BR/>embedded registries.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-005" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-005</B><BR/>&#160;<BR/>Rendering Engine — Renderer that produces per-card<BR/>Markdown documentation, executive summaries, canonical<BR/>view DOT sources, and themed SVG diagrams; also writes<BR/>compact agent exports.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-006" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-006</B><BR/>&#160;<BR/>Embedded Registries — Compile-time canonical<BR/>registries for card definitions (palette), relationship<BR/>definitions (matrix rules), and view definitions<BR/>(canonical view set) used by validation and rendering.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"DTS-002" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Data Store</B><BR/><B>DTS-002</B><BR/>&#160;<BR/>Repository File System — Filesystem-backed store that<BR/>holds Aurora source cards (docs/design/aurora/),<BR/>rendered artifacts (docs/design/*), and compact exports<BR/>(AGENT-*.jsjson).</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"FEA-002" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-002</B><BR/>&#160;<BR/>Validate Models — Validate one or more mission-scoped<BR/>models (discovered from an input path) and emit<BR/>diagnostics; fail the command if errors are present.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-003" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-003</B><BR/>&#160;<BR/>Render Card Markdown — Render per-card Markdown<BR/>documentation plus a mission executive summary into a<BR/>chosen output directory.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-004" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-004</B><BR/>&#160;<BR/>Render View Diagrams — Render canonical Aurora views<BR/>by writing DOT sources under Views/source and generating<BR/>themed SVG diagrams under Views/.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-005" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-005</B><BR/>&#160;<BR/>Render All Artifacts — Render both card Markdown and<BR/>view diagrams for each mission-scoped model into the<BR/>chosen output directory.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-006" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-006</B><BR/>&#160;<BR/>Write Compact Export — Write a compact, single-file<BR/>mission snapshot (AGENT-&lt;MISSION_ID&gt;.jsjson by default)<BR/>for agent consumption.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-007" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-007</B><BR/>&#160;<BR/>Bump Audit Versions — Bump model audit trail versions<BR/>(patch/minor/major). This feature is currently exposed<BR/>as CLI commands but is not implemented yet.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-008" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-008</B><BR/>&#160;<BR/>Discover and Load Models — Discover model homes from<BR/>an input path and load cards from disk into a<BR/>mission-splittable AuroraModel structure.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-009" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-009</B><BR/>&#160;<BR/>Embedded Canonical Registries — Provide embedded<BR/>registries for card definitions, relationship<BR/>definitions, and view definitions for deterministic<BR/>validation and rendering.</FONT></TD></TR></TABLE>>, shape="box"];
	"INT-002" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-002</B><BR/>&#160;<BR/>Graphviz DOT Renderer — External executable interface<BR/>for rendering Graphviz DOT into a layout used to<BR/>generate themed SVG views (default: 'dot', override via<BR/>AURORA_DOT_COMMAND).</FONT></TD></TR></TABLE>>, shape="note"];
	"APP-002" -> "COM-002" [label="composes"];
	"APP-003" -> "COM-003" [label="composes"];
	"APP-003" -> "COM-004" [label="composes"];
	"APP-003" -> "COM-005" [label="composes"];
	"APP-003" -> "COM-006" [label="composes"];
	"ART-002" -> "DTS-002" [label="persists"];
	"ART-003" -> "DTS-002" [label="persists"];
	"ART-004" -> "DTS-002" [label="persists"];
	"COM-002" -> "FEA-002" [label="implements"];
	"COM-002" -> "FEA-003" [label="implements"];
	"COM-002" -> "FEA-004" [label="implements"];
	"COM-002" -> "FEA-005" [label="implements"];
	"COM-002" -> "FEA-006" [label="implements"];
	"COM-002" -> "FEA-007" [label="implements"];
	"COM-003" -> "FEA-008" [label="implements"];
	"COM-004" -> "FEA-002" [label="implements"];
	"COM-005" -> "ART-002" [label="generates"];
	"COM-005" -> "ART-003" [label="generates"];
	"COM-005" -> "ART-004" [label="generates"];
	"COM-005" -> "FEA-003" [label="implements"];
	"COM-005" -> "FEA-004" [label="implements"];
	"COM-005" -> "FEA-005" [label="implements"];
	"COM-005" -> "FEA-006" [label="implements"];
	"COM-005" -> "INT-002" [label="invokes"];
	"COM-006" -> "FEA-009" [label="implements"];
	subgraph "cluster_BND-002" {
		graph [color="#000000", label="Local Workspace (BND-002)", penwidth="4", style="dashed"];
		"DTS-002";
		"INT-002";
	}
}