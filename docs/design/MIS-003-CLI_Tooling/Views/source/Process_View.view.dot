digraph "Process" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"CAP-002" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-002</B><BR/>&#160;<BR/>Model Discovery and Loading — Ability to locate Aurora<BR/>model homes from a user-provided path and load all card<BR/>JSON/JSJSON files into an indexed in-memory model.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-003" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-003</B><BR/>&#160;<BR/>Model Validation — Ability to validate Aurora model<BR/>invariants and provide actionable diagnostics before any<BR/>downstream rendering/export steps.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-004" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-004</B><BR/>&#160;<BR/>Markdown Rendering — Ability to render human-readable<BR/>Markdown documentation for every card plus a<BR/>mission-level executive summary.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-005" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-005</B><BR/>&#160;<BR/>View Rendering — Ability to render canonical Aurora<BR/>views by generating DOT sources and producing SVG<BR/>diagrams using a Graphviz-compatible renderer.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-006" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-006</B><BR/>&#160;<BR/>Compact Agent Export — Ability to write a compact,<BR/>single-file snapshot of a mission-scoped model for agent<BR/>consumption.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-007" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-007</B><BR/>&#160;<BR/>Audit Version Bumping — Ability to update card audit<BR/>trail versions (patch/minor/major) and append an audit<BR/>event in a deterministic, tool-driven manner.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-008" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-008</B><BR/>&#160;<BR/>Registry Backed Tooling — Ability to validate and<BR/>render using embedded canonical registries for card<BR/>definitions, relationship rules, and view<BR/>specifications.</FONT></TD></TR></TABLE>>, shape="box"];
}