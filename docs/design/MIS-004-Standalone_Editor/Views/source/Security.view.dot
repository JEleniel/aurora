digraph "Security" {
	graph [bgcolor="#FFFFFF", fontname="Inter", nodesep="0.2", rankdir="LR", ranksep="0.3", splines="curved"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-004" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-004</B><BR/>&#160;<BR/>Model Author — Human operator responsible for<BR/>navigating, editing, and validating Aurora models within<BR/>the standalone editor.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-007</B><BR/>&#160;<BR/>Dioxus App Shell — Top-level Dioxus component that<BR/>owns the UI shell layout and routes focus/selection<BR/>changes between panes.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-008</B><BR/>&#160;<BR/>Explorer Tree Pane — Left navigation pane that<BR/>presents a tree view derived from shortest paths from<BR/>the mission root, enabling fast card discovery and focus<BR/>changes.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-009</B><BR/>&#160;<BR/>Brain Graph Pane — Central pane that renders a<BR/>mind-map / TheBrain-style context graph with the focused<BR/>card centered and related cards positioned by<BR/>relationship role.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-010</B><BR/>&#160;<BR/>Inspector Pane — Right pane that splits vertically:<BR/>top half edits the focused card; bottom half shows a<BR/>rendered Markdown-style preview (and links) with a tab<BR/>to reveal audit details.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-011</B><BR/>&#160;<BR/>Model Session and Persistence — In-memory model<BR/>session that loads a workspace model home, computes<BR/>shortest paths, validates changes, and persists updated<BR/>card files using aurora_shared semantics.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"INT-003" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-003</B><BR/>&#160;<BR/>Dioxus UI Framework API — UI framework interface used<BR/>to declare layouts, render widgets, and process user<BR/>events for the standalone editor.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-004" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-004</B><BR/>&#160;<BR/>aurora_shared Domain API — Public domain interface<BR/>(Rust API) for discovering model homes, loading cards,<BR/>validating invariants, and rendering Markdown-style<BR/>representations.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-005" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-005</B><BR/>&#160;<BR/>Local Filesystem API — Contract for reading and<BR/>writing Aurora model files on the local filesystem<BR/>(open, read, write, atomic replace, and directory<BR/>enumeration).</FONT></TD></TR></TABLE>>, shape="note"];
	"COM-007" -> "INT-003" [label="invokes"];
	"COM-011" -> "INT-004" [label="invokes"];
	"COM-011" -> "INT-005" [label="invokes"];
}