digraph "Requirements" {
	graph [bgcolor="#FFFFFF", fontname="Inter", nodesep="0.2", rankdir="LR", ranksep="0.3", splines="curved"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-009</B><BR/>&#160;<BR/>Desktop UI Shell — Ability to present a desktop<BR/>application UI with a stable three-pane layout and<BR/>shared selection state.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-010" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-010</B><BR/>&#160;<BR/>Navigation and Focus Management — Ability to navigate<BR/>the model by card id and keep the focused card<BR/>synchronized across panes.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-011" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-011</B><BR/>&#160;<BR/>Context Graph Visualization — Ability to visualize a<BR/>local subgraph around the focused card (including<BR/>parent, siblings, and children) and navigate by clicking<BR/>nodes.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-012" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-012</B><BR/>&#160;<BR/>Interactive Card Editing — Ability to edit card fields<BR/>and links interactively while maintaining model<BR/>invariants and persisting changes safely.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-013" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-013</B><BR/>&#160;<BR/>Markdown Preview and Audit View — Ability to render<BR/>the focused card as a readable Markdown-style document<BR/>with link list, and to inspect audit trail history.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-014" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-014</B><BR/>&#160;<BR/>aurora_shared Integration — Ability to reuse<BR/>aurora_shared for model discovery/loading, validation,<BR/>rendering, and file layout conventions to keep editor<BR/>behavior consistent with CLI tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-004" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Driver</B><BR/><B>DRI-004</B><BR/>&#160;<BR/>Visual Model Authoring — Enable rapid comprehension<BR/>and editing of an Aurora model through a visual,<BR/>multi-pane editor that reduces cognitive load and<BR/>navigation friction.</FONT></TD></TR></TABLE>>, shape="box"];
	"DRI-005" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Driver</B><BR/><B>DRI-005</B><BR/>&#160;<BR/>Reuse Shared Aurora Semantics — Minimize duplicated<BR/>logic and inconsistencies across tooling surfaces by<BR/>reusing the aurora_shared library for model discovery,<BR/>parsing, validation, and rendering.</FONT></TD></TR></TABLE>>, shape="box"];
	"MIS-004" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🎯</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Mission</B><BR/><B>MIS-004</B><BR/>&#160;<BR/>Standalone Editor — Provide a standalone application<BR/>capable of creating and manipulating Aurora models<BR/>visually, reusing the aurora_shared library to<BR/>facilitate development.</FONT></TD></TR></TABLE>>, shape="doubleoctagon"];
	"REQ-009" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-009</B><BR/>&#160;<BR/>Three Pane Layout — The editor SHALL present a<BR/>three-pane layout (similar to Visual Studio or<BR/>Obsidian): left navigation tree, central graph view, and<BR/>right inspector.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-010" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-010</B><BR/>&#160;<BR/>Shortest Path Tree Navigation — The editor SHALL<BR/>provide a left-pane tree view for navigation, where the<BR/>tree is derived from a chosen shortest path from the<BR/>mission root to each card.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-011" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-011</B><BR/>&#160;<BR/>Brain Style Graph Navigation — The editor SHALL<BR/>provide a central mind-map / TheBrain style view with<BR/>the focused card centered. The view SHALL show the<BR/>parent (from the chosen shortest-path chain), and MAY<BR/>show siblings (same card_type) linked from that parent<BR/>even if they are not linked to the focused card.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-012" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-012</B><BR/>&#160;<BR/>Edit, Preview, and Audit Inspector — The editor SHALL<BR/>provide a right-pane inspector: the top half edits the<BR/>focused card; the bottom half renders a Markdown-style<BR/>view of the card (including links). The bottom half<BR/>SHALL provide a tab to reveal the card’s audit trail<BR/>details.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-013" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-013</B><BR/>&#160;<BR/>Dioxus UI — The standalone editor SHOULD be<BR/>implemented using Dioxus as the primary UI library.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-014" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-014</B><BR/>&#160;<BR/>Reuse aurora_shared — The editor SHALL reuse<BR/>aurora_shared for model discovery/loading and<BR/>validation/rendering semantics to stay consistent with<BR/>other Aurora tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-015" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-015</B><BR/>&#160;<BR/>Safe Workspace Persistence — The editor SHALL persist<BR/>edits to model files in a safe manner that avoids<BR/>partial writes and preserves schema validity (e.g.,<BR/>atomic replace per card file).</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-009" -> "REQ-009" [label="satisfies"];
	"CAP-009" -> "REQ-013" [label="satisfies"];
	"CAP-010" -> "REQ-010" [label="satisfies"];
	"CAP-011" -> "REQ-011" [label="satisfies"];
	"CAP-012" -> "REQ-015" [label="satisfies"];
	"CAP-013" -> "REQ-012" [label="satisfies"];
	"CAP-014" -> "REQ-014" [label="satisfies"];
	"DRI-004" -> "REQ-009" [label="drives"];
	"DRI-004" -> "REQ-010" [label="drives"];
	"DRI-004" -> "REQ-011" [label="drives"];
	"DRI-004" -> "REQ-012" [label="drives"];
	"DRI-004" -> "REQ-015" [label="drives"];
	"DRI-005" -> "REQ-013" [label="drives"];
	"DRI-005" -> "REQ-014" [label="drives"];
	"MIS-004" -> "DRI-004" [label="establishes"];
	"MIS-004" -> "DRI-005" [label="establishes"];
}