digraph "System Structure" {
	graph [bgcolor="#FFFFFF", fontname="Inter", nodesep="0.2", rankdir="LR", ranksep="0.3", splines="curved"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"APP-004" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Application</B><BR/><B>APP-004</B><BR/>&#160;<BR/>aurora_editor — Standalone desktop application (built<BR/>with Dioxus) for browsing and editing Aurora models,<BR/>including live validation and Markdown-style previews.</FONT></TD></TR></TABLE>>, shape="component"];
	"ART-005" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Artifact</B><BR/><B>ART-005</B><BR/>&#160;<BR/>Aurora Model Source Files — Aurora model<BR/>source-of-truth files stored as JSJSON: a mission card<BR/>plus per-card files under &lt;MISSION_ID&gt;/&lt;Card Type&gt;/.</FONT></TD></TR></TABLE>>, shape="tab"];
	"CAP-009" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-009</B><BR/>&#160;<BR/>Desktop UI Shell — Ability to present a desktop<BR/>application UI with a stable three-pane layout and<BR/>shared selection state.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-010" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-010</B><BR/>&#160;<BR/>Navigation and Focus Management — Ability to navigate<BR/>the model by card id and keep the focused card<BR/>synchronized across panes.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-011" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-011</B><BR/>&#160;<BR/>Context Graph Visualization — Ability to visualize a<BR/>local subgraph around the focused card (including<BR/>parent, siblings, and children) and navigate by clicking<BR/>nodes.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-012" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-012</B><BR/>&#160;<BR/>Interactive Card Editing — Ability to edit card fields<BR/>and links interactively while maintaining model<BR/>invariants and persisting changes safely.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-013" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-013</B><BR/>&#160;<BR/>Markdown Preview and Audit View — Ability to render<BR/>the focused card as a readable Markdown-style document<BR/>with link list, and to inspect audit trail history.</FONT></TD></TR></TABLE>>, shape="box"];
	"CAP-014" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-014</B><BR/>&#160;<BR/>aurora_shared Integration — Ability to reuse<BR/>aurora_shared for model discovery/loading, validation,<BR/>rendering, and file layout conventions to keep editor<BR/>behavior consistent with CLI tooling.</FONT></TD></TR></TABLE>>, shape="box"];
	"COM-007" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-007</B><BR/>&#160;<BR/>Dioxus App Shell — Top-level Dioxus component that<BR/>owns the UI shell layout and routes focus/selection<BR/>changes between panes.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-008" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-008</B><BR/>&#160;<BR/>Explorer Tree Pane — Left navigation pane that<BR/>presents a tree view derived from shortest paths from<BR/>the mission root, enabling fast card discovery and focus<BR/>changes.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-009" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-009</B><BR/>&#160;<BR/>Brain Graph Pane — Central pane that renders a<BR/>mind-map / TheBrain-style context graph with the focused<BR/>card centered and related cards positioned by<BR/>relationship role.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-010" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-010</B><BR/>&#160;<BR/>Inspector Pane — Right pane that splits vertically:<BR/>top half edits the focused card; bottom half shows a<BR/>rendered Markdown-style preview (and links) with a tab<BR/>to reveal audit details.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"COM-011" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-011</B><BR/>&#160;<BR/>Model Session and Persistence — In-memory model<BR/>session that loads a workspace model home, computes<BR/>shortest paths, validates changes, and persists updated<BR/>card files using aurora_shared semantics.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"DTS-003" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Data Store</B><BR/><B>DTS-003</B><BR/>&#160;<BR/>Workspace File System — Filesystem-backed store<BR/>holding Aurora model source files (Mission card plus<BR/>per-card JSJSON files) within a user-selected workspace.</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"FEA-010" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-010</B><BR/>&#160;<BR/>Three Pane Shell — Render the editor UI as three<BR/>primary panes: left navigation tree, central context<BR/>graph, and right inspector split into edit +<BR/>preview/audit.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-011" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-011</B><BR/>&#160;<BR/>Compute Shortest Path Tree — Compute a stable<BR/>shortest-path parent for each card from the mission root<BR/>and present it as a tree for navigation (one chosen path<BR/>per node).</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-012" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-012</B><BR/>&#160;<BR/>Brain Style Graph View — Render a TheBrain-like local<BR/>context view: focused card centered; show parent from<BR/>the chosen shortest-path chain; show siblings (same<BR/>card_type) as adjacent nodes linked from the parent;<BR/>show focused card’s outgoing links as navigable<BR/>children.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-013" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-013</B><BR/>&#160;<BR/>Card Inspector Editing — Edit the focused card’s<BR/>core fields (name, description, type/subtype, status,<BR/>attributes, and links) with immediate validation<BR/>feedback.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-014" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-014</B><BR/>&#160;<BR/>Preview and Audit Panel — Render a Markdown-style card<BR/>preview (including outgoing link list) and provide a tab<BR/>to display audit trail details for the focused card.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-015" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-015</B><BR/>&#160;<BR/>Load, Validate, and Save Models — Load Aurora models<BR/>from a chosen workspace, validate invariants on every<BR/>change, and persist edits back to JSJSON card files<BR/>using shared aurora_shared semantics.</FONT></TD></TR></TABLE>>, shape="box"];
	"INT-003" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-003</B><BR/>&#160;<BR/>Dioxus UI Framework API — UI framework interface used<BR/>to declare layouts, render widgets, and process user<BR/>events for the standalone editor.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-004" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-004</B><BR/>&#160;<BR/>aurora_shared Domain API — Public domain interface<BR/>(Rust API) for discovering model homes, loading cards,<BR/>validating invariants, and rendering Markdown-style<BR/>representations.</FONT></TD></TR></TABLE>>, shape="note"];
	"INT-005" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-005</B><BR/>&#160;<BR/>Local Filesystem API — Contract for reading and<BR/>writing Aurora model files on the local filesystem<BR/>(open, read, write, atomic replace, and directory<BR/>enumeration).</FONT></TD></TR></TABLE>>, shape="note"];
	"SYS-003" [fillcolor="#172554", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧱</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>System</B><BR/><B>SYS-003</B><BR/>&#160;<BR/>Aurora Standalone Editor System — Bounded system that<BR/>provides a desktop UI for exploring and editing Aurora<BR/>models with a three-pane workflow (navigation, graph<BR/>context, inspector).</FONT></TD></TR></TABLE>>, shape="folder"];
	"APP-004" -> "COM-007" [label="composes"];
	"APP-004" -> "COM-008" [label="composes"];
