            "per_mission_views_root": "docs/design/{MissionId}/views/",
            "per_mission_index_readme": "docs/design/{MissionId}/README-{MissionId}.md",
            "per_mission_compact_model": "docs/design/aurora/AGENT-{MissionId}.json"
          }
        }
      },
      "card_type": "Mission",
      "description": "Provide a cross-platform UI tool for viewing and editing Aurora models that enforces the Aurora schema and invariants, supports deterministic and conflict-safe edits, and stays consistent with the canonical aurora_cli outputs.",
