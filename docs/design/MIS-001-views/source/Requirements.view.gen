    {
      "_gvid": 9,
      "name": "MIS_001",
      "bb": null,
      "label": "\n\t\t\t\t<FONT COLOR=\"#FFFFFF\"><B>Mission</B><BR/>\n\t\t\t\t<B>Agent-Unified Representation of Requirements and Architecture (Aurora)</B><BR/>\n\t\t\t\t<BR/>\n\t\t\t\tA rigorous, MBSE-class architectural modeling framework designed for equal reada<BR/>bility by human engineers, machine learning (&quot;AI&quot;) agents, and computer programs<BR/>. It provides a lightweight but complete representational schema that captures r<BR/>equirements, behavior, structure, interfaces, constraints, and traceability in a<BR/> single, coherent model. The objective is a common architectural language that s<BR/>upports automated reasoning, validation, and lifecycle tooling while remaining d<BR/>irectly interpretable by expert practitioners.\n\nBecause it is designed to be rea<BR/>dable by machine agents as well as humans, Aurora artifacts can be generated by <BR/>machine learning models, consumed by coding agents, and used to automatically ge<BR/>nerate views of the architecture.<BR/></FONT>\n\t\t\t",
      "pos": "7267.8,516.36",
      "nodes": null,
      "edges": null,
      "subgraphs": null,
      "height": "3.732",
