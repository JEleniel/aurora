    {
      "_gvid": 6,
      "name": "REQ_020",
      "bb": null,
      "label": "\n\t\t\t\t<FONT COLOR=\"#FFFFFF\"><B>Requirement</B><BR/>\n\t\t\t\t<B>Boundary and Note Semantics</B><BR/>\n\t\t\t\t<BR/>\n\t\t\t\tBoundary cards SHALL be used to group related cards for rendering and navigation<BR/>; they may have a subtype such as End to limit recursion. Note cards SHALL be us<BR/>ed only as annotative leaves (incoming links only) and SHALL NOT introduce new s<BR/>tructural model elements.<BR/></FONT>\n\t\t\t",
      "pos": "3979.8,84.853",
      "nodes": null,
      "edges": null,
      "subgraphs": null,
      "height": "2.082",
      "icon": "checklist",
