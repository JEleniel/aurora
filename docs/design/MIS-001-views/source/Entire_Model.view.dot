digraph {
					fontname="Noto Sans";
					fontcolor="#FFFFFF";
					fontsize=12;
				REQ_026[
			label=<
				<B>Requirement</B><BR/>
				<B>Views as Projections</B><BR/>
				<BR/>
				Views SHALL be treated as projections of a single underlying model graph by sele<BR/>cting a set of card types (and optional subtypes) and rendering only those cards<BR/> and the links between them; views SHALL NOT change the underlying model.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Views_as_Projections.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_027[
			label=<
				<B>Requirement</B><BR/>
				<B>Audit Trail and Versioning</B><BR/>
				<BR/>
				All Aurora cards SHALL include an audit_trail with a per-card SemVer version, an<BR/> optional SHA256 hash (nullable), and a chronological history of created/edited/<BR/>deleted events including editor identity and RFC3339 timestamps.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Audit_Trail_and_Versioning.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_022[
			label=<
				<B>Requirement</B><BR/>
				<B>Canonical Relationship Registry</B><BR/>
				<BR/>
				Aurora tooling and documentation SHALL use a canonical registry of relationship <BR/>verbs, including allowed source and target card types, to enable deterministic v<BR/>alidation and interoperable views.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Canonical_Relationship_Registry.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_028[
			label=<
				<B>Requirement</B><BR/>
				<B>Semantics Derived from Invariants</B><BR/>
				<BR/>
				Aurora card and relationship labels SHALL be treated as descriptive metadata; th<BR/>e meaning of the architecture SHALL be derived from the model’s invariant rules <BR/>and the current view’s inclusion/projection of card types and links.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Semantics_Derived_from_Invariants.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_023[
			label=<
				<B>Requirement</B><BR/>
				<B>Canonical View Registry</B><BR/>
				<BR/>
				Aurora tooling and documentation SHALL use a canonical registry of view definiti<BR/>ons that declare which card types are included and what root types anchor each v<BR/>iew.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Canonical_View_Registry.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_021[
			label=<
				<B>Requirement</B><BR/>
				<B>Canonical Card Registry</B><BR/>
				<BR/>
				Aurora tooling and documentation SHALL use a canonical registry of card types (a<BR/>nd optional subtypes) to support consistent rendering, validation, and communica<BR/>tion across tools.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Canonical_Card_Registry.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_024[
			label=<
				<B>Requirement</B><BR/>
				<B>Schema Referencing Rules</B><BR/>
				<BR/>
				All Aurora card files SHALL include a $schema field referencing the applicable A<BR/>urora schema using a relative path from the card file to the Model Home schema f<BR/>ile.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Schema_Referencing_Rules.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_016[
			label=<
				<B>Requirement</B><BR/>
				<B>Strict json Card Encoding</B><BR/>
				<BR/>
				Aurora card files SHALL be stored as strict JSON (RFC 8259) using the .json ex<BR/>tension: double quotes, no comments, no trailing commas, UTF-8 encoding, and exa<BR/>ctly one trailing newline.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Strict_json_Card_Encoding.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_025[
			label=<
				<B>Requirement</B><BR/>
				<B>Model Integrity Validation</B><BR/>
				<BR/>
				Aurora models SHALL be machine-validatable for integrity: every non-Mission, non<BR/>-Note card SHALL have at least one incoming link; every card SHALL be reachable <BR/>from the Mission; and all links[].target values SHALL reference an existing card<BR/> id.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Model_Integrity_Validation.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_019[
			label=<
				<B>Requirement</B><BR/>
				<B>Directed Graph with Local Cycles</B><BR/>
				<BR/>
				All Aurora links SHALL lead away from the Mission card. Local cycles MAY exist w<BR/>ithin bounded subgraphs (for example state machines) as long as no link creates <BR/>a path back to the Mission.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Directed_Graph_with_Local_Cycles.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_020[
			label=<
				<B>Requirement</B><BR/>
				<B>Boundary and Note Semantics</B><BR/>
				<BR/>
				Boundary cards SHALL be used to group related cards for rendering and navigation<BR/>; they may have a subtype such as End to limit recursion. Note cards SHALL be us<BR/>ed only as annotative leaves (incoming links only) and SHALL NOT introduce new s<BR/>tructural model elements.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Boundary_and_Note_Semantics.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		DRI_007[
			label=<
				<B>Driver</B><BR/>
				<B>Machine and Human Readable Source of Truth</B><BR/>
				<BR/>
				Ensure Aurora models remain directly interpretable by expert practitioners while<BR/> staying friendly to machine parsing, tooling, and agent consumption.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Machine_and_Human_Readable_Source_of_Truth.view.svg";
			style=filled;
			fillcolor="#064e3b";
			svg_shape="rounded-rectangle";
			icon="compass";
		];
		DRI_008[
			label=<
				<B>Driver</B><BR/>
				<B>Canonical Registries and View Definitions</B><BR/>
				<BR/>
				Provide a stable, shared vocabulary for cards, relationship verbs, and views so <BR/>validation and rendering can be deterministic and portable across tools.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Canonical_Registries_and_View_Definitions.view.svg";
			style=filled;
			fillcolor="#064e3b";
			svg_shape="rounded-rectangle";
			icon="compass";
		];
		SYS_004[
			label=<
				<B>System</B><BR/>
				<B>Aurora Framework</B><BR/>
				<BR/>
				A mission-scoped specification of Aurora as an architectural modeling framework,<BR/> including its card schema, canonical registries, invariants, and style rules fo<BR/>r deterministic storage and rendering.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Aurora_Framework.view.svg";
			style=filled;
			fillcolor="#172554";
			svg_shape="folder";
			icon="layers";
		];
		MIS_001[
			label=<
				<B>Mission</B><BR/>
				<B>Agent-Unified Representation of Requirements and Architecture (Aurora)</B><BR/>
				<BR/>
				A rigorous, MBSE-class architectural modeling framework designed for equal reada<BR/>bility by human engineers, machine learning (&quot;AI&quot;) agents, and computer programs<BR/>. It provides a lightweight but complete representational schema that captures r<BR/>equirements, behavior, structure, interfaces, constraints, and traceability in a<BR/> single, coherent model. The objective is a common architectural language that s<BR/>upports automated reasoning, validation, and lifecycle tooling while remaining d<BR/>irectly interpretable by expert practitioners.

Because it is designed to be rea<BR/>dable by machine agents as well as humans, Aurora artifacts can be generated by <BR/>machine learning models, consumed by coding agents, and used to automatically ge<BR/>nerate views of the architecture.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Agent-Unified_Representation_of_Requirements_and_Architecture_(Aurora).view.svg";
			style=filled;
			fillcolor="#022c22";
			svg_shape="octagon";
			icon="target";
		];
		REQ_018[
			label=<
				<B>Requirement</B><BR/>
				<B>Single Root Mission</B><BR/>
				<BR/>
				Each Aurora model SHALL start with exactly one Mission card that serves as the r<BR/>oot of the directed graph. The Mission card SHALL only have outgoing links and S<BR/>HALL provide a consistent starting point for traversal and view generation.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Single_Root_Mission.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		REQ_017[
			label=<
				<B>Requirement</B><BR/>
				<B>Identifiers, Filenames, and Model Layout</B><BR/>
				<BR/>
				Aurora cards SHALL use stable identifiers (e.g., MIS-001) that MUST NOT change o<BR/>nce issued. Card files SHALL be named &lt;id&gt;-&lt;Sanitized_Name&gt;.json, where specia<BR/>l characters are stripped and spaces are replaced with underscores. Models SHALL<BR/> follow the Model Home and Mission folder layout conventions so tools can discov<BR/>er, validate, and render deterministically.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Identifiers,_Filenames,_and_Model_Layout.view.svg";
			style=filled;
			fillcolor="#065f46";
			svg_shape="rounded-rectangle";
			icon="checklist";
		];
		DRI_006[
			label=<
				<B>Driver</B><BR/>
				<B>Deterministic Architectural Language</B><BR/>
				<BR/>
				Enable unambiguous interpretation and automated reasoning by enforcing determini<BR/>stic model structure and traversal rules rooted at the Mission card.<BR/>
			>
			height=1.0;
			width=1.6;
			href="../MIS-001-views/Deterministic_Architectural_Language.view.svg";
			style=filled;
			fillcolor="#064e3b";
			svg_shape="rounded-rectangle";
			icon="compass";
		];
			DRI_007 -> REQ_016 [label="drives"];
									DRI_007 -> REQ_017 [label="drives"];
									DRI_007 -> REQ_024 [label="drives"];
									DRI_008 -> REQ_020 [label="drives"];
									DRI_008 -> REQ_021 [label="drives"];
									DRI_008 -> REQ_022 [label="drives"];
									DRI_008 -> REQ_023 [label="drives"];
									DRI_008 -> REQ_026 [label="drives"];
									MIS_001 -> DRI_006 [label="establishes"];
									MIS_001 -> DRI_007 [label="establishes"];
									MIS_001 -> DRI_008 [label="establishes"];
									MIS_001 -> SYS_004 [label="requires"];
									DRI_006 -> REQ_018 [label="drives"];
									DRI_006 -> REQ_019 [label="drives"];
									DRI_006 -> REQ_028 [label="drives"];
									DRI_006 -> REQ_025 [label="drives"];
									DRI_006 -> REQ_027 [label="drives"];
								}