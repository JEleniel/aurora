digraph "Compliance Governance" {
	graph [bgcolor="#FFFFFF", fontname="Inter", nodesep="0.2", rankdir="LR", ranksep="0.3", splines="curved"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ADR-002" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📄</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>ADR</B><BR/><B>ADR-002</B><BR/>&#160;<BR/>Strict JSJSON Canonical Storage — Decision: Aurora<BR/>cards are stored as strict JSON using the .jsjson<BR/>extension. Rationale: deterministic diffs, wide tool<BR/>compatibility, and unambiguous machine parsing.<BR/>Trade-off: no comments; humans must rely on explicit<BR/>fields and Notes instead.</FONT></TD></TR></TABLE>>, shape="note"];
	"REQ-016" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-016</B><BR/>&#160;<BR/>Strict JSJSON Card Encoding — Aurora card files SHALL<BR/>be stored as strict JSON (RFC 8259) using the .jsjson<BR/>extension: double quotes, no comments, no trailing<BR/>commas, UTF-8 encoding, and exactly one trailing<BR/>newline.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-017" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-017</B><BR/>&#160;<BR/>Identifiers, Filenames, and Model Layout — Aurora<BR/>cards SHALL use stable identifiers (e.g., MIS-001) that<BR/>MUST NOT change once issued. Card files SHALL be named<BR/>&lt;id&gt;-&lt;Sanitized_Name&gt;.jsjson, where special characters<BR/>are stripped and spaces are replaced with underscores.<BR/>Models SHALL follow the Model Home and Mission folder<BR/>layout conventions so tools can discover, validate, and<BR/>render deterministically.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-018" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-018</B><BR/>&#160;<BR/>Single Root Mission — Each Aurora model SHALL start<BR/>with exactly one Mission card that serves as the root of<BR/>the directed graph. The Mission card SHALL only have<BR/>outgoing links and SHALL provide a consistent starting<BR/>point for traversal and view generation.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-019" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-019</B><BR/>&#160;<BR/>Directed Graph with Local Cycles — All Aurora links<BR/>SHALL lead away from the Mission card. Local cycles MAY<BR/>exist within bounded subgraphs (for example state<BR/>machines) as long as no link creates a path back to the<BR/>Mission.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-020" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-020</B><BR/>&#160;<BR/>Boundary and Note Semantics — Boundary cards SHALL be<BR/>used to group related cards for rendering and<BR/>navigation; they may have a subtype such as End to limit<BR/>recursion. Note cards SHALL be used only as annotative<BR/>leaves (incoming links only) and SHALL NOT introduce new<BR/>structural model elements.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-021" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-021</B><BR/>&#160;<BR/>Canonical Card Registry — Aurora tooling and<BR/>documentation SHALL use a canonical registry of card<BR/>types (and optional subtypes) to support consistent<BR/>rendering, validation, and communication across tools.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-022" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-022</B><BR/>&#160;<BR/>Canonical Relationship Registry — Aurora tooling and<BR/>documentation SHALL use a canonical registry of<BR/>relationship verbs, including allowed source and target<BR/>card types, to enable deterministic validation and<BR/>interoperable views.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-023" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-023</B><BR/>&#160;<BR/>Canonical View Registry — Aurora tooling and<BR/>documentation SHALL use a canonical registry of view<BR/>definitions that declare which card types are included<BR/>and what root types anchor each view.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-024" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-024</B><BR/>&#160;<BR/>Schema Referencing Rules — All Aurora card files SHALL<BR/>include a $schema field referencing the applicable<BR/>Aurora schema using a relative path from the card file<BR/>to the Model Home schema file.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-025" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-025</B><BR/>&#160;<BR/>Model Integrity Validation — Aurora models SHALL be<BR/>machine-validatable for integrity: every non-Mission,<BR/>non-Note card SHALL have at least one incoming link;<BR/>every card SHALL be reachable from the Mission; and all<BR/>links[].target values SHALL reference an existing card<BR/>id.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-026" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-026</B><BR/>&#160;<BR/>Views as Projections — Views SHALL be treated as<BR/>projections of a single underlying model graph by<BR/>selecting a set of card types (and optional subtypes)<BR/>and rendering only those cards and the links between<BR/>them; views SHALL NOT change the underlying model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-027" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-027</B><BR/>&#160;<BR/>Audit Trail and Versioning — All Aurora cards SHALL<BR/>include an audit_trail with a per-card SemVer version,<BR/>an optional SHA256 hash (nullable), and a chronological<BR/>history of created/edited/deleted events including<BR/>editor identity and RFC3339 timestamps.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-028" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-028</B><BR/>&#160;<BR/>Semantics Derived from Invariants — Aurora card and<BR/>relationship labels SHALL be treated as descriptive<BR/>metadata; the meaning of the architecture SHALL be<BR/>derived from the model’s invariant rules and the<BR/>current view’s inclusion/projection of card types and<BR/>links.</FONT></TD></TR></TABLE>>, shape="box"];
	"ADR-002" -> "REQ-016" [label="documents"];
	"ADR-002" -> "REQ-017" [label="documents"];
	"ADR-002" -> "REQ-027" [label="documents"];
	subgraph "cluster_BND-004" {
		graph [color="#000000", label="Aurora Style Specification (BND-004)", penwidth="4", style="dashed"];
		"ADR-002";
		"REQ-016";
		"REQ-017";
		"REQ-018";
		"REQ-019";
		"REQ-020";
		"REQ-021";
		"REQ-022";
		"REQ-023";
		"REQ-024";
		"REQ-025";
		"REQ-026";
		"REQ-027";
		"REQ-028";
	}
}