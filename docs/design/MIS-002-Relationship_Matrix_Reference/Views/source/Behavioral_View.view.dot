digraph "Behavioral" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"EVT-001" [fillcolor="#5b21b6", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⚡</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Event</B><BR/><B>EVT-001</B><BR/>&#160;<BR/>Reference Event — Event that transitions to a state in<BR/>the relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"PRD-001" [fillcolor="#581c87", fontcolor="#FFFFFF", label=<<FONT><B>Predicate</B><BR/><B>PRD-001</B><BR/>&#160;<BR/>Reference Predicate — Predicate used to exercise state<BR/>machine transitions in the relationship-matrix reference<BR/>model.</FONT>>, shape="diamond"];
	"STA-001" [fillcolor="#701a75", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">●</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>State</B><BR/><B>STA-001</B><BR/>&#160;<BR/>Reference State — State that transitions to another<BR/>state in the relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="circle"];
	"STA-002" [fillcolor="#701a75", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">●</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>State</B><BR/><B>STA-002</B><BR/>&#160;<BR/>Secondary State — Secondary state used as a target of<BR/>State/Condition transitions in the reference model.</FONT></TD></TR></TABLE>>, shape="circle"];
	"STM-001" [fillcolor="#4a044e", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🕒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>State Machine</B><BR/><B>STM-001</B><BR/>&#160;<BR/>Reference State Machine — State machine that starts in<BR/>a defined initial state.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"EVT-001" -> "STA-002" [label="transitions to"];
	"PRD-001" -> "STA-002" [label="transitions to"];
	"STA-001" -> "STA-002" [label="transitions to"];
	"STM-001" -> "STA-001" [label="starts in"];
	subgraph "cluster_BND-001" {
		graph [color="#000000", label="Reference Boundary (BND-001)", penwidth="4", style="dashed"];
		"PRD-001";
	}
}