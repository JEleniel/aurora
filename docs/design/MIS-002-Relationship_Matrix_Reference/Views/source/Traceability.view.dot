digraph "Traceability" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ADR-001" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📄</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>ADR</B><BR/><B>ADR-001</B><BR/>&#160;<BR/>Reference ADR — Architectural Decision Record made by<BR/>an actor and documenting a requirement.</FONT></TD></TR></TABLE>>, shape="note"];
	"APP-001" [fillcolor="#1e3a8a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🪟</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Application</B><BR/><B>APP-001</B><BR/>&#160;<BR/>Reference Application — Application that comprises a<BR/>component and implements test/feature/class/control.</FONT></TD></TR></TABLE>>, shape="component"];
	"ART-001" [fillcolor="#1e293b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Artifact</B><BR/><B>ART-001</B><BR/>&#160;<BR/>Reference Artifact — Artifact generated by a<BR/>component, classified as an asset, and persisted to a<BR/>data store.</FONT></TD></TR></TABLE>>, shape="tab"];
	"AST-001" [fillcolor="#334155", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🛡️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Asset</B><BR/><B>AST-001</B><BR/>&#160;<BR/>Reference Asset — Asset owned by an actor, protected<BR/>by a control, and derived from an artifact in the<BR/>reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"ATV-001" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><BR/><B>ATV-001</B><BR/>&#160;<BR/>Reference Activity — Activity that receives an event<BR/>and triggers downstream activities, events, conditions,<BR/>actors, and states.</FONT>>, shape="box"];
	"ATV-002" [fillcolor="#4c1d95", fontcolor="#FFFFFF", label=<<FONT><B>Activity</B><BR/><B>ATV-002</B><BR/>&#160;<BR/>Triggered Activity — Secondary activity used as the<BR/>target of Activity/Event triggers in the reference<BR/>model.</FONT>>, shape="box"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-001</B><BR/>&#160;<BR/>Reference Capability — Capability used to satisfy a<BR/>requirement and to run both a process and a state<BR/>machine.</FONT></TD></TR></TABLE>>, shape="box"];
	"CLS-001" [fillcolor="#0f172a", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧩</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Class</B><BR/><B>CLS-001</B><BR/>&#160;<BR/>Reference Class — Class target for implement<BR/>relationships in the reference model.</FONT></TD></TR></TABLE>>, shape="record"];
	"CNS-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Constraint</B><BR/><B>CNS-001</B><BR/>&#160;<BR/>Reference Constraint — Constraint implied by a story<BR/>and limiting a requirement in the reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"COM-001" [fillcolor="#1e40af", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧊</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Component</B><BR/><B>COM-001</B><BR/>&#160;<BR/>Reference Component — Component used to exercise<BR/>interface calls, artifact generation, implementation<BR/>links, and execution links.</FONT></TD></TR></TABLE>>, shape="box3d"];
	"CTL-001" [fillcolor="#713f12", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔒</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Control</B><BR/><B>CTL-001</B><BR/>&#160;<BR/>Reference Control — Control that mitigates risk and<BR/>protects an asset in the reference model.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"DRI-001" [fillcolor="#064e3b", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧭</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Driver</B><BR/><B>DRI-001</B><BR/>&#160;<BR/>Reference Driver — Motivation used to drive a<BR/>downstream requirement in the relationship-matrix<BR/>reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"DTS-001" [fillcolor="#075985", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🗄️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Data Store</B><BR/><B>DTS-001</B><BR/>&#160;<BR/>Reference Data Store — Data store that exposes an<BR/>interface and receives persisted artifacts.</FONT></TD></TR></TABLE>>, shape="cylinder"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-001</B><BR/>&#160;<BR/>Reference Feature — Feature that enables a capability<BR/>in the relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"INT-001" [fillcolor="#102080", fontcolor="#000000", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔌</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Interface</B><BR/><B>INT-001</B><BR/>&#160;<BR/>Reference Interface — Interface that can be called by<BR/>a component and exposed by a data store.</FONT></TD></TR></TABLE>>, shape="note"];
	"MIS-002" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🎯</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Mission</B><BR/><B>MIS-002</B><BR/>&#160;<BR/>Relationship Matrix Reference — Reference Aurora model<BR/>encoding the requested relationship matrix as concrete<BR/>card links for tooling and diagram validation.</FONT></TD></TR></TABLE>>, shape="doubleoctagon"];
	"NOT-900" [fillcolor="#1f2937", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🗒️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Note</B><BR/><B>NOT-900</B><BR/>&#160;<BR/>Legacy Duplicate File Placeholder — Placeholder for a<BR/>duplicate mission file path that cannot be deleted in<BR/>this environment. Tooling should treat this as a Note;<BR/>the real mission card lives at<BR/>`docs/design/aurora/MIS-002-Relationship_Matrix_Reference.jsjson`.</FONT></TD></TR></TABLE>>, shape="note"];
	"PRO-001" [fillcolor="#2e1065", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🔁</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Process</B><BR/><B>PRO-001</B><BR/>&#160;<BR/>Reference Process — Process started with an activity<BR/>and run by both a capability and a component.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-001</B><BR/>&#160;<BR/>Reference Requirement — Requirement referenced by<BR/>multiple rules (driven by driver, satisfied by<BR/>capability, documented by ADR, limited by constraint).</FONT></TD></TR></TABLE>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Risk</B><BR/><B>RIS-001</B><BR/>&#160;<BR/>Reference Risk — Risk presented by actors/threats and<BR/>mitigated by controls in the reference model.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"TES-001" [fillcolor="#022c22", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🧪</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Test</B><BR/><B>TES-001</B><BR/>&#160;<BR/>Reference Test — Test target for implement<BR/>relationships in the reference model.</FONT></TD></TR></TABLE>>, shape="hexagon"];
	"THR-001" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Threat</B><BR/><B>THR-001</B><BR/>&#160;<BR/>Reference Threat — Threat presented by an actor that<BR/>can present other threats and risks.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"THR-002" [fillcolor="#4c0519", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">🐛</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Threat</B><BR/><B>THR-002</B><BR/>&#160;<BR/>Secondary Threat — Secondary threat used as the target<BR/>of Threat presents Threat in the reference model.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"ADR-001" -> "REQ-001" [label="documents"];
	"APP-001" -> "CLS-001" [label="implements"];
	"APP-001" -> "COM-001" [label="comprises"];
	"APP-001" -> "CTL-001" [label="implements"];
	"APP-001" -> "FEA-001" [label="implements"];
	"APP-001" -> "TES-001" [label="implements"];
	"ART-001" -> "AST-001" [label="is"];
	"ART-001" -> "DTS-001" [label="persists to"];
	"ATV-001" -> "ATV-002" [label="triggers"];
	"CAP-001" -> "PRO-001" [label="runs"];
	"CAP-001" -> "REQ-001" [label="satisfies"];
	"CNS-001" -> "REQ-001" [label="limits"];
	"COM-001" -> "ART-001" [label="generates"];
	"COM-001" -> "CLS-001" [label="implements"];
	"COM-001" -> "CTL-001" [label="implements"];
	"COM-001" -> "FEA-001" [label="implements"];
	"COM-001" -> "INT-001" [label="calls"];
	"COM-001" -> "PRO-001" [label="runs"];
	"COM-001" -> "TES-001" [label="implements"];
	"CTL-001" -> "AST-001" [label="protects"];
	"CTL-001" -> "RIS-001" [label="mitigates"];
	"DRI-001" -> "REQ-001" [label="drives"];
	"DTS-001" -> "INT-001" [label="exposes"];
	"FEA-001" -> "CAP-001" [label="enables"];
	"MIS-002" -> "APP-001" [label="necessitates"];
	"MIS-002" -> "DRI-001" [label="establishes"];
	"MIS-002" -> "NOT-900" [label="notes", style="dotted"];
	"PRO-001" -> "ATV-001" [label="starts with"];
	"THR-001" -> "RIS-001" [label="presents"];
	"THR-001" -> "THR-002" [label="presents"];
}