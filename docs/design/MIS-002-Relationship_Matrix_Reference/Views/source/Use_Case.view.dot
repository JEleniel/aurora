digraph "Use Case" {
	graph [bgcolor="#FFFFFF", concentrate="true", fontname="Inter", nodesep="0.3", rankdir="LR", ranksep="0.5", splines="spline"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-001</B><BR/>&#160;<BR/>Reference Actor — Actor exercising<BR/>desire/make/own/perform/present/implement relationships<BR/>in the reference model.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-002</B><BR/>&#160;<BR/>Triggered Actor — Secondary actor used as the target<BR/>of Activity/Event trigger relationships in the reference<BR/>model.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"CAP-001" [fillcolor="#052e16", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">✨</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Capability</B><BR/><B>CAP-001</B><BR/>&#160;<BR/>Reference Capability — Capability used to satisfy a<BR/>requirement and to run both a process and a state<BR/>machine.</FONT></TD></TR></TABLE>>, shape="box"];
	"CNS-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Constraint</B><BR/><B>CNS-001</B><BR/>&#160;<BR/>Reference Constraint — Constraint implied by a story<BR/>and limiting a requirement in the reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"FEA-001" [fillcolor="#14532d", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⭐</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Feature</B><BR/><B>FEA-001</B><BR/>&#160;<BR/>Reference Feature — Feature that enables a capability<BR/>in the relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"REQ-001" [fillcolor="#065f46", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">☑️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Requirement</B><BR/><B>REQ-001</B><BR/>&#160;<BR/>Reference Requirement — Requirement referenced by<BR/>multiple rules (driven by driver, satisfied by<BR/>capability, documented by ADR, limited by constraint).</FONT></TD></TR></TABLE>>, shape="box"];
	"RIS-001" [fillcolor="#881337", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">⚠️</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Risk</B><BR/><B>RIS-001</B><BR/>&#160;<BR/>Reference Risk — Risk presented by actors/threats and<BR/>mitigated by controls in the reference model.</FONT></TD></TR></TABLE>>, shape="octagon"];
	"STR-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Story</B><BR/><B>STR-001</B><BR/>&#160;<BR/>Reference Story — Story desired by an actor and<BR/>implying a constraint in the reference model.</FONT></TD></TR></TABLE>>, shape="cds"];
	"ACT-001" -> "FEA-001" [label="implements"];
	"ACT-001" -> "RIS-001" [label="presents"];
	"ACT-001" -> "STR-001" [label="desires"];
	"CAP-001" -> "REQ-001" [label="satisfies"];
	"CNS-001" -> "REQ-001" [label="limits"];
	"FEA-001" -> "CAP-001" [label="enables"];
	"STR-001" -> "CNS-001" [label="implies"];
}