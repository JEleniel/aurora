digraph "Use Case" {
	graph [bgcolor="#FFFFFF", fontname="Inter", nodesep="0.2", rankdir="LR", ranksep="0.3", splines="curved"];
	node [color="#000000", fillcolor="#FFFFFF", fontcolor="#000000", fontname="Inter", fontsize="11", shape="box", style="filled"];
	edge [color="#000000", fontcolor="#000000", fontname="Inter", fontsize="9"];
	"ACT-001" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-001</B><BR/>&#160;<BR/>Reference Actor — Actor exercising<BR/>desire/own/perform/present relationships in the<BR/>reference model.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"ACT-002" [fillcolor="#1a2e05", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">👤</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Actor</B><BR/><B>ACT-002</B><BR/>&#160;<BR/>Triggered Actor — Secondary actor involved in the<BR/>relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="ellipse"];
	"CNS-001" [fillcolor="#082f49", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📏</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Constraint</B><BR/><B>CNS-001</B><BR/>&#160;<BR/>Reference Constraint — Constraint implied by a story<BR/>in the relationship-matrix reference model.</FONT></TD></TR></TABLE>>, shape="box"];
	"STR-001" [fillcolor="#365314", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0"><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="32">📖</FONT></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT><B>Story</B><BR/><B>STR-001</B><BR/>&#160;<BR/>Reference Story — Story desired by an actor and<BR/>implying a constraint in the reference model.</FONT></TD></TR></TABLE>>, shape="cds"];
	"ACT-001" -> "STR-001" [label="desires"];
	"STR-001" -> "CNS-001" [label="implies"];
}